def setup_directories():
    """Create necessary directories"""
    dirs = ['data/raw', 'data/processed', 'data/merged', 'reports', 'data/cut']
    for dir_name in dirs:
        os.makedirs(dir_name, exist_ok=True)
    print("✓ Directory setup complete!")


def show_menu(title, options):
    """Display a simple menu"""
    print(f"\n{'=' * 50}\n{title}\n{'=' * 50}")
    for key, description in options.items():
        print(f"{key}. {description}")
    print(f"{'=' * 50}")
    return input("\nEnter your choice: ").strip()


def _parse_column_selection(df, choice_str):
    """
    Unified parser for column selection used across multiple handlers.
    Accepts: comma-separated numbers (1,3,5-8), column names, or keywords
    ('all', 'text', 'numeric', 'date').
    Returns (list_of_columns, parse_ok_bool).
    """
    choice = choice_str.strip().lower()
    if not choice or choice == 'b':
        return [], False

    if choice == 'all':
        return list(df.columns), True

    if choice == 'text':
        return [c for c in df.columns if df[c].dtype == 'object' and
                not pd.api.types.is_datetime64_any_dtype(df[c])], True

    if choice == 'numeric':
        return [c for c in df.columns if pd.api.types.is_numeric_dtype(df[c])], True

    if choice == 'date':
        date_cols = []
        for col in df.columns:
            if df[col].dtype == 'object':
                try:
                    if pd.to_datetime(df[col], errors='coerce').notna().any():
                        date_cols.append(col)
                except Exception:
                    pass
        return date_cols, True

    # Parse comma-separated numbers / ranges / names
    selected = []
    columns_list = list(df.columns)
    for part in choice.split(','):
        part = part.strip()
        if '-' in part and part.replace('-', '').isdigit():
            try:
                start, end = map(int, part.split('-'))
                selected.extend(columns_list[start - 1: end])
            except Exception:
                pass
        elif part.isdigit():
            idx = int(part) - 1
            if 0 <= idx < len(columns_list):
                selected.append(columns_list[idx])
        elif part in columns_list:
            selected.append(part)

    # De-duplicate preserving order
    return list(dict.fromkeys(selected)), bool(selected)


