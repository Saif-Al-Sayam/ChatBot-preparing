# 2. DATA LOADER (BytesIO-only, no temp files)
# ============================================================

class DataLoader:
    """Data loading utility with URL and local file support (optimized)"""

    @staticmethod
    def is_url(path):
        return str(path).startswith(('http://', 'https://', 'ftp://', 'www.'))

    @staticmethod
    def download_from_url(url):
        try:
            print(f"⬇ Downloading from URL: {url}")
            resp = requests.get(url,
                                headers={'User-Agent': 'Mozilla/5.0'},
                                timeout=30)
            resp.raise_for_status()
            filename = url.split('/')[-1] or 'downloaded_data.csv'
            print(f"✓ Downloaded ({len(resp.content) / 1024:.1f} KB)")
            return resp.content, filename
        except Exception as e:
            print(f"❌ Download failed: {e}")
            return None, None

    @staticmethod
    def _load_csv(content):
        """Try multiple encodings to load CSV from bytes (no temp file)."""
        for enc in ('utf-8', 'latin-1', 'iso-8859-1', 'cp1252'):
            try:
                return pd.read_csv(BytesIO(content), encoding=enc,
                                   on_bad_lines='skip', engine='python')
            except (UnicodeDecodeError, pd.errors.ParserError):
                continue
        # Last-resort: latin-1 with python engine (handles almost anything)
        return pd.read_csv(BytesIO(content), encoding='latin-1',
                           on_bad_lines='skip', engine='python')

    @staticmethod
    def load_from_source(source_path):
        """Load dataset from file path or URL (fully in-memory)."""
        try:
            display = source_path[:60] + "…" if len(str(source_path)) > 60 else source_path
            print(f"📥 Loading: {display}")

            # Read content into memory
            if DataLoader.is_url(source_path):
                content, filename = DataLoader.download_from_url(source_path)
                if content is None:
                    return None
            else:
                if not os.path.exists(source_path):
                    print(f"❌ File not found: {source_path}")
                    return None
                filename = os.path.basename(source_path)
                with open(source_path, 'rb') as f:
                    content = f.read()

            ext = filename.lower()
            # --- CSV ---
            if ext.endswith('.csv'):
                df = DataLoader._load_csv(content)
                print(f"✓ Loaded CSV  |  Rows: {len(df):,}  |  Columns: {len(df.columns)}")
                DataLoader._show_columns(df)
                return df

            # --- Excel (pandas needs a file-like; BytesIO works for .xlsx) ---
            if ext.endswith(('.xlsx', '.xls')):
                df = pd.read_excel(BytesIO(content))
                print(f"✓ Loaded Excel  |  Rows: {len(df):,}  |  Columns: {len(df.columns)}")
                DataLoader._show_columns(df)
                return df

            # --- JSON ---
            if ext.endswith('.json'):
                try:
                    df = pd.read_json(BytesIO(content))
                except Exception:
                    df = pd.read_json(StringIO(content.decode('utf-8', errors='ignore')))
                print(f"✓ Loaded JSON  |  Rows: {len(df):,}  |  Columns: {len(df.columns)}")
                DataLoader._show_columns(df)
                return df

            # Default: try CSV
            print("⚠ Unknown extension — trying CSV parser …")
            df = DataLoader._load_csv(content)
            print(f"✓ Loaded (CSV guess)  |  Rows: {len(df):,}")
            return df

        except Exception as e:
            print(f"❌ Error loading data: {e}")
            return None

    @staticmethod
    def _show_columns(df):
        cols = df.columns
        print(f"   Columns ({len(cols)}):")
        for i, col in enumerate(cols[:5], 1):
            print(f"     {i}. {col}")
        if len(cols) > 5:
            print(f"     … and {len(cols) - 5} more")

    @staticmethod
    def list_data_sources():
        raw_dir = 'data/raw'
        os.makedirs(raw_dir, exist_ok=True)
        files = [f for f in os.listdir(raw_dir) if f.endswith(('.csv', '.xlsx', '.json'))]

        print("\n📂 Available data sources:")
        print("-" * 40)
        if files:
            print(f"  Local files in 'data/raw/' ({len(files)} found):")
            for i, f in enumerate(files, 1):
                size = os.path.getsize(os.path.join(raw_dir, f)) / 1024
                print(f"  {i}. {f} ({size:.1f} KB)")
        else:
            print("  No local files found in 'data/raw/'")
            print("   Upload files or use URLs")

        print("\n  Example URLs:")
        print("  1. https://raw.githubusercontent.com/…/file.csv")
        print("  2. Any public CSV / Excel / JSON URL")
        return files

    # ---- interactive helpers (unchanged logic, lighter weight) ----

    @staticmethod
    def get_data_source():
        """Interactive: get data source from user (file or URL)."""
        print("\nHow would you like to load data?")
        print("  1. From local file (in data/raw/)")
        print("  2. From URL/Link")
        print("  3. Enter data manually (small datasets)")
        choice = input("\nYour choice (1-3): ").strip()

        if choice == '1':
            files = DataLoader.list_data_sources()
            if not files:
                print("❌ No files found. Upload to 'data/raw/' first.")
                return None, None
            print("\nSelect file number or enter custom path:")
            for i, f in enumerate(files, 1):
                print(f"  {i}. {f}")
            print(f"  {len(files) + 1}. Custom file path")
            fc = input("\nYour choice: ").strip()
            try:
                if fc.isdigit():
                    idx = int(fc)
                    if 1 <= idx <= len(files):
                        fp = os.path.join('data/raw', files[idx - 1])
                    elif idx == len(files) + 1:
                        fp = input("Enter full file path: ").strip()
                    else:
                        return None, None
                else:
                    fp = fc
                default = os.path.basename(fp).split('.')[0]
                name = input(f"Dataset name (default: {default}): ").strip() or default
                return fp, name
            except Exception as e:
                print(f"❌ Error: {e}")
                return None, None

        if choice == '2':
            url = input("\nURL: ").strip()
            if not url:
                print("❌ URL cannot be empty")
                return None, None
            default = url.split('/')[-1].split('.')[0] if '.' in url.split('/')[-1] else 'url_data'
            name = input(f"Dataset name (default: {default}): ").strip() or default
            return url, name

        if choice == '3':
            lines = []
            n = 1
            print("Enter CSV lines ('done' to finish):")
            while True:
                line = input(f"Line {n}: ").strip()
                if line.lower() == 'done':
                    break
                lines.append(line)
                n += 1
            if not lines:
                print("❌ No data entered")
                return None, None
            tmp = 'temp_manual_data.csv'
            with open(tmp, 'w', encoding='utf-8') as f:
                f.write('\n'.join(lines))
            name = input("Dataset name: ").strip() or 'manual_data'
            return tmp, name

        print("❌ Invalid choice")
        return None, None

    @staticmethod
    def load_multiple_sources():
        datasets = []
        print("\n" + "=" * 50)
        print("LOAD MULTIPLE DATASETS")
        print("=" * 50)
        while True:
            print(f"\n  Currently loaded: {len(datasets)} dataset(s)")
            print("  1. Add another dataset")
            print("  2. Finish loading")
            print("  3. Show loaded datasets")
            print("  4. Remove a dataset")
            ch = input("\nYour choice (1-4): ").strip()

            if ch == '1':
                src, name = DataLoader.get_data_source()
                if src and name:
                    df = DataLoader.load_from_source(src)
                    if df is not None:
                        datasets.append({'name': name, 'data': df,
                                         'source': src, 'rows': len(df),
                                         'columns': len(df.columns)})
                        print(f"\n✓ Added '{name}' ({len(df):,} rows)")
                        if input("Show preview? (y/n): ").strip().lower() == 'y':
                            print(df.head(3).to_string())
                    else:
                        print("❌ Failed to load")
            elif ch == '2':
                break
            elif ch == '3':
                if datasets:
                    for i, ds in enumerate(datasets, 1):
                        print(f"\n  {i}. {ds['name']}  ({ds['rows']:,} rows)")
                        print(f"     Columns: {list(ds['data'].columns)[:5]}")
                else:
                    print("  No datasets loaded")
            elif ch == '4':
                if datasets:
                    for i, ds in enumerate(datasets, 1):
                        print(f"  {i}. {ds['name']}")
                    try:
                        idx = int(input("Number to remove: ").strip())
                        if 1 <= idx <= len(datasets):
                            print(f"  Removed: {datasets.pop(idx - 1)['name']}")
                    except Exception:
                        print("❌ Invalid input")
        return datasets


