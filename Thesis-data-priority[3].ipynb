# 3. DATASET CUTTER (minor cleanups)
# ============================================================

class DataCutter:

    def __init__(self):
        self.cut_history = []

    # ---- core cut logic (unchanged, already efficient) ----

    def cut_dataset(self, df, method='percentage', value=50, strategy='sequential',
                    balance_column=None, output_prefix='cut'):
        print(f"\n✂  Cutting ({method}, {strategy}) …")
        print(f"   Original: {len(df):,} rows × {len(df.columns)} cols")
        results = []

        if method == 'percentage':
            n_rows = int(len(df) * value / 100)
            if n_rows <= 0 or n_rows > len(df):
                print("❌ Invalid percentage"); return None
            results = self._split_rows(df, n_rows, strategy, balance_column)

        elif method == 'rows':
            if value <= 0 or value > len(df):
                print(f"❌ Rows must be 1–{len(df)}"); return None
            results = self._split_rows(df, value, strategy, balance_column)

        elif method == 'parts':
            if value < 2 or value > len(df):
                print("❌ Invalid number of parts"); return None
            results = self._split_parts(df, value, strategy)

        elif method == 'date_range':
            if not balance_column or balance_column not in df.columns:
                print("❌ Specify a valid date column"); return None
            results = self._split_date(df, balance_column, value)

        elif method == 'category':
            if not balance_column or balance_column not in df.columns:
                print("❌ Specify a valid category column"); return None
            results = self._split_category(df, balance_column)

        else:
            print(f"❌ Unknown method: {method}"); return None

        self.cut_history.append({
            'timestamp': datetime.now(), 'method': method, 'value': value,
            'strategy': strategy, 'balance_column': balance_column,
            'original_rows': len(df), 'output_pieces': len(results),
            'pieces': [(n, len(d)) for n, d in results]
        })

        print(f"✂  Created {len(results)} piece(s):")
        for name, piece in results:
            print(f"   - {name}: {len(piece):,} rows ({len(piece) / len(df) * 100:.1f}%)")
        return results

    # ---- internal split helpers ----

    def _split_rows(self, df, n_rows, strategy, balance_col):
        if strategy == 'random':
            cut = df.sample(n=n_rows, random_state=42)
            rem = df.index.difference(cut.index)
            return [('random_sample', cut), ('remainder', df.loc[rem])]
        if strategy == 'balanced' and balance_col:
            cut = self._balanced_sample(df, balance_col, n_rows)
            rem = df.index.difference(cut.index)
            return [('balanced_sample', cut), ('remainder', df.loc[rem])]
        # sequential
        return [('first', df.iloc[:n_rows].copy()), ('remainder', df.iloc[n_rows:].copy())]

    def _split_parts(self, df, n_parts, strategy):
        src = df if strategy == 'sequential' else df.sample(frac=1, random_state=42)
        part_size = len(df) // n_parts
        results = []
        for i in range(n_parts):
            s = i * part_size
            e = s + part_size if i < n_parts - 1 else len(df)
            results.append((f'part_{i + 1}', src.iloc[s:e].copy()))
        return results

    def _split_date(self, df, col, pct):
        dates = pd.to_datetime(df[col], errors='coerce')
        if hasattr(dates.dt, 'tz') and dates.dt.tz is not None:
            dates = dates.dt.tz_localize(None)
        mn, mx = dates.min(), dates.max()
        print(f"   Date range: {mn} → {mx}")
        cut_pt = mn + (mx - mn) * (pct / 100)
        mask = dates <= cut_pt
        return [('before_cut_date', df[mask]), ('after_cut_date', df[~mask])]

    def _split_category(self, df, col):
        vals = df[col].unique()
        print(f"   Categories in '{col}': {vals[:10]}")
        if len(vals) > 10:
            print(f"   … and {len(vals) - 10} more")
        cat_val = input("\nEnter category value to extract: ").strip()
        if df[col].dtype in ('int64', 'float64'):
            try:
                cat_val = float(cat_val) if '.' in cat_val else int(cat_val)
            except Exception:
                pass
        mask = df[col] == cat_val
        return [(f'category_{cat_val}', df[mask]), ('remainder', df[~mask])]

    def _balanced_sample(self, df, balance_col, n_rows):
        """Vectorized balanced sampling via groupby."""
        n_cat = df[balance_col].nunique()
        per_cat = n_rows // n_cat
        remainder = n_rows % n_cat

        def _sample_group(group, n):
            return group.sample(n=min(n, len(group)),
                                replace=len(group) < n, random_state=42)

        samples = []
        for i, (_, grp) in enumerate(df.groupby(balance_col, sort=False)):
            n = per_cat + (1 if i < remainder else 0)
            samples.append(_sample_group(grp, n))

        return pd.concat(samples)

    # ---- save / history (unchanged) ----

    def _save_cut_results(self, results, dataset_name):
        ts = datetime.now().strftime('%Y%m%d_%H%M%S')
        print("\n💾 Saving cut pieces:")
        for name, piece in results:
            fp = os.path.join('data/cut', f"{dataset_name}_{name}_{ts}.csv")
            piece.to_csv(fp, index=False)
            print(f"   ✓ {name}: {fp} ({len(piece):,} rows)")
        meta = {'timestamp': ts, 'dataset': dataset_name,
                'original_rows': sum(len(d) for _, d in results),
                'pieces': [{'name': n, 'rows': len(d), 'columns': list(d.columns)}
                           for n, d in results]}
        mfp = os.path.join('data/cut', f"{dataset_name}_metadata_{ts}.json")
        with open(mfp, 'w') as f:
            json.dump(meta, f, indent=2, default=str)
        print(f"   Metadata → {mfp}")

    def _show_cut_history(self):
        if not self.cut_history:
            print("\n  No cut operations yet."); return
        print("\n✂  CUT HISTORY:")
        for i, r in enumerate(self.cut_history, 1):
            print(f"\n{i}. {r['timestamp']:%Y-%m-%d %H:%M}  |  {r['method']}  "
                  f"({r.get('value', 'N/A')})  |  pieces: {r.get('output_pieces', '?')}")

    # ---- interactive menu (consolidated column selection) ----

    def cut_multiple_ways(self, df, dataset_name="dataset"):
        while True:
            print(f"\n{'=' * 60}\n✂  DATASET CUTTER — {dataset_name} "
                  f"({len(df):,} rows)\n{'=' * 60}")
            print("  ROW CUTTING:")
            print("  1. By percentage    2. By row count   3. Split into N parts")
            print("  4. By date range    5. By category    6. Train/Test split")
            print("  COLUMN CUTTING:")
            print("  7. Select columns   8. Remove columns  9. Keep by type")
            print(" 10. Split by columns")
            print(" 11. Cut history      12. Back")
            ch = input("\nChoice (1-12): ").strip()
            handler = {
                '1': lambda: self._ui_pct(df, dataset_name),
                '2': lambda: self._ui_rows(df, dataset_name),
                '3': lambda: self._ui_parts(df, dataset_name),
                '4': lambda: self._ui_date(df, dataset_name),
                '5': lambda: self._ui_category(df, dataset_name),
                '6': lambda: self._ui_traintest(df, dataset_name),
                '7': lambda: self._ui_select_cols(df, dataset_name),
                '8': lambda: self._ui_remove_cols(df, dataset_name),
                '9': lambda: self._ui_cols_by_type(df, dataset_name),
                '10': lambda: self._ui_split_cols(df, dataset_name),
                '11': self._show_cut_history,
            }.get(ch)
            if handler:
                handler()
            elif ch == '12':
                break
            else:
                print("❌ Invalid choice")

    def _ask_strategy(self, df):
        """Return (strategy, balance_col)."""
        print("  1. Sequential  2. Random  3. Balanced (needs column)")
        c = input("Strategy (1-3): ").strip()
        if c == '2':
            return 'random', None
        if c == '3':
            col = input("Balance column: ").strip()
            return 'balanced', col if col in df.columns else None
        return 'sequential', None

    def _ui_pct(self, df, name):
        try:
            pct = float(input("Percentage (1-100): ").strip())
            strat, bcol = self._ask_strategy(df)
            r = self.cut_dataset(df, method='percentage', value=pct,
                                 strategy=strat, balance_column=bcol,
                                 output_prefix=f"{name}_pct{pct}")
            if r:
                self._save_cut_results(r, name)
        except ValueError:
            print("❌ Enter a valid number")

    def _ui_rows(self, df, name):
        try:
            n = int(input(f"Row count (1-{len(df)}): ").strip())
            strat, bcol = self._ask_strategy(df)
            r = self.cut_dataset(df, method='rows', value=n,
                                 strategy=strat, balance_column=bcol,
                                 output_prefix=f"{name}_rows{n}")
            if r:
                self._save_cut_results(r, name)
        except ValueError:
            print("❌ Enter a valid number")

    def _ui_parts(self, df, name):
        try:
            n = int(input("Number of parts: ").strip())
            strat = 'sequential' if input("Sequential? (y/n): ").strip().lower() != 'n' else 'random'
            r = self.cut_dataset(df, method='parts', value=n,
                                 strategy=strat, output_prefix=f"{name}_parts{n}")
            if r:
                self._save_cut_results(r, name)
        except ValueError:
            print("❌ Enter a valid number")

    def _ui_date(self, df, name):
        print("Columns:", list(df.columns[:15]))
        col = input("Date column name: ").strip()
        if col not in df.columns:
            print("❌ Not found"); return
        try:
            pct = float(input("Cut at what % of date range? ").strip())
            r = self.cut_dataset(df, method='date_range', value=pct,
                                 balance_column=col, output_prefix=f"{name}_datecut")
            if r:
                self._save_cut_results(r, name)
        except ValueError:
            print("❌ Invalid number")

    def _ui_category(self, df, name):
        for col in df.columns[:15]:
            if df[col].nunique() < 50:
                print(f"  {col} ({df[col].nunique()} unique)")
        col = input("Category column: ").strip()
        if col not in df.columns:
            print("❌ Not found"); return
        r = self.cut_dataset(df, method='category', balance_column=col,
                             output_prefix=f"{name}_cat")
        if r:
            self._save_cut_results(r, name)

    def _ui_traintest(self, df, name):
        try:
            ratio = float(input("Test size (e.g. 0.2): ").strip())
            if not 0 < ratio < 1:
                print("❌ Must be 0–1"); return
            strat_col = None
            if input("Stratify? (y/n): ").strip().lower() == 'y':
                strat_col = input("Column: ").strip()
                if strat_col not in df.columns:
                    strat_col = None

            try:
                from sklearn.model_selection import train_test_split
                kw = {'test_size': ratio, 'random_state': 42}
                if strat_col:
                    kw['stratify'] = df[strat_col]
                train_df, test_df = train_test_split(df, **kw)
            except ImportError:
                mask = np.random.rand(len(df)) < (1 - ratio)
                train_df, test_df = df[mask], df[~mask]

            ts = datetime.now().strftime('%Y%m%d_%H%M%S')
            for label, sub in [('train', train_df), ('test', test_df)]:
                fp = os.path.join('data/cut', f'{name}_{label}_{ts}.csv')
                sub.to_csv(fp, index=False)
                print(f"✓ {label}: {fp} ({len(sub):,} rows)")
        except ValueError:
            print("❌ Invalid number")

    # ---- column selection UI (shared parser) ----

    def _ui_select_cols(self, df, name):
        print(f"\nDataset columns ({len(df.columns)}):")
        for i, col in enumerate(df.columns, 1):
            print(f"  {i:2d}. {col}")
        sel, ok = _parse_column_selection(df, input("Select columns: ").strip())
        if ok:
            new = df[sel]
            fp = os.path.join('data/cut',
                              f"{name}_selected_{datetime.now():%Y%m%d_%H%M%S}.csv")
            new.to_csv(fp, index=False)
            print(f"✓ Saved {len(sel)} cols → {fp}")

    def _ui_remove_cols(self, df, name):
        print(f"\n{len(df.columns)} columns. Select to REMOVE:")
        for i, col in enumerate(df.columns, 1):
            print(f"  {i:2d}. {col}")
        ch = input("Columns to remove: ").strip().lower()
        remove = []
        if ch == 'empty':
            remove = [c for c in df.columns if df[c].isna().mean() > 0.5]
        elif ch == 'constant':
            remove = [c for c in df.columns if df[c].nunique() <= 1]
        elif ch == 'temporary':
            remove = [c for c in df.columns if c.startswith('_')]
        else:
            # reuse parser — it returns columns to KEEP, so invert
            keep, ok = _parse_column_selection(df, ch)
            if ok:
                remove = [c for c in df.columns if c not in keep]
        if not remove:
            print("❌ Nothing selected"); return
        keep_cols = [c for c in df.columns if c not in remove]
        new = df[keep_cols]
        fp = os.path.join('data/cut',
                          f"{name}_removed_{datetime.now():%Y%m%d_%H%M%S}.csv")
        new.to_csv(fp, index=False)
        print(f"✓ Removed {len(remove)} cols, saved {len(keep_cols)} → {fp}")

    def _ui_cols_by_type(self, df, name):
        num = [c for c in df.columns if pd.api.types.is_numeric_dtype(df[c])]
        txt = [c for c in df.columns if df[c].dtype == 'object']
        dt = []
        for c in txt[:]:
            try:
                if pd.to_datetime(df[c], errors='coerce').notna().any():
                    dt.append(c); txt.remove(c)
            except Exception:
                pass
        print(f"  Numeric: {len(num)}  Date: {len(dt)}  Text: {len(txt)}")
        print("  1. Numeric  2. Text  3. Date  4. Custom combo (e.g. n,d)")
        ch = input("Choice: ").strip()
        sel = []
        if ch == '1':
            sel = num; tname = 'numeric'
        elif ch == '2':
            sel = txt; tname = 'text'
        elif ch == '3':
            sel = dt; tname = 'date'
        elif ch == '4':
            combo = input("Types (n,d,t): ").strip().lower()
            if 'n' in combo: sel += num
            if 'd' in combo: sel += dt
            if 't' in combo: sel += txt
            tname = 'custom'
        else:
            return
        if not sel:
            print("❌ No columns of that type"); return
        fp = os.path.join('data/cut',
                          f"{name}_{tname}_{datetime.now():%Y%m%d_%H%M%S}.csv")
        df[sel].to_csv(fp, index=False)
        print(f"✓ Saved {len(sel)} {tname} columns → {fp}")

    def _ui_split_cols(self, df, name):
        print(f"\nColumns ({len(df.columns)}):")
        for i, col in enumerate(df.columns, 1):
            print(f"  {i}. {col}")
        try:
            ng = int(input("Number of groups (2-5): ").strip())
            assert 2 <= ng <= 5
        except Exception:
            print("❌ Invalid"); return

        groups, remaining = [], list(df.columns)
        for g in range(1, ng + 1):
            if g == ng:
                groups.append(remaining[:]); break
            ch = input(f"Group {g} columns (numbers or 'auto'): ").strip()
            if ch.lower() == 'auto':
                per = len(df.columns) // ng
                s = (g - 1) * per
                e = s + per if g < ng else len(df.columns)
                grp = list(df.columns[s:e])
            else:
                grp, _ = _parse_column_selection(df, ch)
            for c in grp:
                if c in remaining:
                    remaining.remove(c)
            groups.append(grp)

        ts = datetime.now().strftime('%Y%m%d_%H%M%S')
        for i, grp in enumerate(groups, 1):
            if grp:
                fp = os.path.join('data/cut', f"{name}_group{i}_{ts}.csv")
                df[grp].to_csv(fp, index=False)
                print(f"✓ Group {i}: {fp}")
        print("✂  Column split complete")


# ============================================================
# 4. DATASET MERGER (unchanged logic)
# ============================================================

class DatasetMerger:

    def __init__(self):
        self.datasets = []
        self.merge_history = []

    def add_dataset(self, name, dataframe):
        if dataframe is None or dataframe.empty:
            print(f"❌ Empty dataset: {name}"); return False
        self.datasets.append({'name': name, 'data': dataframe,
                              'rows': len(dataframe), 'columns': len(dataframe.columns)})
        print(f"✓ Added '{name}' ({len(dataframe):,} rows)")
        return True

    def show_dataset_info(self):
        if not self.datasets:
            print("\n📭 No datasets loaded."); return
        print(f"\n📦 Loaded ({len(self.datasets)}):")
        for i, ds in enumerate(self.datasets, 1):
            print(f"{i}. {ds['name']}  |  {ds['rows']:,} rows × {ds['columns']} cols")

    def find_matching_columns(self):
        if len(self.datasets) < 2:
            return {}
        col_map = {}
        for ds in self.datasets:
            for c in ds['data'].columns:
                col_map.setdefault(c, []).append(ds['name'])
        common = {c: v for c, v in col_map.items() if len(v) > 1}
        if common:
            print("\n🔗 Common columns:")
            for c, ds_list in common.items():
                print(f"  '{c}' → {', '.join(ds_list)}")
        return common

    def merge_datasets(self, merge_type='smart'):
        if len(self.datasets) < 2:
            print("❌ Need ≥ 2 datasets."); return None
        print(f"\n🔗 Merging {len(self.datasets)} datasets ({merge_type}) …")
        result = {'smart': self._smart, 'vertical': self._vertical,
                  'horizontal': self._horizontal}.get(merge_type, self._smart)()
        if result is not None:
            rb = sum(d['rows'] for d in self.datasets)
            self.merge_history.append({'timestamp': datetime.now(),
                                       'datasets': [d['name'] for d in self.datasets],
                                       'merge_type': merge_type,
                                       'result_shape': result.shape,
                                       'rows_before': rb, 'rows_after': len(result)})
            print(f"✓ Merged → {len(result):,} rows × {len(result.columns)} cols "
                  f"(dropped {rb - len(result):,} dupes)")
        return result

    def _vertical(self):
        frames = []
        for ds in self.datasets:
            df = ds['data'].copy()
            df['_source'] = ds['name']
            frames.append(df)
        return pd.concat(frames, ignore_index=True)

    def _horizontal(self):
        all_cols = {c for ds in self.datasets for c in ds['data'].columns}
        print("Columns:", sorted(all_cols))
        key = input("\nMerge key column: ").strip()
        missing = [d['name'] for d in self.datasets if key not in d['data'].columns]
        if missing:
            print(f"❌ '{key}' missing in: {', '.join(missing)}"); return None
        merged = self.datasets[0]['data']
        for ds in self.datasets[1:]:
            merged = pd.merge(merged, ds['data'], on=key, how='outer',
                              suffixes=('', f"_{ds['name']}"))
        return merged

    def _smart(self):
        merged = self._vertical()
        before = len(merged)
        merged = merged.drop_duplicates()
        d = before - len(merged)
        if d:
            print(f"  Removed {d} exact duplicates")

        key_candidates = [c for c in merged.columns if c != '_source' and
                          any(k in c.lower() for k in
                              ('id', 'code', 'key', 'name', 'email', 'title', 'headline'))
                          and merged[c].notna().any()]
        if key_candidates:
            print(f"  Key candidates: {key_candidates[:5]}")
            sel = input("Cols for near-duplicate detection (Enter to skip): ").strip()
            if sel:
                cols = []
                for item in sel.split(','):
                    item = item.strip()
                    if item.isdigit():
                        idx = int(item) - 1
                        if 0 <= idx < len(key_candidates):
                            cols.append(key_candidates[idx])
                    elif item in merged.columns:
                        cols.append(item)
                if cols:
                    b = len(merged)
                    merged = merged.drop_duplicates(subset=cols, keep='first')
                    print(f"✓ Removed {b - len(merged)} near-duplicates")
        return merged

    def get_dataset_by_name(self, name):
        for ds in self.datasets:
            if ds['name'] == name:
                return ds['data']
        return None

    def update_dataset(self, name, new_data):
        for ds in self.datasets:
            if ds['name'] == name:
                ds['data'] = new_data
                ds['rows'] = len(new_data)
                ds['columns'] = len(new_data.columns)
                return True
        return False

    def remove_dataset(self, name):
        for i, ds in enumerate(self.datasets):
            if ds['name'] == name:
                self.datasets.pop(i)
                return True
        return False


# ============================================================
# 5. DATA CLEANER (vectorized outlier detection)
# ============================================================

class DataCleaner:

    def __init__(self):
        self.problems_found = []
        self.fixes_applied = []

    def analyze_dataset(self, df):
        print(f"\n🔍 Analyzing ({len(df):,} rows × {len(df.columns)} cols) …")
        problems = []

        # 1. Missing values
        missing = df.isnull().sum()
        miss_cols = missing[missing > 0]
        if len(miss_cols):
            problems.append({'type': 'missing_values', 'count': int(missing.sum()),
                             'columns': list(miss_cols.index), 'severity': 'medium'})
            print(f"  ⚠ Missing values: {missing.sum():,}")

        # 2. Duplicates
        dups = int(df.duplicated().sum())
        if dups:
            problems.append({'type': 'exact_duplicates', 'count': dups, 'severity': 'high'})
            print(f"  ⚠ Exact duplicates: {dups:,}")

        # 3. Outliers — vectorized IQR across all numeric columns at once
        num_df = df.select_dtypes(include=[np.number])
        if not num_df.empty:
            Q1 = num_df.quantile(0.25)
            Q3 = num_df.quantile(0.75)
            IQR = Q3 - Q1
            outlier_mask = ((num_df < (Q1 - 1.5 * IQR)) | (num_df > (Q3 + 1.5 * IQR)))
            outlier_counts = outlier_mask.sum()
            outlier_cols = outlier_counts[outlier_counts > 0]
            if len(outlier_cols):
                problems.append({
                    'type': 'outliers',
                    'details': [{'column': c, 'outliers': int(outlier_counts[c]),
                                 'percent': outlier_counts[c] / len(df) * 100}
                                for c in outlier_cols.index],
                    'severity': 'low'})
                print(f"  ⚠ Outliers in {len(outlier_cols)} column(s)")

        # 4. Logical checks
        problems.extend(self._check_logical(df))

        self.problems_found = problems
        if not problems:
            print("  ✅ No major problems found!")
        else:
            print(f"  Summary: {len(problems)} issue type(s)")
        return problems

    def _check_logical(self, df):
        problems = []
        now = pd.Timestamp(datetime.now())

        date_cols = [c for c in df.columns
                     if any(k in c.lower() for k in ('date', 'time', 'timestamp'))]
        for c in date_cols:
            try:
                dates = pd.to_datetime(df[c], errors='coerce')
                if hasattr(dates.dt, 'tz') and dates.dt.tz is not None:
                    dates = dates.dt.tz_localize(None)
                future = (dates > now).sum()
                if future:
                    problems.append({'type': 'future_dates', 'column': c,
                                     'count': int(future), 'severity': 'medium'})
            except Exception:
                pass

        for c in df.columns:
            if any(k in c.lower() for k in ('age', 'salary', 'price', 'amount', 'quantity')):
                if pd.api.types.is_numeric_dtype(df[c]):
                    neg = (df[c] < 0).sum()
                    if neg:
                        problems.append({'type': 'negative_values', 'column': c,
                                         'count': int(neg), 'severity': 'high'})
        return problems

    def clean_dataset(self, df, auto_fix=False):
        if not self.problems_found:
            print("  No problems to fix!"); return df
        print("\n🧹 Cleaning …")

        if not auto_fix:
            print("Found issues:")
            for i, p in enumerate(self.problems_found, 1):
                print(f"  {i}. [{p['severity'].upper()}] {p['type']}: "
                      f"{p.get('count', len(p.get('columns', [])))}")
            if input("\nFix all? (y/n): ").strip().lower() != 'y':
                return df

        cleaned = df.copy()
        for p in self.problems_found:
            if p['type'] == 'exact_duplicates':
                b = len(cleaned)
                cleaned = cleaned.drop_duplicates()
                self.fixes_applied.append(f"Removed {b - len(cleaned)} duplicate rows")
                print(f"✓ Removed {b - len(cleaned)} duplicates")

            elif p['type'] == 'missing_values':
                for c in p.get('columns', []):
                    if pd.api.types.is_numeric_dtype(cleaned[c]):
                        m = cleaned[c].isna().sum()
                        cleaned[c] = cleaned[c].fillna(cleaned[c].median())
                        self.fixes_applied.append(f"Filled {m} NaN in '{c}'")
                        print(f"✓ Filled {m} NaN in '{c}'")

            elif p['type'] == 'negative_values':
                c = p['column']
                med = cleaned.loc[cleaned[c] >= 0, c].median()
                if pd.notna(med):
                    mask = cleaned[c] < 0
                    cleaned.loc[mask, c] = med
                    self.fixes_applied.append(f"Fixed {mask.sum()} negatives in '{c}'")
                    print(f"✓ Fixed {mask.sum()} negatives in '{c}'")

            elif p['type'] == 'date_inversion':
                c1, c2 = p['columns']
                d1 = pd.to_datetime(cleaned[c1], errors='coerce')
                d2 = pd.to_datetime(cleaned[c2], errors='coerce')
                if hasattr(d1.dt, 'tz') and d1.dt.tz is not None:
                    d1, d2 = d1.dt.tz_localize(None), d2.dt.tz_localize(None)
                mask = d1 > d2
                cleaned.loc[mask, [c1, c2]] = cleaned.loc[mask, [c2, c1]].values
                self.fixes_applied.append(f"Fixed {mask.sum()} date inversions")
                print(f"✓ Fixed {mask.sum()} date inversions")

        print(f"\n✅ {len(self.fixes_applied)} fix(es) applied")
        return cleaned


# ============================================================
# 6. TEMPORAL PRIORITY SCORER (VECTORIZED — no iterrows)
# ============================================================

class TemporalScorer:

    def __init__(self):
        self.user_selected_time_column = None
        self.time_column_present = False

    def ask_user_about_time(self, df):
        print(f"\n{'=' * 50}\n🕐 TEMPORAL PRIORITY SCORING\n{'=' * 50}")
        print("Your columns:")
        for i, col in enumerate(df.columns[:15], 1):
            s = df[col].iloc[0] if len(df) and pd.notna(df[col].iloc[0]) else "N/A"
            print(f"  {i}. {col}  (e.g. {str(s)[:30]})")
        if len(df.columns) > 15:
            print(f"  … +{len(df.columns) - 15} more")

        if input("Has time/date data? (y/n): ").strip().lower() == 'y':
            self.time_column_present = True
            self._select_time_column(df)
        else:
            self.time_column_present = False
            print("  All rows → Priority 1 (Old)")
        return self.time_column_present

    def _select_time_column(self, df):
        cols = list(df.columns)
        for i, col in enumerate(cols, 1):
            hint = " ⏰" if any(k in col.lower() for k in
                                ('date', 'time', 'timestamp', 'year', 'month')) else ""
            s = df[col].iloc[0] if len(df) and pd.notna(df[col].iloc[0]) else "N/A"
            print(f"  {i}. {col}{hint}  ({str(s)[:20]})")
        while True:
            sel = input("\nColumn number or name: ").strip()
            if sel.isdigit():
                idx = int(sel) - 1
                if 0 <= idx < len(cols):
                    self.user_selected_time_column = cols[idx]; break
            elif sel in cols:
                self.user_selected_time_column = sel; break
            print("❌ Try again")
        self._confirm_time_format(df)

    def _confirm_time_format(self, df):
        col = self.user_selected_time_column
        samples = df[col].dropna().head(3)
        print("\nSamples:", list(samples))
        dates = pd.to_datetime(samples, errors='coerce')
        if dates.notna().any():
            print("✓ Parsed as dates")
            all_d = pd.to_datetime(df[col], errors='coerce')
            if hasattr(all_d.dt, 'tz') and all_d.dt.tz is not None:
                all_d = all_d.dt.tz_localize(None)
            valid = all_d.dropna()
            if len(valid):
                print(f"  Range: {valid.min()} → {valid.max()} ({(valid.max() - valid.min()).days} days)")

    def analyze_temporal_data(self, df):
        if not self.time_column_present:
            return {}
        if self.user_selected_time_column:
            return {self.user_selected_time_column: 3}
        return {}

    def add_priority_scores(self, df, temporal_scores):
        """Vectorized priority scoring — ~100× faster than iterrows."""
        current_time = pd.Timestamp(datetime.now())
        print(f"\n🕐 Scoring against current time: {current_time:%Y-%m-%d %H:%M:%S}")

        if not temporal_scores and not self.time_column_present:
            df['_temporal_priority'] = 1
            print("  All rows → Priority 1 (Old)")
            return df

        col = self.user_selected_time_column
        if not col or col not in df.columns:
            df['_temporal_priority'] = 1
            return df

        # --- Vectorized: parse dates, compute days_old, bucket into 1-4 ---
        dates = pd.to_datetime(df[col], errors='coerce')
        if hasattr(dates.dt, 'tz') and dates.dt.tz is not None:
            dates = dates.dt.tz_localize(None)

        days_old = (current_time - dates).dt.days  # Series of int64 (NaT → NaN)

        # np.select is fast: evaluates conditions in order, assigns values
        conditions = [
            days_old.isna(),                      # NaT / unparseable
            days_old > 730,                       # > 2 years
            days_old > 365,                       # 1–2 years
            days_old > 30,                        # 30 days – 1 year
            days_old <= 30,                       # ≤ 30 days  (includes future → negative)
        ]
        choices = [1, 1, 2, 3, 4]

        priorities = np.select(conditions, choices, default=1)
        df['_temporal_priority'] = priorities

        # --- Distribution ---
        counts = pd.Series(priorities).value_counts().sort_index()
        total = len(df)
        labels = {1: 'Old (>2yr)', 2: 'Medium (1-2yr)',
                  3: 'Recent (30d-1yr)', 4: 'Very Recent (<30d)'}
        print("\nPriority distribution:")
        for p in [1, 2, 3, 4]:
            c = counts.get(p, 0)
            print(f"  {p} ({labels[p]}): {c:,} rows ({c / total * 100:.1f}%)")

        # --- Date range ---
        valid = dates.dropna()
        if len(valid):
            oldest, newest = valid.min(), valid.max()
            for label, d in [("Oldest", oldest), ("Newest", newest)]:
                d_old = (current_time - d).days
                p = 4 if d_old <= 30 else 3 if d_old <= 365 else 2 if d_old <= 730 else 1
                print(f"  {label}: {d} ({d_old}d old) → Priority {p}")

        return df


# ============================================================
# 7. MAIN PIPELINE
# ============================================================

class DatasetCurationPipeline:

    def __init__(self):
        self.loader = DataLoader()
        self.merger = DatasetMerger()
        self.cleaner = DataCleaner()
        self.scorer = TemporalScorer()
        self.cutter = DataCutter()
        self.current_data = None
        self.current_dataset_name = None
        self.history = []

    def run(self):
        print("\n" + "=" * 60)
        print("  DATASET CURATION PIPELINE (Optimized)")
        print("=" * 60)
        setup_directories()
        while True:
            self._main_menu()

    def _main_menu(self):
        options = {
            '1': 'Load datasets', '2': 'Show loaded datasets',
            '3': 'Merge datasets', '4': 'Clean a dataset',
            '5': 'Add temporal priority', '6': 'Cut a dataset',
            '7': 'Set current dataset', '8': 'Calculate overall priority',
            '9': 'Save current dataset', '10': 'Run complete pipeline',
            '11': 'Show pipeline status', '12': 'Export reports',
            '13': 'Exit'
        }
        ch = show_menu("MAIN MENU", options)
        handlers = {
            '1': self._load, '2': self._show_loaded,
            '3': self._merge, '4': self._clean,
            '5': self._add_priority, '6': self._cut,
            '7': self._set_current, '8': self._overall_priority,
            '9': self._save, '10': self._full_pipeline,
            '11': self._status, '12': self._export_reports,
        }
        h = handlers.get(ch)
        if h:
            h()
        elif ch == '13':
            print("\n👋 Bye!"); raise SystemExit
        else:
            print("❌ Invalid choice")

    # ---- selection helper ----

    def _select_dataset(self, action):
        if not self.merger.datasets:
            print(f"❌ No datasets loaded."); return None, None
        print(f"\nSelect dataset to {action}:")
        for i, ds in enumerate(self.merger.datasets, 1):
            cur = " ◄ current" if self.current_data is ds['data'] else ""
            print(f"  {i}. {ds['name']} ({ds['rows']:,} rows){cur}")
        print(f"  'c' = current, 'b' = back")
        while True:
            ch = input("\nChoice: ").strip().lower()
            if ch == 'b':
                return None, None
            if ch == 'c' and self.current_data is not None:
                return self.current_data, self.current_dataset_name
            if ch.isdigit():
                idx = int(ch) - 1
                if 0 <= idx < len(self.merger.datasets):
                    ds = self.merger.datasets[idx]
                    return ds['data'], ds['name']
            print("❌ Try again")

    # ---- menu actions ----

    def _load(self):
        datasets = self.loader.load_multiple_sources()
        for ds in datasets:
            self.merger.add_dataset(ds['name'], ds['data'])
        if len(datasets) == 1:
            self.current_data = datasets[0]['data']
            self.current_dataset_name = datasets[0]['name']
        input("\nPress Enter …")

    def _show_loaded(self):
        self.merger.show_dataset_info()
        input("\nPress Enter …")

    def _set_current(self):
        if not self.merger.datasets:
            print("❌ No datasets."); return
        self.merger.show_dataset_info()
        try:
            idx = int(input("Dataset number: ").strip()) - 1
            ds = self.merger.datasets[idx]
            self.current_data = ds['data']
            self.current_dataset_name = ds['name']
            print(f"✓ Current → {ds['name']}")
        except Exception:
            print("❌ Invalid")
        input("\nPress Enter …")

    def _merge(self):
        if len(self.merger.datasets) < 2:
            print("❌ Need ≥ 2 datasets."); input("\nPress Enter …"); return
        self.merger.show_dataset_info()
        self.merger.find_matching_columns()
        ch = input("\nMerge type (1=smart 2=vertical 3=horizontal): ").strip()
        mt = {'1': 'smart', '2': 'vertical', '3': 'horizontal'}.get(ch, 'smart')
        merged = self.merger.merge_datasets(mt)
        if merged is not None:
            self.current_data = merged
            self.current_dataset_name = f"merged_{datetime.now():%Y%m%d_%H%M%S}"
        input("\nPress Enter …")

    def _clean(self):
        df, name = self._select_dataset("clean")
        if df is None:
            return
        print(f"\n🧹 Cleaning: {name} ({len(df):,} rows)")
        self.cleaner.analyze_dataset(df)
        if self.cleaner.problems_found:
            if input("Proceed? (y/n): ").strip().lower() == 'y':
                cleaned = self.cleaner.clean_dataset(df, auto_fix=True)
                self.merger.update_dataset(name, cleaned)
                if self.current_dataset_name == name:
                    self.current_data = cleaned
        input("\nPress Enter …")

    def _add_priority(self):
        df, name = self._select_dataset("score")
        if df is None:
            return
        self.scorer.ask_user_about_time(df)
        scores = self.scorer.analyze_temporal_data(df)
        df = self.scorer.add_priority_scores(df, scores)
        self.merger.update_dataset(name, df)
        if self.current_dataset_name == name:
            self.current_data = df
        input("\nPress Enter …")

    def _overall_priority(self):
        df, name = self._select_dataset("calculate overall priority")
        if df is None:
            return
        if '_temporal_priority' not in df.columns:
            print("❌ Run 'Add temporal priority' first.")
            if input("Run now? (y/n): ").strip().lower() == 'y':
                self.scorer.ask_user_about_time(df)
                scores = self.scorer.analyze_temporal_data(df)
                df = self.scorer.add_priority_scores(df, scores)
                self.merger.update_dataset(name, df)
                if self.current_dataset_name == name:
                    self.current_data = df
            else:
                input("\nPress Enter …"); return

        print("\n" + "-" * 40)
        print("SOURCE PRIORITY (0.0–1.0 for all rows)")
        print("  High reliability: 0.8–1.0")
        print("  Medium: 0.5–0.7  |  Low: 0.2–0.4")
        while True:
            try:
                sp = float(input("Source priority: ").strip())
                if 0.0 <= sp <= 1.0:
                    break
            except ValueError:
                pass
            print("❌ Enter 0.0–1.0")

        df['_source_priority'] = sp
        df['_overall_priority'] = df['_temporal_priority'] * sp

        print(f"\n{'=' * 50}")
        print(f"Overall = Temporal × {sp:.3f}")
        print(f"  Mean: {df['_overall_priority'].mean():.3f}  "
              f"Std: {df['_overall_priority'].std():.3f}")
        print(f"  Min:  {df['_overall_priority'].min():.3f}  "
              f"Max: {df['_overall_priority'].max():.3f}")

        if input("\nSave? (y/n): ").strip().lower() == 'y':
            self.merger.update_dataset(name, df)
            if self.current_dataset_name == name:
                self.current_data = df
            ts = datetime.now().strftime('%Y%m%d_%H%M%S')
            fp = os.path.join('data/cut', f"{name}_overall_{ts}.csv")
            df.to_csv(fp, index=False)
            print(f"✓ Saved → {fp}")
        input("\nPress Enter …")

    def _cut(self):
        df, name = self._select_dataset("cut")
        if df is not None:
            self.cutter.cut_multiple_ways(df, name)

    def _save(self):
        if self.current_data is None:
            print("❌ No current dataset."); input("\nPress Enter …"); return
        default = f"{self.current_dataset_name}_{datetime.now():%Y%m%d_%H%M%S}"
        fn = input(f"Filename (default: {default}): ").strip() or default
        fmt = input("Format (1=CSV 2=Excel 3=JSON 4=All): ").strip()
        try:
            if fmt == '1':
                self.current_data.to_csv(f"data/processed/{fn}.csv", index=False)
            elif fmt == '2':
                self.current_data.to_excel(f"data/processed/{fn}.xlsx", index=False)
            elif fmt == '3':
                self.current_data.to_json(f"data/processed/{fn}.json",
                                          orient='records', indent=2)
            elif fmt == '4':
                self.current_data.to_csv(f"data/processed/{fn}.csv", index=False)
                self.current_data.to_excel(f"data/processed/{fn}.xlsx", index=False)
                self.current_data.to_json(f"data/processed/{fn}.json",
                                          orient='records', indent=2)
            else:
                self.current_data.to_csv(f"data/processed/{fn}.csv", index=False)
            print(f"✓ Saved")
        except Exception as e:
            print(f"❌ {e}")
        input("\nPress Enter …")

    def _status(self):
        print("\n" + "=" * 60 + "\n📊 PIPELINE STATUS\n" + "=" * 60)
        if self.current_data is not None:
            print(f"\n  Current: {self.current_dataset_name}")
            print(f"  Shape: {self.current_data.shape}")
            spec = [c for c in self.current_data.columns if c.startswith('_')]
            if spec:
                print(f"  Special cols: {spec}")
            mem = self.current_data.memory_usage(deep=True).sum() / 1048576
            print(f"  Memory: {mem:.2f} MB")
        else:
            print("\n  📭 No current dataset")
        if self.merger.datasets:
            print(f"\n  Loaded: {len(self.merger.datasets)} dataset(s)")
            for ds in self.merger.datasets:
                print(f"    - {ds['name']} ({ds['rows']:,} rows)")
        print(f"\n  data/raw/       → upload CSV files here")
        print(f"  data/processed/ → cleaned output")
        print(f"  data/cut/       → cut/split pieces")
        print(f"  reports/        → analysis reports")
        input("\nPress Enter …")

    def _export_reports(self):
        if self.current_data is None:
            print("❌ No dataset."); input("\nPress Enter …"); return
        ts = datetime.now().strftime('%Y%m%d_%H%M%S')
        os.makedirs('reports', exist_ok=True)

        summary = {
            'export_date': ts, 'dataset': self.current_dataset_name,
            'shape': list(self.current_data.shape),
            'columns': list(self.current_data.columns),
            'dtypes': {c: str(self.current_data[c].dtype)
                       for c in self.current_data.columns},
            'missing': int(self.current_data.isnull().sum().sum()),
            'duplicates': int(self.current_data.duplicated().sum()),
            'memory_mb': round(self.current_data.memory_usage(deep=True).sum() / 1048576, 2)
        }
        if '_temporal_priority' in self.current_data.columns:
            summary['priority_dist'] = self.current_data[
                '_temporal_priority'].value_counts().to_dict()
        if '_overall_priority' in self.current_data.columns:
            o = self.current_data['_overall_priority']
            summary['overall'] = {'mean': round(float(o.mean()), 3),
                                  'std': round(float(o.std()), 3),
                                  'min': round(float(o.min()), 3),
                                  'max': round(float(o.max()), 3)}

        with open(f"reports/{self.current_dataset_name}_summary_{ts}.json", 'w') as f:
            json.dump(summary, f, indent=2, default=str)

        self.cleaner.analyze_dataset(self.current_data)
        quality = {'problems': self.cleaner.problems_found,
                   'fixes': self.cleaner.fixes_applied}
        with open(f"reports/{self.current_dataset_name}_quality_{ts}.json", 'w') as f:
            json.dump(quality, f, indent=2, default=str)

        self.current_data.head(100).to_csv(
            f"reports/{self.current_dataset_name}_sample_{ts}.csv", index=False)

        print(f"\n✓ Reports exported to reports/ (summary, quality, sample)")

        input("\nPress Enter …")

    # ---- full pipeline ----

    def _full_pipeline(self):
        print("\n" + "=" * 60)
        print("  COMPLETE PIPELINE")
        print("=" * 60)
        if input("Proceed? (y/n): ").strip().lower() != 'y':
            return

        steps = [
            ("Load", self._pl_load), ("Merge", self._pl_merge),
            ("Clean", self._pl_clean), ("Priority", self._pl_priority),
            ("Overall", self._pl_overall), ("Cut", self._pl_cut),
            ("Save", self._pl_save),
        ]
        for name, fn in steps:
            print(f"\n--- {name} ---")
            try:
                fn()
            except Exception as e:
                print(f"❌ {name}: {e}")
                if input("Retry? (y/n): ").strip().lower() != 'y':
                    continue
                try:
                    fn()
                except Exception:
                    pass

        print("\n✅ Pipeline complete!")

    def _pl_load(self):
        files = self.loader.list_data_sources()
        if not files:
            self._create_sample()
            files = self.loader.list_data_sources()
        for f in files:
            fp = os.path.join('data/raw', f)
            df = self.loader.load_from_source(fp)
            if df is not None:
                self.merger.add_dataset(f.split('.')[0], df)
        if len(self.merger.datasets) == 1:
            self.current_data = self.merger.datasets[0]['data']
            self.current_dataset_name = self.merger.datasets[0]['name']

    def _pl_merge(self):
        if len(self.merger.datasets) < 2:
            if self.merger.datasets:
                self.current_data = self.merger.datasets[0]['data']
                self.current_dataset_name = self.merger.datasets[0]['name']
            return
        self.current_data = self.merger.merge_datasets('smart')
        self.current_dataset_name = f"merged_{datetime.now():%Y%m%d_%H%M%S}"

    def _pl_clean(self):
        if self.current_data is not None:
            self.cleaner.analyze_dataset(self.current_data)
            self.current_data = self.cleaner.clean_dataset(self.current_data, auto_fix=True)

    def _pl_priority(self):
        if self.current_data is not None:
            self.scorer.ask_user_about_time(self.current_data)
            scores = self.scorer.analyze_temporal_data(self.current_data)
            self.current_data = self.scorer.add_priority_scores(self.current_data, scores)

    def _pl_overall(self):
        if self.current_data is not None and '_temporal_priority' in self.current_data.columns:
            while True:
                try:
                    sp = float(input("Source priority (0-1): ").strip())
                    if 0 <= sp <= 1:
                        break
                except ValueError:
                    pass
            self.current_data['_source_priority'] = sp
            self.current_data['_overall_priority'] = (
                self.current_data['_temporal_priority'] * sp)

    def _pl_cut(self):
        if self.current_data is None:
            return
        if input("Cut dataset? (y/n): ").strip().lower() == 'y':
            n = int(len(self.current_data) * 0.8)
            train, test = self.current_data.iloc[:n], self.current_data.iloc[n:]
            ts = datetime.now().strftime('%Y%m%d_%H%M%S')
            train.to_csv(f"data/cut/{self.current_dataset_name}_train_{ts}.csv",
                         index=False)
            test.to_csv(f"data/cut/{self.current_dataset_name}_test_{ts}.csv",
                        index=False)
            print(f"  Train: {len(train):,}  Test: {len(test):,}")

    def _pl_save(self):
        if self.current_data is not None:
            ts = datetime.now().strftime('%Y%m%d_%H%M%S')
            fn = f"{self.current_dataset_name}_output_{ts}"
            self.current_data.to_csv(f"data/processed/{fn}.csv", index=False)
            self.current_data.to_excel(f"data/processed/{fn}.xlsx", index=False)

    def _create_sample(self):
        dates = pd.date_range('2023-01-01', periods=50, freq='D')
        df1 = pd.DataFrame({
            'user_id': range(100, 150), 'name': [f'User_{i}' for i in range(50)],
            'signup_date': dates, 'age': np.random.randint(18, 70, 50),
            'country': np.random.choice(['USA', 'UK', 'CA', 'AU'], 50)
        })
        df2 = pd.DataFrame({
            'product_id': range(200, 250),
            'product_name': [f'Product_{i}' for i in range(50)],
            'price': np.random.uniform(10, 1000, 50),
            'category': np.random.choice(['Elec', 'Cloth', 'Books', 'Food'], 50),
            'created_date': pd.date_range('2023-03-01', periods=50, freq='D')
        })
        os.makedirs('data/raw', exist_ok=True)
        df1.to_csv('data/raw/sample_users.csv', index=False)
        df2.to_csv('data/raw/sample_products.csv', index=False)
        print("✓ Created sample data")


