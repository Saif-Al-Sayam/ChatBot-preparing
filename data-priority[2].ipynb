# 3. DATASET CUTTER
# ============================================================

class DataCutter:
    """Cut datasets into smaller pieces based on various criteria"""

    def __init__(self):
        self.cut_history = []

    def cut_dataset(self, df, method='percentage', value=50, strategy='sequential',
                   balance_column=None, output_prefix='cut'):
        """
        Cut dataset into smaller pieces

        Parameters:
        - df: DataFrame to cut
        - method: 'percentage', 'rows', 'parts', 'date_range', 'category'
        - value: value for the cut method
        - strategy: 'sequential', 'random', 'balanced', 'stratified'
        - balance_column: column to use for balanced/stratified cutting
        - output_prefix: prefix for output files
        """

        print(f"\n Cutting dataset using {method} method with {strategy} strategy...")
        print(f"Original dataset: {len(df)} rows, {len(df.columns)} columns")

        results = []

        if method == 'percentage':
            # Cut by percentage
            if value <= 0 or value > 100:
                print("❌ Percentage must be between 1 and 100")
                return None

            # Calculate number of rows
            n_rows = int(len(df) * value / 100)

            if strategy == 'sequential':
                # Take first n_rows
                cut_df = df.iloc[:n_rows].copy()
                results.append(('first', cut_df))

                # Also save the remainder
                remainder_df = df.iloc[n_rows:].copy()
                results.append(('remainder', remainder_df))

            elif strategy == 'random':
                # Random sample
                cut_df = df.sample(n=n_rows, random_state=42).copy()

                # Get remainder (rows not in sample)
                remainder_idx = df.index.difference(cut_df.index)
                remainder_df = df.loc[remainder_idx].copy()
                results.append(('random_sample', cut_df))
                results.append(('remainder', remainder_df))

            elif strategy == 'balanced' and balance_column:
                # Balanced sampling (equal representation from each category)
                cut_df = self._balanced_sample(df, balance_column, n_rows)
                remainder_idx = df.index.difference(cut_df.index)
                remainder_df = df.loc[remainder_idx].copy()
                results.append(('balanced_sample', cut_df))
                results.append(('remainder', remainder_df))

            else:
                # Default to sequential
                cut_df = df.iloc[:n_rows].copy()
                remainder_df = df.iloc[n_rows:].copy()
                results.append(('first', cut_df))
                results.append(('remainder', remainder_df))

        elif method == 'rows':
            # Cut by exact number of rows
            if value <= 0 or value > len(df):
                print(f"❌ Number of rows must be between 1 and {len(df)}")
                return None

            if strategy == 'sequential':
                cut_df = df.iloc[:value].copy()
                remainder_df = df.iloc[value:].copy()
                results.append(('first', cut_df))
                results.append(('remainder', remainder_df))

            elif strategy == 'random':
                cut_df = df.sample(n=value, random_state=42).copy()
                remainder_idx = df.index.difference(cut_df.index)
                remainder_df = df.loc[remainder_idx].copy()
                results.append(('random_sample', cut_df))
                results.append(('remainder', remainder_df))

            elif strategy == 'balanced' and balance_column:
                cut_df = self._balanced_sample(df, balance_column, value)
                remainder_idx = df.index.difference(cut_df.index)
                remainder_df = df.loc[remainder_idx].copy()
                results.append(('balanced_sample', cut_df))
                results.append(('remainder', remainder_df))

        elif method == 'parts':
            # Split into equal parts
            if value < 2:
                print("❌ Number of parts must be at least 2")
                return None

            if value > len(df):
                print(f"❌ Cannot split {len(df)} rows into {value} parts")
                return None

            if strategy == 'sequential':
                # Split sequentially
                part_size = len(df) // value
                for i in range(value):
                    start_idx = i * part_size
                    if i == value - 1:  # Last part gets remaining rows
                        part_df = df.iloc[start_idx:].copy()
                    else:
                        part_df = df.iloc[start_idx:start_idx + part_size].copy()
                    results.append((f'part_{i+1}', part_df))

            elif strategy == 'random':
                # Randomly assign to parts
                shuffled = df.sample(frac=1, random_state=42).copy()
                part_size = len(df) // value
                for i in range(value):
                    start_idx = i * part_size
                    if i == value - 1:
                        part_df = shuffled.iloc[start_idx:].copy()
                    else:
                        part_df = shuffled.iloc[start_idx:start_idx + part_size].copy()
                    results.append((f'random_part_{i+1}', part_df))

        elif method == 'date_range':
            # Cut by date range
            if balance_column is None or balance_column not in df.columns:
                print("❌ Please specify a date column")
                return None

            try:
                # Convert to datetime
                dates = pd.to_datetime(df[balance_column], errors='coerce')
                df_with_dates = df.copy()
                df_with_dates['_temp_date'] = dates

                # Get date range
                min_date = dates.min()
                max_date = dates.max()

                print(f"Date range: {min_date} to {max_date}")

                # Calculate cut points
                date_range = max_date - min_date
                cut_point = min_date + date_range * (value / 100)

                # Split by date
                before_df = df_with_dates[df_with_dates['_temp_date'] <= cut_point].copy()
                after_df = df_with_dates[df_with_dates['_temp_date'] > cut_point].copy()

                # Drop temporary column
                before_df = before_df.drop(columns=['_temp_date'])
                after_df = after_df.drop(columns=['_temp_date'])

                results.append(('before_cut_date', before_df))
                results.append(('after_cut_date', after_df))

            except Exception as e:
                print(f"❌ Error processing dates: {e}")
                return None

        elif method == 'category':
            # Cut by category value
            if balance_column is None or balance_column not in df.columns:
                print("❌ Please specify a category column")
                return None

            # Get unique values
            unique_values = df[balance_column].unique()

            print(f"Available categories in '{balance_column}':")
            for i, val in enumerate(unique_values[:10], 1):
                print(f"  {i}. {val}")
            if len(unique_values) > 10:
                print(f"  ... and {len(unique_values) - 10} more")

            # Ask which category to extract
            category_value = input("\nEnter category value to extract: ").strip()

            # Try to convert if numeric
            if df[balance_column].dtype in ['int64', 'float64']:
                try:
                    category_value = float(category_value) if '.' in category_value else int(category_value)
                except:
                    pass

            # Filter
            category_df = df[df[balance_column] == category_value].copy()
            remainder_df = df[df[balance_column] != category_value].copy()

            results.append((f'category_{category_value}', category_df))
            results.append(('remainder', remainder_df))

        # Record history
        self.cut_history.append({
            'timestamp': datetime.now(),
            'method': method,
            'value': value,
            'strategy': strategy,
            'balance_column': balance_column,
            'original_rows': len(df),
            'output_pieces': len(results),
            'pieces': [(name, len(cut_df)) for name, cut_df in results]
        })

        # Show results
        print(f"\n Cut complete! Created {len(results)} pieces:")
        for name, cut_df in results:
            percentage = (len(cut_df) / len(df)) * 100
            print(f"  - {name}: {len(cut_df)} rows ({percentage:.1f}%)")

        return results

    def _balanced_sample(self, df, balance_column, n_rows):
        """Create a balanced sample with equal representation from each category"""

        # Get category distribution
        category_counts = df[balance_column].value_counts()

        # Calculate samples per category
        n_categories = len(category_counts)
        samples_per_category = n_rows // n_categories
        remainder = n_rows % n_categories

        sampled_indices = []

        for i, (category, count) in enumerate(category_counts.items()):
            # Get rows for this category
            category_rows = df[df[balance_column] == category]

            # Determine how many to sample from this category
            n_sample = samples_per_category
            if i < remainder:  # Distribute remainder
                n_sample += 1

            # Sample (with replacement if needed)
            if n_sample <= len(category_rows):
                sampled = category_rows.sample(n=n_sample, random_state=42)
            else:
                # Sample with replacement if not enough rows
                sampled = category_rows.sample(n=n_sample, replace=True, random_state=42)

            sampled_indices.extend(sampled.index)

        return df.loc[sampled_indices].copy()

    def cut_multiple_ways(self, df, dataset_name="dataset"):
        """Interactive menu for cutting datasets"""

        print("\n" + "="*60)
        print(f"DATASET CUTTER - {dataset_name}")
        print("="*60)
        print(f"Dataset: {len(df)} rows, {len(df.columns)} columns")

        while True:
            print("\nCut methods:")
            print("  ROW CUTTING (reduce rows):")
            print("  1. By percentage (e.g., take first 30%)")
            print("  2. By number of rows (e.g., take first 1000 rows)")
            print("  3. Split into equal parts (e.g., split into 5 parts)")
            print("  4. By date range (cut at a specific date)")
            print("  5. By category (extract specific category)")
            print("  6. Train/Test split (common for ML)")
            print("\n  COLUMN CUTTING (reduce columns):")
            print("  7. Select specific columns to keep")
            print("  8. Remove specific columns")
            print("  9. Keep columns by data type")
            print(" 10. Split dataset by columns (create multiple files with different column sets)")
            print("\n 11. Show cut history")
            print(" 12. Back to main menu")

            choice = input("\nYour choice (1-12): ").strip()

            if choice == '1':
                # Percentage cut
                self._handle_percentage_cut(df, dataset_name)
            elif choice == '2':
                # Rows cut
                self._handle_rows_cut(df, dataset_name)
            elif choice == '3':
                # Split into parts
                self._handle_parts_cut(df, dataset_name)
            elif choice == '4':
                # Date range cut
                self._handle_date_cut(df, dataset_name)
            elif choice == '5':
                # Category cut
                self._handle_category_cut(df, dataset_name)
            elif choice == '6':
                # Train/Test split
                self._handle_train_test_split(df, dataset_name)
            elif choice == '7':
                # Select specific columns
                self._handle_select_columns(df, dataset_name)
            elif choice == '8':
                # Remove specific columns
                self._handle_remove_columns(df, dataset_name)
            elif choice == '9':
                # Keep columns by data type
                self._handle_columns_by_type(df, dataset_name)
            elif choice == '10':
                # Split by columns
                self._handle_split_columns(df, dataset_name)
            elif choice == '11':
                # Show history
                self._show_cut_history()
            elif choice == '12':
                break
            else:
                print("❌ Invalid choice")

    def _handle_percentage_cut(self, df, dataset_name):
        """Handle percentage-based cutting"""
        try:
            percent = float(input("Enter percentage to cut (1-100): ").strip())

            print("\nSelect strategy:")
            print("  1. Sequential (take first N%)")
            print("  2. Random (random sample)")
            print("  3. Balanced (equal categories) - requires column")

            strat_choice = input("Your choice (1-3): ").strip()

            strategy = 'sequential'
            balance_col = None

            if strat_choice == '2':
                strategy = 'random'
            elif strat_choice == '3':
                strategy = 'balanced'
                # Show available columns
                print("\nAvailable columns:")
                for i, col in enumerate(df.columns[:10], 1):
                    if not col.startswith('_'):
                        print(f"  {i}. {col}")
                col_name = input("Enter column name for balancing: ").strip()
                if col_name in df.columns:
                    balance_col = col_name

            results = self.cut_dataset(df, method='percentage', value=percent,
                                      strategy=strategy, balance_column=balance_col,
                                      output_prefix=f"{dataset_name}_pct{percent}")

            if results:
                self._save_cut_results(results, dataset_name)

        except ValueError:
            print("❌ Please enter a valid number")

    def _handle_rows_cut(self, df, dataset_name):
        """Handle row-based cutting"""
        try:
            n_rows = int(input(f"Enter number of rows to cut (1-{len(df)}): ").strip())

            print("\nSelect strategy:")
            print("  1. Sequential (take first N rows)")
            print("  2. Random (random sample)")
            print("  3. Balanced (equal categories) - requires column")

            strat_choice = input("Your choice (1-3): ").strip()

            strategy = 'sequential'
            balance_col = None

            if strat_choice == '2':
                strategy = 'random'
            elif strat_choice == '3':
                strategy = 'balanced'
                print("\nAvailable columns:")
                for i, col in enumerate(df.columns[:10], 1):
                    if not col.startswith('_'):
                        print(f"  {i}. {col}")
                col_name = input("Enter column name for balancing: ").strip()
                if col_name in df.columns:
                    balance_col = col_name

            results = self.cut_dataset(df, method='rows', value=n_rows,
                                      strategy=strategy, balance_column=balance_col,
                                      output_prefix=f"{dataset_name}_rows{n_rows}")

            if results:
                self._save_cut_results(results, dataset_name)

        except ValueError:
            print("❌ Please enter a valid number")

    def _handle_parts_cut(self, df, dataset_name):
        """Handle splitting into equal parts"""
        try:
            n_parts = int(input("Enter number of parts to split into: ").strip())

            print("\nSelect strategy:")
            print("  1. Sequential (split in order)")
            print("  2. Random (shuffle then split)")

            strat_choice = input("Your choice (1-2): ").strip()

            strategy = 'sequential' if strat_choice == '1' else 'random'

            results = self.cut_dataset(df, method='parts', value=n_parts,
                                      strategy=strategy,
                                      output_prefix=f"{dataset_name}_parts{n_parts}")

            if results:
                self._save_cut_results(results, dataset_name)

        except ValueError:
            print("❌ Please enter a valid number")

    def _handle_date_cut(self, df, dataset_name):
        """Handle date-based cutting"""
        # Find date columns
        date_cols = []
        for col in df.columns:
            if any(keyword in col.lower() for keyword in ['date', 'time', 'timestamp', 'pubdate', 'published']):
                date_cols.append(col)

        print("\nAvailable date columns:")
        if date_cols:
            for i, col in enumerate(date_cols, 1):
                print(f"  {i}. {col}")
        else:
            print("  No obvious date columns found.")

        print("\nAll columns:")
        for i, col in enumerate(df.columns[:15], 1):
            print(f"  {i}. {col}")
        if len(df.columns) > 15:
            print(f"  ... and {len(df.columns) - 15} more")

        date_col = input("\nEnter date column name: ").strip()

        if date_col in df.columns:
            try:
                # Show date range
                dates = pd.to_datetime(df[date_col], errors='coerce')
                # Handle timezone
                if hasattr(dates, 'dt') and hasattr(dates.dt, 'tz') and dates.dt.tz is not None:
                    dates = dates.dt.tz_localize(None)

                valid_dates = dates.dropna()
                if len(valid_dates) > 0:
                    print(f"\nDate range in data:")
                    print(f"  From: {valid_dates.min()}")
                    print(f"  To: {valid_dates.max()}")

                    percent = float(input("Cut at what percentage of date range? (e.g., 50 for middle): ").strip())
                    results = self.cut_dataset(df, method='date_range', value=percent,
                                              balance_column=date_col,
                                              output_prefix=f"{dataset_name}_datecut")

                    if results:
                        self._save_cut_results(results, dataset_name)
                else:
                    print("❌ Could not parse dates in this column")

            except ValueError:
                print("❌ Please enter a valid number")
            except Exception as e:
                print(f"❌ Error: {e}")
        else:
            print("❌ Column not found")

    def _handle_category_cut(self, df, dataset_name):
        """Handle category-based cutting"""
        print("\nAvailable columns for categorization:")
        cat_cols = []
        for i, col in enumerate(df.columns[:15], 1):
            unique_count = df[col].nunique()
            if unique_count < 50:  # Good for categories
                print(f"  {i}. {col} ({unique_count} unique values)")
                cat_cols.append(col)
        if len(df.columns) > 15:
            print(f"  ... and {len(df.columns) - 15} more columns")

        cat_col = input("\nEnter column name to cut by: ").strip()

        if cat_col in df.columns:
            # Show unique values
            unique_vals = df[cat_col].dropna().unique()[:20]
            print(f"\nSample values in '{cat_col}':")
            for i, val in enumerate(unique_vals, 1):
                count = (df[cat_col] == val).sum()
                print(f"  {i}. {val} ({count} rows)")
            if len(df[cat_col].unique()) > 20:
                print(f"  ... and {len(df[cat_col].unique()) - 20} more values")

            results = self.cut_dataset(df, method='category',
                                      balance_column=cat_col,
                                      output_prefix=f"{dataset_name}_category")

            if results:
                self._save_cut_results(results, dataset_name)
        else:
            print("❌ Column not found")

    def _handle_train_test_split(self, df, dataset_name):
        """Handle train/test split"""
        print("\n TRAIN/TEST SPLIT")
        print("-" * 40)

        try:
            # Get split ratio
            ratio = float(input("Enter test size (as decimal, e.g., 0.2 for 20% test): ").strip())

            if ratio <= 0 or ratio >= 1:
                print("❌ Ratio must be between 0 and 1")
                return

            # Get stratification option
            stratify = input("Stratify by column? (y/n): ").strip().lower()

            if stratify == 'y':
                print("\nAvailable columns for stratification:")
                for i, col in enumerate(df.columns[:10], 1):
                    if df[col].nunique() < 20:
                        print(f"  {i}. {col} ({df[col].nunique()} unique values)")

                strat_col = input("Enter column name: ").strip()
                if strat_col not in df.columns:
                    print("❌ Column not found. Using random split.")
                    strat_col = None
            else:
                strat_col = None

            # Perform split
            try:
                from sklearn.model_selection import train_test_split

                if strat_col:
                    train_df, test_df = train_test_split(
                        df, test_size=ratio, random_state=42,
                        stratify=df[strat_col]
                    )
                    print(f"\n Stratified split by '{strat_col}'")
                else:
                    train_df, test_df = train_test_split(
                        df, test_size=ratio, random_state=42
                    )
                    print(f"\n Random split")

                # Show results
                print(f"\n Split complete!")
                print(f"  Train set: {len(train_df)} rows ({len(train_df)/len(df)*100:.1f}%)")
                print(f"  Test set: {len(test_df)} rows ({len(test_df)/len(df)*100:.1f}%)")

                # Save
                timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')

                train_file = os.path.join('data/cut', f'{dataset_name}_train_{timestamp}.csv')
                test_file = os.path.join('data/cut', f'{dataset_name}_test_{timestamp}.csv')

                train_df.to_csv(train_file, index=False)
                test_df.to_csv(test_file, index=False)

                print(f"\n Saved:")
                print(f"  Train: {train_file}")
                print(f"  Test: {test_file}")

            except ImportError:
                print("\n⚠ sklearn not installed. Using simple random split.")
                # Simple random split without sklearn
                mask = np.random.rand(len(df)) < (1 - ratio)
                train_df = df[mask].copy()
                test_df = df[~mask].copy()

                timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
                train_file = os.path.join('data/cut', f'{dataset_name}_train_simple_{timestamp}.csv')
                test_file = os.path.join('data/cut', f'{dataset_name}_test_simple_{timestamp}.csv')

                train_df.to_csv(train_file, index=False)
                test_df.to_csv(test_file, index=False)

                print(f"\n Saved simple split:")
                print(f"  Train: {train_file} ({len(train_df)} rows)")
                print(f"  Test: {test_file} ({len(test_df)} rows)")

        except ValueError:
            print("❌ Please enter a valid number")
        except Exception as e:
            print(f"❌ Error: {e}")

    def _handle_select_columns(self, df, dataset_name):
        """Select specific columns to keep"""
        print("\n" + "="*50)
        print("SELECT COLUMNS TO KEEP")
        print("="*50)

        print(f"\nDataset has {len(df.columns)} columns:")
        for i, col in enumerate(df.columns, 1):
            dtype = df[col].dtype
            sample = str(df[col].iloc[0])[:30] + "..." if len(str(df[col].iloc[0])) > 30 else str(df[col].iloc[0])
            print(f"  {i:2d}. {col:30s} ({dtype}) - e.g., {sample}")

        print("\nOptions:")
        print("  - Enter column numbers separated by commas (e.g., 1,3,5-8)")
        print("  - Enter column names separated by commas")
        print("  - Enter 'all' to select all columns")
        print("  - Enter 'text' to select only text/object columns")
        print("  - Enter 'numeric' to select only numeric columns")
        print("  - Enter 'date' to select only date columns")
        print("  - Enter 'b' to go back")

        choice = input("\nYour selection: ").strip()

        if choice.lower() == 'b':
            return

        selected_cols = []

        if choice.lower() == 'all':
            selected_cols = list(df.columns)
        elif choice.lower() == 'text':
            selected_cols = [col for col in df.columns if df[col].dtype == 'object']
        elif choice.lower() == 'numeric':
            selected_cols = [col for col in df.columns if pd.api.types.is_numeric_dtype(df[col])]
        elif choice.lower() == 'date':
            # Try to detect date columns
            date_cols = []
            for col in df.columns:
                if df[col].dtype == 'object':
                    try:
                        if pd.to_datetime(df[col], errors='coerce').notna().any():
                            date_cols.append(col)
                    except:
                        pass
            selected_cols = date_cols
        else:
            # Parse comma-separated list
            parts = choice.split(',')
            for part in parts:
                part = part.strip()
                if '-' in part:
                    # Handle range (e.g., 5-10)
                    try:
                        start, end = map(int, part.split('-'))
                        for i in range(start, min(end + 1, len(df.columns) + 1)):
                            if 1 <= i <= len(df.columns):
                                selected_cols.append(df.columns[i-1])
                    except:
                        print(f"  Invalid range: {part}")
                elif part.isdigit():
                    # Single number
                    idx = int(part)
                    if 1 <= idx <= len(df.columns):
                        selected_cols.append(df.columns[idx-1])
                    else:
                        print(f"  Invalid number: {part}")
                elif part in df.columns:
                    # Column name
                    selected_cols.append(part)
                else:
                    print(f"  Invalid column: {part}")

        # Remove duplicates while preserving order
        selected_cols = list(dict.fromkeys(selected_cols))

        if not selected_cols:
            print("❌ No valid columns selected")
            return

        print(f"\nSelected {len(selected_cols)} columns:")
        for i, col in enumerate(selected_cols, 1):
            print(f"  {i}. {col}")

        confirm = input("\nCreate dataset with these columns? (y/n): ").strip().lower()
        if confirm == 'y':
            new_df = df[selected_cols].copy()

            # Save the result
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            filename = f"{dataset_name}_selected_cols_{timestamp}.csv"
            filepath = os.path.join('data/cut', filename)

            new_df.to_csv(filepath, index=False)
            print(f"\n✓ Saved selected columns to: {filepath}")
            print(f"  New shape: {new_df.shape}")

            # Record in history
            self.cut_history.append({
                'timestamp': datetime.now(),
                'method': 'select_columns',
                'original_columns': len(df.columns),
                'selected_columns': len(selected_cols),
                'dataset': dataset_name
            })

    def _handle_remove_columns(self, df, dataset_name):
        """Remove specific columns"""
        print("\n" + "="*50)
        print("REMOVE COLUMNS")
        print("="*50)

        print(f"\nDataset has {len(df.columns)} columns. Select columns to REMOVE:")
        for i, col in enumerate(df.columns, 1):
            dtype = df[col].dtype
            print(f"  {i:2d}. {col:30s} ({dtype})")

        print("\nOptions:")
        print("  - Enter column numbers to remove (e.g., 1,3,5-8)")
        print("  - Enter column names to remove")
        print("  - Enter 'temporary' to remove temporary/internal columns (_source, _temporal_priority, etc.)")
        print("  - Enter 'empty' to remove columns with >50% missing values")
        print("  - Enter 'constant' to remove constant columns (same value in all rows)")
        print("  - Enter 'b' to go back")

        choice = input("\nColumns to remove: ").strip()

        if choice.lower() == 'b':
            return

        cols_to_remove = []

        if choice.lower() == 'temporary':
            # Remove columns starting with underscore
            cols_to_remove = [col for col in df.columns if col.startswith('_')]
            print(f"  Found {len(cols_to_remove)} temporary columns: {', '.join(cols_to_remove)}")
        elif choice.lower() == 'empty':
            # Remove columns with >50% missing values
            for col in df.columns:
                missing_pct = df[col].isna().sum() / len(df) * 100
                if missing_pct > 50:
                    cols_to_remove.append(col)
                    print(f"  Column '{col}' has {missing_pct:.1f}% missing values")
        elif choice.lower() == 'constant':
            # Remove constant columns
            for col in df.columns:
                if df[col].nunique() <= 1:
                    cols_to_remove.append(col)
                    print(f"  Column '{col}' is constant (only one value)")
        else:
            # Parse comma-separated list
            parts = choice.split(',')
            for part in parts:
                part = part.strip()
                if '-' in part:
                    # Handle range (e.g., 5-10)
                    try:
                        start, end = map(int, part.split('-'))
                        for i in range(start, min(end + 1, len(df.columns) + 1)):
                            if 1 <= i <= len(df.columns):
                                cols_to_remove.append(df.columns[i-1])
                    except:
                        print(f"  Invalid range: {part}")
                elif part.isdigit():
                    # Single number
                    idx = int(part)
                    if 1 <= idx <= len(df.columns):
                        cols_to_remove.append(df.columns[idx-1])
                    else:
                        print(f"  Invalid number: {part}")
                elif part in df.columns:
                    # Column name
                    cols_to_remove.append(part)
                else:
                    print(f"  Invalid column: {part}")

        # Remove duplicates
        cols_to_remove = list(dict.fromkeys(cols_to_remove))

        if not cols_to_remove:
            print("❌ No valid columns selected for removal")
            return

        print(f"\nColumns to REMOVE ({len(cols_to_remove)}):")
        for col in cols_to_remove:
            print(f"  - {col}")

        confirm = input("\nRemove these columns? (y/n): ").strip().lower()
        if confirm == 'y':
            cols_to_keep = [col for col in df.columns if col not in cols_to_remove]
            new_df = df[cols_to_keep].copy()

            # Save the result
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            filename = f"{dataset_name}_removed_cols_{timestamp}.csv"
            filepath = os.path.join('data/cut', filename)

            new_df.to_csv(filepath, index=False)
            print(f"\n✓ Saved dataset with columns removed to: {filepath}")
            print(f"  Original columns: {len(df.columns)}")
            print(f"  Removed columns: {len(cols_to_remove)}")
            print(f"  New columns: {len(new_df.columns)}")
            print(f"  New shape: {new_df.shape}")

            # Record in history
            self.cut_history.append({
                'timestamp': datetime.now(),
                'method': 'remove_columns',
                'original_columns': len(df.columns),
                'removed_columns': len(cols_to_remove),
                'dataset': dataset_name
            })

    def _handle_columns_by_type(self, df, dataset_name):
        """Keep columns by data type"""
        print("\n" + "="*50)
        print("KEEP COLUMNS BY DATA TYPE")
        print("="*50)

        # Count columns by type
        numeric_cols = [col for col in df.columns if pd.api.types.is_numeric_dtype(df[col])]
        text_cols = [col for col in df.columns if df[col].dtype == 'object']

        # Try to detect date columns
        date_cols = []
        for col in text_cols[:]:  # Check text columns for dates
            try:
                if pd.to_datetime(df[col], errors='coerce').notna().any():
                    date_cols.append(col)
                    text_cols.remove(col)  # Remove from text if it's a date
            except:
                pass

        bool_cols = [col for col in df.columns if df[col].dtype == 'bool']
        other_cols = [col for col in df.columns if col not in numeric_cols + text_cols + date_cols + bool_cols]

        print(f"\nColumn type summary:")
        print(f"  Numeric columns: {len(numeric_cols)}")
        print(f"  Date columns: {len(date_cols)}")
        print(f"  Text columns: {len(text_cols)}")
        print(f"  Boolean columns: {len(bool_cols)}")
        print(f"  Other columns: {len(other_cols)}")

        print("\nOptions:")
        print("  1. Keep only numeric columns")
        print("  2. Keep only text columns")
        print("  3. Keep only date columns")
        print("  4. Keep only boolean columns")
        print("  5. Keep multiple types (custom selection)")
        print("  6. Back")

        type_choice = input("\nYour choice (1-6): ").strip()

        selected_cols = []

        if type_choice == '1':
            selected_cols = numeric_cols
            type_name = "numeric"
        elif type_choice == '2':
            selected_cols = text_cols
            type_name = "text"
        elif type_choice == '3':
            selected_cols = date_cols
            type_name = "date"
        elif type_choice == '4':
            selected_cols = bool_cols
            type_name = "boolean"
        elif type_choice == '5':
            # Custom multiple selection
            print("\nSelect types to keep (comma-separated):")
            print("  n - Numeric columns")
            print("  d - Date columns")
            print("  t - Text columns")
            print("  b - Boolean columns")

            type_selection = input("Enter types (e.g., n,d,t): ").strip().lower()

            selected_cols = []
            if 'n' in type_selection:
                selected_cols.extend(numeric_cols)
            if 'd' in type_selection:
                selected_cols.extend(date_cols)
            if 't' in type_selection:
                selected_cols.extend(text_cols)
            if 'b' in type_selection:
                selected_cols.extend(bool_cols)

            type_name = "custom"
        else:
            return

        if not selected_cols:
            print("❌ No columns of selected type found")
            return

        print(f"\nSelected {len(selected_cols)} columns:")
        for i, col in enumerate(selected_cols[:10], 1):
            print(f"  {i}. {col}")
        if len(selected_cols) > 10:
            print(f"  ... and {len(selected_cols) - 10} more")

        confirm = input(f"\nCreate dataset with only {type_name} columns? (y/n): ").strip().lower()
        if confirm == 'y':
            new_df = df[selected_cols].copy()

            # Save the result
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            filename = f"{dataset_name}_{type_name}_only_{timestamp}.csv"
            filepath = os.path.join('data/cut', filename)

            new_df.to_csv(filepath, index=False)
            print(f"\n✓ Saved {type_name}-only dataset to: {filepath}")
            print(f"  New shape: {new_df.shape}")

            # Record in history
            self.cut_history.append({
                'timestamp': datetime.now(),
                'method': f'keep_{type_name}_only',
                'original_columns': len(df.columns),
                'kept_columns': len(selected_cols),
                'dataset': dataset_name
            })

    def _handle_split_columns(self, df, dataset_name):
        """Split dataset into multiple files by column groups"""
        print("\n" + "="*50)
        print("SPLIT DATASET BY COLUMNS")
        print("="*50)

        print("\nThis will create multiple CSV files, each with different column sets.")
        print("For example, you can separate metadata columns from content columns.")

        # Show all columns with indices
        print(f"\nDataset columns ({len(df.columns)} total):")
        for i, col in enumerate(df.columns, 1):
            print(f"  {i:2d}. {col}")

        print("\nHow many column groups do you want to create?")
        n_groups = input("Enter number of groups (2-5): ").strip()

        try:
            n_groups = int(n_groups)
            if n_groups < 2 or n_groups > 5:
                print("❌ Number of groups must be between 2 and 5")
                return
        except:
            print("❌ Please enter a valid number")
            return

        groups = []
        remaining_cols = list(df.columns)

        for group_num in range(1, n_groups + 1):
            if group_num == n_groups:
                # Last group gets all remaining columns
                group_cols = remaining_cols.copy()
            else:
                print(f"\nGroup {group_num} - Select columns for this group:")
                print("  Enter column numbers or names (comma-separated)")
                print("  Or enter 'auto' for automatic splitting")

                choice = input(f"Group {group_num} columns: ").strip()

                if choice.lower() == 'auto':
                    # Automatic split - distribute evenly
                    cols_per_group = len(df.columns) // n_groups
                    start_idx = (group_num - 1) * cols_per_group
                    end_idx = start_idx + cols_per_group if group_num < n_groups else len(df.columns)
                    group_cols = list(df.columns)[start_idx:end_idx]
                else:
                    # Parse user selection
                    group_cols = []
                    parts = choice.split(',')
                    for part in parts:
                        part = part.strip()
                        if part.isdigit():
                            idx = int(part) - 1
                            if 0 <= idx < len(df.columns):
                                col = df.columns[idx]
                                if col in remaining_cols:
                                    group_cols.append(col)
                                else:
                                    print(f"  Warning: Column '{col}' already assigned to another group")
                            else:
                                print(f"  Invalid number: {part}")
                        elif part in df.columns:
                            if part in remaining_cols:
                                group_cols.append(part)
                            else:
                                print(f"  Warning: Column '{part}' already assigned to another group")
                        else:
                            print(f"  Invalid column: {part}")

                # Remove selected columns from remaining
                for col in group_cols:
                    if col in remaining_cols:
                        remaining_cols.remove(col)

            groups.append(group_cols)

        # Show groups
        print("\n" + "="*50)
        print("COLUMN GROUPS:")
        print("="*50)
        for i, group_cols in enumerate(groups, 1):
            print(f"\nGroup {i} ({len(group_cols)} columns):")
            for col in group_cols[:5]:
                print(f"  - {col}")
            if len(group_cols) > 5:
                print(f"  ... and {len(group_cols) - 5} more")

        confirm = input("\nCreate these column groups? (y/n): ").strip().lower()
        if confirm == 'y':
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')

            for i, group_cols in enumerate(groups, 1):
                if group_cols:  # Only create if non-empty
                    group_df = df[group_cols].copy()
                    filename = f"{dataset_name}_group{i}_{timestamp}.csv"
                    filepath = os.path.join('data/cut', filename)
                    group_df.to_csv(filepath, index=False)
                    print(f"  ✓ Group {i}: {filepath} ({len(group_cols)} columns, {len(group_df)} rows)")

            # Also save a metadata file
            metadata = {
                'timestamp': timestamp,
                'dataset': dataset_name,
                'n_groups': len(groups),
                'groups': [
                    {
                        'group': i+1,
                        'columns': group_cols,
                        'n_columns': len(group_cols)
                    }
                    for i, group_cols in enumerate(groups) if group_cols
                ]
            }

            meta_file = os.path.join('data/cut', f'{dataset_name}_column_split_{timestamp}.json')
            with open(meta_file, 'w') as f:
                json.dump(metadata, f, indent=2, default=str)

            print(f"\n Metadata saved to {meta_file}")

            # Record in history
            self.cut_history.append({
                'timestamp': datetime.now(),
                'method': 'split_columns',
                'original_columns': len(df.columns),
                'n_groups': len([g for g in groups if g]),
                'dataset': dataset_name
            })

    def _save_cut_results(self, results, dataset_name):
        """Save cut results to files"""

        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')

        print("\n Saving cut pieces:")
        for name, cut_df in results:
            # Create filename
            filename = f"{dataset_name}_{name}_{timestamp}.csv"
            filepath = os.path.join('data/cut', filename)

            # Save
            cut_df.to_csv(filepath, index=False)
            print(f"  ✓ Saved {name}: {filepath} ({len(cut_df)} rows)")

        # Also save a metadata file
        metadata = {
            'timestamp': timestamp,
            'dataset': dataset_name,
            'original_rows': sum(len(df) for _, df in results),
            'pieces': [
                {
                    'name': name,
                    'rows': len(df),
                    'columns': list(df.columns)
                }
                for name, df in results
            ]
        }

        meta_file = os.path.join('data/cut', f'{dataset_name}_metadata_{timestamp}.json')
        with open(meta_file, 'w') as f:
            json.dump(metadata, f, indent=2, default=str)

        print(f"\n Metadata saved to {meta_file}")

    def _show_cut_history(self):
        """Show history of cut operations"""

        if not self.cut_history:
            print("\n No cut operations performed yet.")
            return

        print("\n CUT HISTORY")
        print("-" * 40)

        for i, record in enumerate(self.cut_history, 1):
            print(f"\n{i}. {record['timestamp'].strftime('%Y-%m-%d %H:%M:%S')}")
            print(f"   Method: {record['method']} ({record.get('value', 'N/A')})")
            print(f"   Dataset: {record.get('dataset', 'Unknown')}")
            if 'original_rows' in record:
                print(f"   Original rows: {record['original_rows']}")
            if 'original_columns' in record:
                print(f"   Original columns: {record['original_columns']}")
            if 'output_pieces' in record:
                print(f"   Output pieces: {record['output_pieces']}")

# ============================================================
# 4. DATASET MERGER (FIXED - NO AUTO COLUMNS)
# ============================================================

class DatasetMerger:
    """Merge multiple datasets with user-friendly options"""

    def __init__(self):
        self.datasets = []
        self.merge_history = []

    def add_dataset(self, name, dataframe):
        """Add a dataset to the merger WITHOUT adding automatic columns"""
        if dataframe is None or dataframe.empty:
            print(f"❌ Cannot add empty dataset: {name}")
            return False

        # Store the dataset as-is, without adding any columns
        self.datasets.append({
            'name': name,
            'data': dataframe.copy(),  # Use copy to avoid reference issues
            'rows': len(dataframe),
            'columns': len(dataframe.columns)
        })

        print(f"✓ Added dataset '{name}' with {len(dataframe)} rows")
        return True

    def show_dataset_info(self):
        """Show information about loaded datasets"""
        if not self.datasets:
            print("\n📭 No datasets loaded yet.")
            return

        print(f"\n Loaded Datasets ({len(self.datasets)}):")
        print("-" * 50)
        for i, ds in enumerate(self.datasets, 1):
            print(f"{i}. {ds['name']}")
            print(f"   Rows: {ds['rows']:,}, Columns: {ds['columns']}")

            # Show sample columns (first 5)
            columns = list(ds['data'].columns)
            sample_cols = columns[:5] if len(columns) > 5 else columns
            print(f"   Columns: {', '.join(sample_cols)}")
            if len(columns) > 5:
                print(f"   ... and {len(columns) - 5} more")
            print()

    def find_matching_columns(self):
        """Find columns that appear in multiple datasets"""
        if len(self.datasets) < 2:
            return {}

        all_columns = {}
        for ds in self.datasets:
            for col in ds['data'].columns:
                if col not in all_columns:
                    all_columns[col] = []
                all_columns[col].append(ds['name'])

        # Find columns in multiple datasets
        common_columns = {col: datasets for col, datasets in all_columns.items()
                         if len(datasets) > 1}

        if common_columns:
            print("\n Common columns found across datasets:")
            for col, datasets in common_columns.items():
                print(f"  '{col}' → in {len(datasets)} datasets: {', '.join(datasets)}")

        return common_columns

    def merge_datasets(self, merge_type='smart'):
        """
        Merge datasets with different strategies
        Options: 'smart', 'vertical', 'horizontal', 'custom'
        """
        if len(self.datasets) < 2:
            print("❌ Need at least 2 datasets to merge.")
            return None

        print(f"\n Merging {len(self.datasets)} datasets ({merge_type} merge)...")

        if merge_type == 'vertical':
            result = self._vertical_merge()
        elif merge_type == 'horizontal':
            result = self._horizontal_merge()
        elif merge_type == 'smart':
            result = self._smart_merge()
        else:
            result = self._custom_merge()

        if result is not None:
            # Record merge history
            self.merge_history.append({
                'timestamp': datetime.now(),
                'datasets': [ds['name'] for ds in self.datasets],
                'merge_type': merge_type,
                'result_shape': result.shape,
                'rows_before': sum(ds['rows'] for ds in self.datasets),
                'rows_after': len(result)
            })

            print(f"\n Merge complete!")
            print(f"   Before: {self.merge_history[-1]['rows_before']:,} total rows")
            print(f"   After: {len(result):,} rows, {len(result.columns)} columns")
            print(f"   Removed {self.merge_history[-1]['rows_before'] - len(result):,} duplicate rows")

        return result

    def _vertical_merge(self):
        """Simple vertical concatenation with source tracking"""
        # Add source column only during merge, not when adding datasets
        all_data = []
        for ds in self.datasets:
            df_with_source = ds['data'].copy()
            df_with_source['_source'] = ds['name']  # Add source column only during merge
            all_data.append(df_with_source)

        return pd.concat(all_data, ignore_index=True)

    def _horizontal_merge(self):
        """Horizontal merge based on common key"""
        print("\nFor horizontal merge, we need a common key column.")
        print("Available columns across all datasets:")

        # Show all columns
        all_columns = set()
        for ds in self.datasets:
            all_columns.update(ds['data'].columns)

        for i, col in enumerate(sorted(all_columns), 1):
            print(f"  {i}. {col}")

        key_col = input("\nEnter the column name to merge on: ").strip()

        # Check if key exists in all datasets
        missing_in = []
        for ds in self.datasets:
            if key_col not in ds['data'].columns:
                missing_in.append(ds['name'])

        if missing_in:
            print(f"❌ Column '{key_col}' missing in: {', '.join(missing_in)}")
            return None

        # Start with first dataset
        merged = self.datasets[0]['data'].copy()

        # Merge with others
        for ds in self.datasets[1:]:
            merged = pd.merge(merged, ds['data'], on=key_col, how='outer', suffixes=('', f"_{ds['name']}"))

        return merged

    def _smart_merge(self):
        """Smart merge with automatic duplicate handling"""
        print("\n Smart merge activated!")
        print("This will:")
        print("  1. Remove exact duplicate rows")
        print("  2. Handle overlapping data")
        print("  3. Add source tracking")

        # First do vertical merge with source tracking
        merged = self._vertical_merge()

        # Remove exact duplicates
        before = len(merged)
        merged = merged.drop_duplicates()
        exact_dups = before - len(merged)

        if exact_dups > 0:
            print(f"  Removed {exact_dups} exact duplicate rows")

        # Find near duplicates based on key columns
        key_candidates = []
        for col in merged.columns:
            if col != '_source' and any(keyword in col.lower() for keyword in ['id', 'code', 'key', 'name', 'email', 'title', 'headline']):
                if merged[col].notna().sum() > 0:
                    key_candidates.append(col)

        if key_candidates:
            print(f"\nFound potential key columns: {key_candidates[:5]}...")

            # Ask user to select key columns
            print("\nSelect columns for duplicate detection (comma-separated):")
            for i, col in enumerate(key_candidates[:10], 1):
                print(f"  {i}. {col}")
            if len(key_candidates) > 10:
                print(f"  ... and {len(key_candidates) - 10} more")

            selection = input("\nEnter column numbers or names (or press Enter to skip): ").strip()

            if selection:
                try:
                    # Parse selection
                    selected_cols = []
                    for item in selection.split(','):
                        item = item.strip()
                        if item.isdigit():
                            idx = int(item) - 1
                            if 0 <= idx < len(key_candidates):
                                selected_cols.append(key_candidates[idx])
                        else:
                            if item in merged.columns:
                                selected_cols.append(item)

                    if selected_cols:
                        # For near duplicates, keep the first occurrence
                        before_near = len(merged)
                        merged = merged.drop_duplicates(subset=selected_cols, keep='first')
                        near_dups = before_near - len(merged)
                        print(f"✓ Removed {near_dups} near-duplicates based on: {selected_cols}")
                except Exception as e:
                    print(f"❌ Error processing selection: {e}")

        return merged

    def _custom_merge(self):
        """Custom merge with user options"""
        print("\n  Custom merge options:")

        merge_options = {
            '1': ('Concatenate all with source tracking', self._vertical_merge),
            '2': ('Merge on common key', self._horizontal_merge),
            '3': ('Smart merge (recommended)', self._smart_merge),
            '4': ('Inner join (common columns only)', self._inner_merge)
        }

        for key, (desc, _) in merge_options.items():
            print(f"  {key}. {desc}")

        choice = input("\nChoose merge type (1-4): ").strip()

        if choice in merge_options:
            return merge_options[choice][1]()
        else:
            print("❌ Invalid choice. Using smart merge.")
            return self._smart_merge()

    def _inner_merge(self):
        """Inner join on common columns"""
        common_cols = None
        for ds in self.datasets:
            if common_cols is None:
                common_cols = set(ds['data'].columns)
            else:
                common_cols = common_cols.intersection(set(ds['data'].columns))

        if not common_cols:
            print("❌ No common columns found for inner join.")
            return None

        print(f"\nCommon columns: {', '.join(common_cols)}")

        # Start with first dataset
        merged = self.datasets[0]['data'][list(common_cols)].copy()
        merged['_source'] = self.datasets[0]['name']

        # Merge with others
        for i, ds in enumerate(self.datasets[1:], 1):
            temp_df = ds['data'][list(common_cols)].copy()
            temp_df['_source'] = ds['name']
            merged = pd.merge(merged, temp_df, on=list(common_cols), how='inner')

        return merged

    def get_dataset_by_name(self, name):
        """Get a dataset by its name"""
        for ds in self.datasets:
            if ds['name'] == name:
                return ds['data'].copy()
        return None

    def update_dataset(self, name, new_data):
        """Update a dataset with new data"""
        for ds in self.datasets:
            if ds['name'] == name:
                ds['data'] = new_data.copy()
                ds['rows'] = len(new_data)
                ds['columns'] = len(new_data.columns)
                return True
        return False

    def remove_dataset(self, name):
        """Remove a dataset by name"""
        for i, ds in enumerate(self.datasets):
            if ds['name'] == name:
                removed = self.datasets.pop(i)
                print(f" Removed dataset: {removed['name']}")
                return True
        return False

# ============================================================
# 5. DATA CLEANER
# ============================================================

class DataCleaner:
    """Clean and fix data issues"""

    def __init__(self):
        self.problems_found = []
        self.fixes_applied = []

    def analyze_dataset(self, df):
        """Analyze dataset for common problems"""
        print(f"\n Analyzing dataset ({len(df)} rows, {len(df.columns)} columns)...")

        problems = []

        # 1. Check for missing values
        missing_counts = df.isnull().sum()
        missing_cols = missing_counts[missing_counts > 0]

        if len(missing_cols) > 0:
            problem = {
                'type': 'missing_values',
                'count': int(missing_counts.sum()),
                'columns': list(missing_cols.index),
                'severity': 'medium'
            }
            problems.append(problem)
            print(f"  Missing values: {missing_counts.sum()} total")

        # 2. Check data types
        dtype_problems = []
        for col in df.columns:
            if df[col].dtype == 'object':
                # Try to convert to numeric or datetime
                numeric_test = pd.to_numeric(df[col], errors='coerce')
                date_test = pd.to_datetime(df[col], errors='coerce')

                if numeric_test.notna().any() or date_test.notna().any():
                    dtype_problems.append(col)

        if dtype_problems:
            problem = {
                'type': 'mixed_data_types',
                'columns': dtype_problems,
                'severity': 'low'
            }
            problems.append(problem)
            print(f"  Mixed data types in: {dtype_problems[:3]}...")

        # 3. Check for duplicates
        exact_dups = df.duplicated().sum()
        if exact_dups > 0:
            problem = {
                'type': 'exact_duplicates',
                'count': int(exact_dups),
                'severity': 'high'
            }
            problems.append(problem)
            print(f"  Exact duplicates: {exact_dups} rows")

        # 4. Check numeric columns for outliers
        numeric_cols = df.select_dtypes(include=[np.number]).columns
        outlier_problems = []

        for col in numeric_cols:
            if df[col].notna().sum() > 0:
                Q1 = df[col].quantile(0.25)
                Q3 = df[col].quantile(0.75)
                IQR = Q3 - Q1
                outliers = ((df[col] < (Q1 - 1.5 * IQR)) | (df[col] > (Q3 + 1.5 * IQR))).sum()

                if outliers > 0:
                    outlier_problems.append({
                        'column': col,
                        'outliers': int(outliers),
                        'percent': (outliers / len(df)) * 100
                    })

        if outlier_problems:
            problem = {
                'type': 'outliers',
                'details': outlier_problems,
                'severity': 'low'
            }
            problems.append(problem)
            print(f"  Outliers found in {len(outlier_problems)} columns")

        # 5. Check for logical errors
        logical_problems = self._check_logical_errors(df)
        problems.extend(logical_problems)

        self.problems_found = problems

        if not problems:
            print(" No major problems found!")
        else:
            print(f"\n Summary: Found {len(problems)} types of problems")

        return problems

    def _check_logical_errors(self, df):
        """Check for logical errors in data"""
        problems = []

        # Check date columns
        date_columns = [col for col in df.columns
                       if any(keyword in col.lower() for keyword in ['date', 'time', 'timestamp'])]

        for col in date_columns:
            try:
                dates = pd.to_datetime(df[col], errors='coerce')
                # Handle timezone
                if hasattr(dates, 'dt') and hasattr(dates.dt, 'tz') and dates.dt.tz is not None:
                    dates = dates.dt.tz_localize(None)

                # Check for future dates
                current_time = datetime.now()
                future_dates = dates > pd.Timestamp(current_time)
                if future_dates.any():
                    problems.append({
                        'type': 'future_dates',
                        'column': col,
                        'count': int(future_dates.sum()),
                        'severity': 'medium'
                    })
            except:
                pass

        # Check for negative values in positive columns
        positive_columns = [col for col in df.columns
                          if any(keyword in col.lower() for keyword in ['age', 'salary', 'price', 'amount', 'quantity'])]

        for col in positive_columns:
            if col in df.columns and pd.api.types.is_numeric_dtype(df[col]):
                negative_values = df[col] < 0
                if negative_values.any():
                    problems.append({
                        'type': 'negative_values',
                        'column': col,
                        'count': int(negative_values.sum()),
                        'severity': 'high'
                    })

        # Check for start > end dates
        start_cols = [col for col in date_columns if 'start' in col.lower() or 'begin' in col.lower()]
        end_cols = [col for col in date_columns if 'end' in col.lower() or 'finish' in col.lower()]

        for start_col in start_cols:
            for end_col in end_cols:
                if start_col != end_col and start_col in df.columns and end_col in df.columns:
                    try:
                        start_dates = pd.to_datetime(df[start_col], errors='coerce')
                        end_dates = pd.to_datetime(df[end_col], errors='coerce')
                        # Handle timezone
                        if hasattr(start_dates, 'dt') and hasattr(start_dates.dt, 'tz') and start_dates.dt.tz is not None:
                            start_dates = start_dates.dt.tz_localize(None)
                        if hasattr(end_dates, 'dt') and hasattr(end_dates.dt, 'tz') and end_dates.dt.tz is not None:
                            end_dates = end_dates.dt.tz_localize(None)

                        invalid = start_dates > end_dates
                        if invalid.any():
                            problems.append({
                                'type': 'date_inversion',
                                'columns': [start_col, end_col],
                                'count': int(invalid.sum()),
                                'severity': 'high'
                            })
                    except:
                        pass

        return problems

    def clean_dataset(self, df, auto_fix=False):
        """Clean the dataset based on found problems"""
        if not self.problems_found:
            print(" No problems to fix!")
            return df

        print(f"\n Cleaning dataset...")

        # Ask user which problems to fix
        if not auto_fix:
            print("\nFound these problems:")
            for i, problem in enumerate(self.problems_found, 1):
                severity = problem['severity'].upper()
                if problem['type'] == 'missing_values':
                    print(f"{i}. [{severity}] Missing values: {problem['count']} total")
                elif problem['type'] == 'exact_duplicates':
                    print(f"{i}. [{severity}] Exact duplicates: {problem['count']} rows")
                elif problem['type'] == 'future_dates':
                    print(f"{i}. [{severity}] Future dates in '{problem['column']}': {problem['count']}")
                elif problem['type'] == 'negative_values':
                    print(f"{i}. [{severity}] Negative values in '{problem['column']}': {problem['count']}")
                elif problem['type'] == 'date_inversion':
                    print(f"{i}. [{severity}] Date inversion {problem['columns'][0]} > {problem['columns'][1]}: {problem['count']}")

            choice = input("\nFix all problems? (y/n): ").strip().lower()
            if choice != 'y':
                print("Skipping cleaning.")
                return df

        cleaned_df = df.copy()

        # Apply fixes
        for problem in self.problems_found:
            if problem['type'] == 'exact_duplicates':
                before = len(cleaned_df)
                cleaned_df = cleaned_df.drop_duplicates()
                fixed = before - len(cleaned_df)
                self.fixes_applied.append(f"Removed {fixed} duplicate rows")
                print(f"✓ Removed {fixed} duplicate rows")

            elif problem['type'] == 'missing_values':
                # Fill numeric columns with median
                for col in problem.get('columns', []):
                    if pd.api.types.is_numeric_dtype(cleaned_df[col]):
                        median_val = cleaned_df[col].median()
                        missing_count = cleaned_df[col].isna().sum()
                        cleaned_df[col] = cleaned_df[col].fillna(median_val)
                        self.fixes_applied.append(f"Filled {missing_count} missing values in {col} with median")
                        print(f"✓ Filled {missing_count} missing values in {col}")

            elif problem['type'] == 'negative_values':
                col = problem['column']
                # Replace negatives with median positive value
                positive_median = cleaned_df[cleaned_df[col] >= 0][col].median()
                if not pd.isna(positive_median):
                    cleaned_df.loc[cleaned_df[col] < 0, col] = positive_median
                    self.fixes_applied.append(f"Fixed {problem['count']} negative values in {col}")
                    print(f"✓ Fixed {problem['count']} negative values in {col}")

            elif problem['type'] == 'date_inversion':
                col1, col2 = problem['columns']
                # Swap dates where start > end
                start_dates = pd.to_datetime(cleaned_df[col1], errors='coerce')
                end_dates = pd.to_datetime(cleaned_df[col2], errors='coerce')

                # Handle timezone
                if hasattr(start_dates, 'dt') and hasattr(start_dates.dt, 'tz') and start_dates.dt.tz is not None:
                    start_dates = start_dates.dt.tz_localize(None)
                if hasattr(end_dates, 'dt') and hasattr(end_dates.dt, 'tz') and end_dates.dt.tz is not None:
                    end_dates = end_dates.dt.tz_localize(None)

                mask = start_dates > end_dates
                temp = cleaned_df.loc[mask, col1].copy()
                cleaned_df.loc[mask, col1] = cleaned_df.loc[mask, col2]
                cleaned_df.loc[mask, col2] = temp
                self.fixes_applied.append(f"Fixed {problem['count']} date inversions")
                print(f"✓ Fixed {problem['count']} date inversions")

        print(f"\n✅ Cleaning complete! Applied {len(self.fixes_applied)} fixes")
        return cleaned_df

# ============================================================
# 6. TEMPORAL PRIORITY SCORER (FIXED - KEEP 1-4 SCALE, NO EXTRA COLUMNS)
# ============================================================

class TemporalScorer:
    """Add temporal priority to data with user input - 1-4 scale, only priority column"""

    def __init__(self):
        self.priority_rules = {
            'high': ['date', 'time', 'timestamp', 'year', 'month', 'created', 'updated', 'modified'],
            'medium': ['recent', 'current', 'latest', 'new', 'last'],
            'low': ['old', 'historic', 'previous', 'archive', 'past']
        }
        self.user_selected_time_column = None
        self.time_column_present = False

    def ask_user_about_time(self, df):
        """Ask user if dataset contains time information"""
        print(f"\n{'='*50}")
        print("TEMPORAL PRIORITY SCORING - USER INPUT REQUIRED")
        print(f"{'='*50}")

        print("\nDo any of these columns contain TIME information (dates, timestamps, etc.)?")
        print("This helps us determine how recent/fresh your data is.")

        # Show first 15 columns as examples
        print("\nYour dataset columns:")
        for i, col in enumerate(df.columns[:15], 1):
            sample_val = df[col].iloc[0] if len(df) > 0 and pd.notna(df[col].iloc[0]) else "N/A"
            sample_str = str(sample_val)[:30] + "..." if len(str(sample_val)) > 30 else str(sample_val)
            print(f"  {i}. {col} (e.g., {sample_str})")

        if len(df.columns) > 15:
            print(f"  ... and {len(df.columns) - 15} more columns")

        # Ask if time information exists
        print("\nDoes this dataset contain any time/date information?")
        print("  y - Yes, there are time columns")
        print("  n - No time information (will mark all data as priority 1 - Old)")

        choice = input("\nYour choice (y/n): ").strip().lower()

        if choice == 'y':
            self.time_column_present = True
            self._select_time_column(df)
        else:
            self.time_column_present = False
            print("\n No time information detected. All data will be marked as priority 1 (Old).")

        return self.time_column_present

    def _select_time_column(self, df):
        """Let user select which column contains time information"""
        print("\n Which column contains the time/date information?")

        # Show columns with numbers
        columns_list = list(df.columns)
        for i, col in enumerate(columns_list, 1):
            # Try to detect potential time columns automatically
            is_potential = any(keyword in col.lower() for keyword in
                             ['date', 'time', 'timestamp', 'year', 'month', 'day', 'created', 'updated', 'published'])
            marker = " (potential time column)" if is_potential else ""

            # Show sample value
            sample_val = df[col].iloc[0] if len(df) > 0 and pd.notna(df[col].iloc[0]) else "N/A"
            sample_str = str(sample_val)[:20] + "..." if len(str(sample_val)) > 20 else str(sample_val)

            print(f"  {i}. {col}{marker} - Sample: '{sample_str}'")

        # Let user select
        while True:
            try:
                selection = input("\nEnter column number or name: ").strip()

                # Check if input is a number
                if selection.isdigit():
                    idx = int(selection) - 1
                    if 0 <= idx < len(columns_list):
                        self.user_selected_time_column = columns_list[idx]
                        break
                    else:
                        print(f"❌ Please enter a number between 1 and {len(columns_list)}")
                else:
                    # Input is a column name
                    if selection in columns_list:
                        self.user_selected_time_column = selection
                        break
                    else:
                        print(f"❌ Column '{selection}' not found. Please try again.")
            except Exception as e:
                print(f"❌ Error: {e}. Please try again.")

        print(f" Selected time column: {self.user_selected_time_column}")

        # Ask about the format if needed
        self._confirm_time_format(df)

    def _confirm_time_format(self, df):
        """Confirm and parse the time format"""
        sample_values = df[self.user_selected_time_column].dropna().head(3)

        print("\n Sample values from selected column:")
        for i, val in enumerate(sample_values, 1):
            print(f"  {i}. {val}")

        # Try to parse the dates
        try:
            parsed_dates = pd.to_datetime(sample_values, errors='coerce')
            if parsed_dates.notna().any():
                print("✓ Successfully parsed as dates!")

                # Show parsed examples
                print("\n Parsed as:")
                for i, (orig, parsed) in enumerate(zip(sample_values, parsed_dates), 1):
                    if pd.notna(parsed):
                        # Handle timezone for display
                        if hasattr(parsed, 'tz') and parsed.tz is not None:
                            parsed_display = parsed.tz_localize(None)
                        else:
                            parsed_display = parsed
                        print(f"  {i}. {orig} → {parsed_display}")

                # Check date range
                all_dates = pd.to_datetime(df[self.user_selected_time_column], errors='coerce')
                # Handle timezone
                if hasattr(all_dates, 'dt') and hasattr(all_dates.dt, 'tz') and all_dates.dt.tz is not None:
                    all_dates = all_dates.dt.tz_localize(None)

                valid_dates = all_dates.dropna()

                if len(valid_dates) > 0:
                    min_date = valid_dates.min()
                    max_date = valid_dates.max()
                    date_range = max_date - min_date

                    print(f"\n Date range in data:")
                    print(f"  From: {min_date}")
                    print(f"  To: {max_date}")
                    print(f"  Span: {date_range.days} days")

                    # Check for future dates compared to NOW
                    current_time = datetime.now()
                    future_dates = valid_dates[valid_dates > pd.Timestamp(current_time)]
                    if len(future_dates) > 0:
                        print(f"  Warning: Found {len(future_dates)} future dates!")
            else:
                print("⚠ Could not parse as dates automatically.")
                print("Please ensure this column contains valid date/time information.")

        except Exception as e:
            print(f"⚠ Date parsing warning: {e}")
            print("Will attempt to use the column as-is for temporal scoring.")

    def analyze_temporal_data(self, df):
        """Find temporal information in dataset using user input"""
        print(f"\n Analyzing temporal information...")

        # If user confirmed no time information
        if not self.time_column_present:
            print("  User confirmed: No temporal information available")
            print("  All data will be scored as Priority 1 (Old)")
            return {}

        # If user selected a specific time column
        if self.user_selected_time_column:
            print(f"  Using user-selected time column: {self.user_selected_time_column}")

            temporal_scores = {}

            # Assign high score to the selected column
            temporal_scores[self.user_selected_time_column] = 3  # Base score

            return temporal_scores

        return {}

    def add_priority_scores(self, df, temporal_scores):
        """Add priority scores to each row based on CURRENT TIME - 1-4 scale, ONLY priority column"""
        if not temporal_scores and not self.time_column_present:
            print("\n No temporal information available. Marking all data as Priority 1 (Old).")

            # Add default priority scores (ONLY the priority column)
            df_with_priority = df.copy()
            df_with_priority['_temporal_priority'] = 1

            print(f"\n Priority scores added (all rows = 1)")
            print(f"  Total rows: {len(df_with_priority)}")

            return df_with_priority

        print(f"\n Adding priority scores based on comparison with CURRENT TIME...")
        current_time = datetime.now()
        print(f"  Current time: {current_time.strftime('%Y-%m-%d %H:%M:%S')}")

        # Calculate row priority
        row_priorities = []
        priority_counts = {1: 0, 2: 0, 3: 0, 4: 0}

        for idx, row in df.iterrows():
            max_score = 1  # Default to Old

            # If we have a user-selected time column, use it
            if self.user_selected_time_column and self.user_selected_time_column in df.columns:
                time_value = row[self.user_selected_time_column]
                if pd.notna(time_value):
                    try:
                        # Try to parse as datetime
                        date_value = pd.to_datetime(time_value, errors='coerce')
                        if pd.notna(date_value):
                            # Make date_value timezone-naive for comparison if it has timezone
                            if hasattr(date_value, 'tz') and date_value.tz is not None:
                                date_value = date_value.tz_localize(None)

                            # Calculate days difference from CURRENT TIME
                            days_old = (current_time - date_value).days

                            # Score based on how old the data is compared to NOW
                            if days_old < 0:
                                # Future dates - treat as Very Recent
                                max_score = 4
                                priority_counts[4] += 1
                            elif days_old < 30:
                                max_score = 4  # Very Recent (< 30 days old)
                                priority_counts[4] += 1
                            elif days_old < 365:
                                max_score = 3  # Recent (< 1 year old)
                                priority_counts[3] += 1
                            elif days_old < 365 * 2:
                                max_score = 2  # Medium (1-2 years old)
                                priority_counts[2] += 1
                            else:
                                max_score = 1  # Old (> 2 years old)
                                priority_counts[1] += 1
                        else:
                            max_score = 1
                            priority_counts[1] += 1
                    except Exception as e:
                        # If any error in date parsing, mark as Old
                        max_score = 1
                        priority_counts[1] += 1
                else:
                    # Null value - mark as Old
                    max_score = 1
                    priority_counts[1] += 1

            row_priorities.append(max_score)

        # Add to dataframe (ONLY the priority column)
        df_with_priority = df.copy()
        df_with_priority['_temporal_priority'] = row_priorities

        # Show distribution
        print(f"\n Priority scores added based on CURRENT TIME ({current_time.strftime('%Y-%m-%d')})!")
        print("\nPriority distribution (1-4 scale):")

        total_rows = len(df_with_priority)

        # Priority 4 (Very Recent)
        p4_pct = (priority_counts[4] / total_rows) * 100 if priority_counts[4] > 0 else 0
        print(f"  Priority 4 (Very Recent, < 30 days): {priority_counts[4]} rows ({p4_pct:.1f}%)")

        # Priority 3 (Recent)
        p3_pct = (priority_counts[3] / total_rows) * 100 if priority_counts[3] > 0 else 0
        print(f"  Priority 3 (Recent, 30 days - 1 year): {priority_counts[3]} rows ({p3_pct:.1f}%)")

        # Priority 2 (Medium)
        p2_pct = (priority_counts[2] / total_rows) * 100 if priority_counts[2] > 0 else 0
        print(f"  Priority 2 (Medium, 1-2 years): {priority_counts[2]} rows ({p2_pct:.1f}%)")

        # Priority 1 (Old)
        p1_pct = (priority_counts[1] / total_rows) * 100 if priority_counts[1] > 0 else 0
        print(f"  Priority 1 (Old, > 2 years): {priority_counts[1]} rows ({p1_pct:.1f}%)")

        # Show oldest and newest if we have a time column
        if self.user_selected_time_column and self.user_selected_time_column in df.columns:
            try:
                dates = pd.to_datetime(df[self.user_selected_time_column], errors='coerce')
                # Handle timezone
                if hasattr(dates, 'dt') and hasattr(dates.dt, 'tz') and dates.dt.tz is not None:
                    dates = dates.dt.tz_localize(None)

                valid_dates = dates.dropna()
                if len(valid_dates) > 0:
                    oldest_date = valid_dates.min()
                    newest_date = valid_dates.max()
                    oldest_days = (current_time - oldest_date).days
                    newest_days = (current_time - newest_date).days

                    print(f"\n Date analysis based on selected time column:")
                    print(f"  Oldest article: {oldest_date} ({oldest_days} days old) → Priority {1 if oldest_days > 730 else 2 if oldest_days > 365 else 3 if oldest_days > 30 else 4}")
                    print(f"  Newest article: {newest_date} ({newest_days} days old) → Priority {1 if newest_days > 730 else 2 if newest_days > 365 else 3 if newest_days > 30 else 4}")
                    print(f"  Date range span: {(newest_date - oldest_date).days} days")
            except Exception as e:
                print(f"  Note: Could not calculate full date range: {e}")

        return df_with_priority

    def get_temporal_summary(self, df):
        """Generate a summary of temporal information"""
        if '_temporal_priority' not in df.columns:
            return "No temporal priority scores found."

        summary = {
            'time_column_used': self.user_selected_time_column,
            'has_time_info': self.time_column_present,
            'priority_distribution': df['_temporal_priority'].value_counts().to_dict(),
            'total_rows': len(df)
        }

        # Add date range if available
        if self.user_selected_time_column and self.user_selected_time_column in df.columns:
            try:
                dates = pd.to_datetime(df[self.user_selected_time_column], errors='coerce')
                if hasattr(dates, 'dt') and hasattr(dates.dt, 'tz') and dates.dt.tz is not None:
                    dates = dates.dt.tz_localize(None)

                valid_dates = dates.dropna()
                if len(valid_dates) > 0:
                    summary['date_range'] = {
                        'min': str(valid_dates.min()),
                        'max': str(valid_dates.max())
                    }
            except:
                pass

        return summary

# ============================================================
# 7. MAIN PIPELINE (COMPLETE WITH OVERALL PRIORITY)
# ============================================================

class DatasetCurationPipeline:
    """Main pipeline that ties everything together"""

    def __init__(self):
        self.loader = DataLoader()
        self.merger = DatasetMerger()
        self.cleaner = DataCleaner()
        self.scorer = TemporalScorer()
        self.cutter = DataCutter()
        self.current_data = None
        self.current_dataset_name = None
        self.history = []

    def run(self):
        """Run the main pipeline"""
        print("\n" + "="*60)
        print("DATASET CURATION PIPELINE")
        print("="*60)
        print("A tool to clean, merge, cut, and prepare datasets for AI training")
        print("\n")

        # Setup directories
        setup_directories()

        while True:
            self.show_main_menu()

    def show_main_menu(self):
        """Show the main menu"""
        menu_options = {
            '1': 'Load datasets',
            '2': 'Show loaded datasets',
            '3': 'Merge datasets',
            '4': 'Clean a dataset',
            '5': 'Add temporal priority to a dataset',
            '6': 'Cut a dataset',
            '7': 'Set current dataset',
            '8': 'Calculate overall priority (NEW!)',
            '9': 'Save current dataset',
            '10': 'Run complete pipeline',
            '11': 'Show pipeline status',
            '12': 'Export reports',
            '13': 'Exit'
        }

        choice = show_menu("MAIN MENU", menu_options)

        if choice == '1':
            self.load_datasets()
        elif choice == '2':
            self.show_loaded_datasets()
        elif choice == '3':
            self.merge_datasets()
        elif choice == '4':
            self.clean_data()
        elif choice == '5':
            self.add_temporal_priority()
        elif choice == '6':
            self.cut_data()
        elif choice == '7':
            self.set_current_dataset()
        elif choice == '8':
            self.calculate_overall_priority()
        elif choice == '9':
            self.save_data()
        elif choice == '10':
            self.run_complete_pipeline()
        elif choice == '11':
            self.show_status()
        elif choice == '12':
            self.export_reports()
        elif choice == '13':
            print("\n Closing down!")
            import sys
            sys.exit(0)
        else:
            print("❌ Invalid choice. Please try again.")

    def load_datasets(self):
        """Load datasets from files or URLs"""
        print("\n LOAD DATASETS")
        print("-" * 40)

        # Use the new URL-capable loader
        datasets = self.loader.load_multiple_sources()

        # Add to merger
        for ds in datasets:
            self.merger.add_dataset(ds['name'], ds['data'])

        print(f"\n Loaded {len(datasets)} datasets")

        # If only one dataset, set it as current
        if len(datasets) == 1:
            self.current_data = datasets[0]['data']
            self.current_dataset_name = datasets[0]['name']
            print(f" Current dataset set to: {datasets[0]['name']}")

        input("\nPress Enter to continue...")

    def show_loaded_datasets(self):
        """Show loaded datasets"""
        self.merger.show_dataset_info()
        input("\nPress Enter to continue...")

    def select_dataset(self, action_name):
        """Helper function to select a dataset from loaded ones"""
        if not self.merger.datasets:
            print(f"\n❌ No datasets loaded. Please load datasets first.")
            return None, None

        print(f"\n Select a dataset to {action_name}:")
        print("-" * 40)

        for i, ds in enumerate(self.merger.datasets, 1):
            current_marker = " (current)" if self.current_data is not None and ds['data'] is self.current_data else ""
            print(f"{i}. {ds['name']}{current_marker}")
            print(f"   Rows: {ds['rows']:,}, Columns: {ds['columns']}")
            print()

        print("Enter number (1-{}), or 'c' to use current dataset, or 'b' to go back".format(len(self.merger.datasets)))

        while True:
            choice = input("\nYour choice: ").strip().lower()

            if choice == 'b':
                return None, None

            if choice == 'c':
                if self.current_data is not None:
                    return self.current_data, self.current_dataset_name
                else:
                    print("❌ No current dataset set. Please select a number.")
                    continue

            if choice.isdigit():
                idx = int(choice) - 1
                if 0 <= idx < len(self.merger.datasets):
                    selected_ds = self.merger.datasets[idx]
                    return selected_ds['data'].copy(), selected_ds['name']
                else:
                    print(f"❌ Please enter a number between 1 and {len(self.merger.datasets)}")
            else:
                print("❌ Invalid input. Please enter a number, 'c', or 'b'")

    def set_current_dataset(self):
        """Set the current dataset from loaded ones"""
        if not self.merger.datasets:
            print("\n❌ No datasets loaded. Please load datasets first.")
            input("Press Enter to continue...")
            return

        print("\n SET CURRENT DATASET")
        print("-" * 40)

        for i, ds in enumerate(self.merger.datasets, 1):
            print(f"{i}. {ds['name']}")
            print(f"   Rows: {ds['rows']:,}, Columns: {ds['columns']}")
            print()

        try:
            choice = int(input("Enter dataset number to set as current: ").strip())
            if 1 <= choice <= len(self.merger.datasets):
                selected = self.merger.datasets[choice-1]
                self.current_data = selected['data']
                self.current_dataset_name = selected['name']
                print(f"✓ Current dataset set to: {selected['name']}")
            else:
                print(f"❌ Please enter a number between 1 and {len(self.merger.datasets)}")
        except ValueError:
            print("❌ Invalid input. Please enter a number.")

        input("\nPress Enter to continue...")

    def merge_datasets(self):
        """Merge loaded datasets"""
        if len(self.merger.datasets) < 2:
            print("\n❌ Need at least 2 datasets to merge.")
            print("Please load more datasets first.")
            input("Press Enter to continue...")
            return

        self.merger.show_dataset_info()

        # Show common columns
        self.merger.find_matching_columns()

        # Ask for merge type
        print("\nSelect merge strategy:")
        print("  1. Smart merge (recommended)")
        print("  2. Vertical (concatenate all rows)")
        print("  3. Horizontal (merge on common column)")
        print("  4. Custom (choose options)")

        choice = input("\nYour choice (1-4): ").strip()

        merge_types = {'1': 'smart', '2': 'vertical', '3': 'horizontal', '4': 'custom'}
        merge_type = merge_types.get(choice, 'smart')

        # Perform merge
        merged_data = self.merger.merge_datasets(merge_type)

        if merged_data is not None:
            self.current_data = merged_data
            self.current_dataset_name = f"merged_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
            print(f"\n Current dataset updated ({len(merged_data)} rows)")

            # Show preview
            preview = input("\nShow preview of merged data? (y/n): ").strip().lower()
            if preview == 'y':
                print(f"\nFirst 5 rows:")
                print(merged_data.head().to_string())

        input("\nPress Enter to continue...")

    def clean_data(self):
        """Clean a selected dataset"""
        # Select dataset
        df, name = self.select_dataset("clean")

        if df is None:
            return

        print(f"\n CLEANING DATASET: {name}")
        print(f"Dataset: {len(df)} rows, {len(df.columns)} columns")
        print("-" * 40)

        # Analyze
        self.cleaner.analyze_dataset(df)

        # Ask if user wants to clean
        if self.cleaner.problems_found:
            choice = input("\nProceed with cleaning? (y/n): ").strip().lower()
            if choice == 'y':
                auto_fix = input("Apply fixes automatically? (y/n): ").strip().lower() == 'y'
                cleaned_data = self.cleaner.clean_dataset(df, auto_fix)

                if cleaned_data is not None:
                    # Update the dataset in merger
                    self.merger.update_dataset(name, cleaned_data)

                    # Update current if needed
                    if self.current_dataset_name == name:
                        self.current_data = cleaned_data

                    print(f"\n Dataset cleaned! New shape: {cleaned_data.shape}")

                    # Show what was fixed
                    if self.cleaner.fixes_applied:
                        print("\nApplied fixes:")
                        for fix in self.cleaner.fixes_applied:
                            print(f"  ✓ {fix}")
        else:
            print("\n Dataset is already clean!")

        input("\nPress Enter to continue...")

    def add_temporal_priority(self):
        """Add temporal priority scores to a selected dataset"""
        # Select dataset
        df, name = self.select_dataset("add temporal priority")

        if df is None:
            return

        print(f"\n TEMPORAL PRIORITY SCORING - {name}")
        print("-" * 40)

        # Ask user about time
        self.scorer.ask_user_about_time(df)

        # Analyze temporal data
        temporal_scores = self.scorer.analyze_temporal_data(df)

        # Add priority scores (ONLY adds _temporal_priority column)
        df_with_priority = self.scorer.add_priority_scores(df, temporal_scores)

        # Update the dataset in merger
        self.merger.update_dataset(name, df_with_priority)

        # Update current if needed
        if self.current_dataset_name == name:
            self.current_data = df_with_priority

        input("\nPress Enter to continue...")

    def calculate_overall_priority(self):
        """Calculate overall priority by multiplying source priority with temporal priority"""
        # Select dataset
        df, name = self.select_dataset("calculate overall priority")

        if df is None:
            return

        print(f"\n{'='*60}")
        print(f"CALCULATE OVERALL PRIORITY - {name}")
        print(f"{'='*60}")

        # Check if temporal priority exists
        if '_temporal_priority' not in df.columns:
            print("\n❌ Temporal priority column not found!")
            print("Please run 'Add temporal priority' first (Option 5) to create temporal priority scores.")

            # Ask if user wants to run temporal priority now
            run_now = input("\nRun temporal priority now? (y/n): ").strip().lower()
            if run_now == 'y':
                # Ask user about time
                self.scorer.ask_user_about_time(df)

                # Analyze temporal data
                temporal_scores = self.scorer.analyze_temporal_data(df)

                # Add priority scores
                df_with_priority = self.scorer.add_priority_scores(df, temporal_scores)

                # Update the dataset
                self.merger.update_dataset(name, df_with_priority)
                if self.current_dataset_name == name:
                    self.current_data = df_with_priority

                df = df_with_priority
                print("\n✓ Temporal priority added successfully!")
            else:
                return

        # Show current temporal priority distribution
        print("\nCurrent Temporal Priority Distribution (1-4 scale):")
        priority_counts = df['_temporal_priority'].value_counts().sort_index()
        total_rows = len(df)
        for priority in [1, 2, 3, 4]:
            count = priority_counts.get(priority, 0)
            if count > 0:
                level = {1: 'Old (>2 years)', 2: 'Medium (1-2 years)', 3: 'Recent (30d-1yr)', 4: 'Very Recent (<30d)'}[priority]
                percentage = (count / total_rows) * 100
                print(f"  Priority {priority} ({level}): {count} rows ({percentage:.1f}%)")

        # Ask for source priority value (0-1 scale)
        print("\n" + "-"*40)
        print("SOURCE PRIORITY CONFIGURATION")
        print("-"*40)
        print("\nSource priority represents the inherent reliability/importance of this data source.")
        print("This value will be the SAME for ALL rows in this dataset.")
        print("\nRecommended values (0-1 scale):")
        print("  - High reliability sources (e.g., major news outlets): 0.8 to 1.0")
        print("  - Medium reliability sources: 0.5 to 0.7")
        print("  - Low reliability sources: 0.2 to 0.4")
        print("  - Untrusted sources: 0.0 to 0.1")

        while True:
            try:
                source_priority = float(input("\nEnter source priority value (0.0 to 1.0): ").strip())
                if 0.0 <= source_priority <= 1.0:
                    break
                else:
                    print("❌ Please enter a value between 0.0 and 1.0")
            except ValueError:
                print("❌ Please enter a valid number")

        print(f"\n✓ Source priority set to: {source_priority:.3f} for all rows")

        # Calculate overall priority (multiplication)
        print("\n Calculating overall priority...")
        df_with_overall = df.copy()
        df_with_overall['_source_priority'] = source_priority
        df_with_overall['_overall_priority'] = df_with_overall['_temporal_priority'] * source_priority

        # Show overall priority statistics
        print(f"\n{'='*50}")
        print("OVERALL PRIORITY RESULTS")
        print(f"{'='*50}")
        print(f"\nOverall Priority = Source Priority ({source_priority:.3f}) × Temporal Priority (1-4)")

        # Show distribution
        print("\nOverall Priority Statistics:")
        overall = df_with_overall['_overall_priority']
        print(f"  Mean: {overall.mean():.3f}")
        print(f"  Std: {overall.std():.3f}")
        print(f"  Min: {overall.min():.3f}")
        print(f"  Max: {overall.max():.3f}")

        # Show sample of results
        print("\nSample of calculated overall priorities (first 10 rows):")
        print("  Temporal × Source = Overall")
        for i in range(min(10, len(df_with_overall))):
            temp = df_with_overall['_temporal_priority'].iloc[i]
            overall_val = df_with_overall['_overall_priority'].iloc[i]
            print(f"  {temp:.0f} × {source_priority:.3f} = {overall_val:.3f}")

        # Ask to save
        save_choice = input("\nSave dataset with overall priority column? (y/n): ").strip().lower()
        if save_choice == 'y':
            # Update the dataset in merger
            self.merger.update_dataset(name, df_with_overall)

            # Update current if needed
            if self.current_dataset_name == name:
                self.current_data = df_with_overall

            # Also save a copy to cut directory
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            filename = f"{name}_overall_priority_{timestamp}.csv"
            filepath = os.path.join('data/cut', filename)
            df_with_overall.to_csv(filepath, index=False)
            print(f"✓ Saved to: {filepath}")

            # Record in history
            self.history.append({
                'action': 'overall_priority',
                'timestamp': datetime.now(),
                'dataset': name,
                'source_priority': source_priority,
                'shape': df_with_overall.shape
            })
        else:
            print(" Overall priority calculated but not saved.")

        input("\nPress Enter to continue...")

    def cut_data(self):
        """Cut a selected dataset"""
        # Select dataset
        df, name = self.select_dataset("cut")

        if df is None:
            return

        # Call the cutter's interactive menu
        self.cutter.cut_multiple_ways(df, name)
        input("\nPress Enter to continue...")

    def save_data(self):
        """Save current dataset"""
        if self.current_data is None:
            print("\n❌ No current dataset to save.")
            print("Please load or create a dataset first, or use 'Set current dataset' option.")
            input("Press Enter to continue...")
            return

        print(f"\n SAVE CURRENT DATASET: {self.current_dataset_name}")
        print(f"Dataset shape: {self.current_data.shape}")
        print("-" * 40)

        # Get filename
        default_name = f"{self.current_dataset_name}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        filename = input(f"\nEnter filename (default: {default_name}): ").strip()
        if not filename:
            filename = default_name

        # Choose format
        print("\nSelect format:")
        print("  1. CSV (recommended)")
        print("  2. Excel")
        print("  3. JSON")
        print("  4. Multiple formats")

        format_choice = input("\nYour choice (1-4): ").strip()

        try:
            if format_choice == '1':
                # Save as CSV
                filepath = f"data/processed/{filename}.csv"
                self.current_data.to_csv(filepath, index=False)
                print(f" Saved to {filepath}")

            elif format_choice == '2':
                # Save as Excel
                filepath = f"data/processed/{filename}.xlsx"
                self.current_data.to_excel(filepath, index=False)
                print(f" Saved to {filepath}")

            elif format_choice == '3':
                # Save as JSON
                filepath = f"data/processed/{filename}.json"
                self.current_data.to_json(filepath, orient='records', indent=2)
                print(f" Saved to {filepath}")

            elif format_choice == '4':
                # Save in multiple formats
                self.current_data.to_csv(f"data/processed/{filename}.csv", index=False)
                self.current_data.to_excel(f"data/processed/{filename}.xlsx", index=False)
                self.current_data.to_json(f"data/processed/{filename}.json", orient='records', indent=2)
                print(f" Saved in multiple formats:")
                print(f"  - data/processed/{filename}.csv")
                print(f"  - data/processed/{filename}.xlsx")
                print(f"  - data/processed/{filename}.json")

            else:
                print("❌ Invalid choice. Saving as CSV.")
                filepath = f"data/processed/{filename}.csv"
                self.current_data.to_csv(filepath, index=False)
                print(f" Saved to {filepath}")

            # Record in history
            self.history.append({
                'action': 'save',
                'timestamp': datetime.now(),
                'filename': filename,
                'shape': self.current_data.shape,
                'dataset': self.current_dataset_name
            })

        except Exception as e:
            print(f"❌ Error saving file: {e}")

        input("\nPress Enter to continue...")

    def run_complete_pipeline(self):
        """Run the complete pipeline from start to finish"""
        print("\n" + "="*60)
        print("COMPLETE PIPELINE EXECUTION")
        print("="*60)
        print("This will run all steps automatically:")
        print("  1. Load datasets")
        print("  2. Merge datasets")
        print("  3. Clean data")
        print("  4. Add temporal priority")
        print("  5. Calculate overall priority")
        print("  6. Cut dataset (optional)")
        print("  7. Save results")
        print("\n")

        confirm = input("Proceed with complete pipeline? (y/n): ").strip().lower()
        if confirm != 'y':
            print("Pipeline cancelled.")
            return

        steps = [
            (" Load datasets", self._pipeline_load_data),
            (" Merge datasets", self._pipeline_merge_data),
            (" Clean data", self._pipeline_clean_data),
            (" Add temporal priority", self._pipeline_add_priority),
            (" Calculate overall priority", self._pipeline_calc_overall),
            (" Cut dataset (optional)", self._pipeline_cut_data),
            (" Save results", self._pipeline_save_results)
        ]

        for step_name, step_func in steps:
            print(f"\n{'='*50}")
            print(f"STEP: {step_name}")
            print(f"{'='*50}")

            try:
                step_func()
                print(f" {step_name} completed successfully")
            except Exception as e:
                print(f"❌ Error in {step_name}: {e}")
                retry = input("Retry this step? (y/n): ").strip().lower()
                if retry == 'y':
                    try:
                        step_func()
                        print(f" {step_name} completed on retry")
                    except:
                        print(f"❌ Failed again. Skipping to next step.")
                else:
                    print(f"  Skipping {step_name}")
                    continue

        print("\n" + "="*60)
        print(" COMPLETE PIPELINE FINISHED!")
        print("="*60)
        print(f"\nFinal dataset: {self.current_data.shape if self.current_data else 'No data'}")
        print(f"Saved to: data/processed/ and data/cut/")

        input("\nPress Enter to continue...")

    def _pipeline_load_data(self):
        """Load data for pipeline"""
        files = self.loader.list_data_sources()
        if not files:
            print("  No files found. Creating sample data...")
            self._create_sample_data()
            files = self.loader.list_data_sources()

        # Load all files
        datasets = []
        for i, file in enumerate(files, 1):
            file_path = os.path.join('data/raw', file)
            df = self.loader.load_from_source(file_path)
            if df is not None:
                name = file.split('.')[0]
                datasets.append({
                    'name': name,
                    'data': df,
                    'source': file_path,
                    'rows': len(df),
                    'columns': len(df.columns)
                })

        for ds in datasets:
            self.merger.add_dataset(ds['name'], ds['data'])

        if len(datasets) == 1:
            self.current_data = datasets[0]['data']
            self.current_dataset_name = datasets[0]['name']

    def _pipeline_merge_data(self):
        """Merge data for pipeline"""
        if len(self.merger.datasets) < 2:
            print("Only one dataset loaded. Skipping merge.")
            if self.merger.datasets:
                self.current_data = self.merger.datasets[0]['data']
                self.current_dataset_name = self.merger.datasets[0]['name']
            return

        # Use smart merge
        self.current_data = self.merger.merge_datasets('smart')
        self.current_dataset_name = f"merged_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        print(f"Merged to {self.current_data.shape}")

    def _pipeline_clean_data(self):
        """Clean data for pipeline"""
        if self.current_data is None:
            return

        # Analyze and clean
        self.cleaner.analyze_dataset(self.current_data)
        self.current_data = self.cleaner.clean_dataset(self.current_data, auto_fix=True)
        print(f"Cleaned to {self.current_data.shape}")

    def _pipeline_add_priority(self):
        """Add priority for pipeline"""
        if self.current_data is None:
            return

        # Ask user about time
        self.scorer.ask_user_about_time(self.current_data)

        # Add temporal priority
        temporal_scores = self.scorer.analyze_temporal_data(self.current_data)
        self.current_data = self.scorer.add_priority_scores(self.current_data, temporal_scores)
        print("Temporal priority added")

    def _pipeline_calc_overall(self):
        """Calculate overall priority for pipeline"""
        if self.current_data is None:
            return

        if '_temporal_priority' not in self.current_data.columns:
            print("⚠ Temporal priority not found. Skipping overall priority calculation.")
            return

        # Ask for source priority
        print("\n" + "-"*40)
        print("SOURCE PRIORITY CONFIGURATION")
        print("-"*40)
        print("\nRecommended values:")
        print("  - High reliability sources: 0.8 to 1.0")
        print("  - Medium reliability sources: 0.5 to 0.7")
        print("  - Low reliability sources: 0.2 to 0.4")

        while True:
            try:
                source_priority = float(input("\nEnter source priority value (0.0 to 1.0): ").strip())
                if 0.0 <= source_priority <= 1.0:
                    break
                else:
                    print("❌ Please enter a value between 0.0 and 1.0")
            except ValueError:
                print("❌ Please enter a valid number")

        # Calculate overall priority
        self.current_data['_source_priority'] = source_priority
        self.current_data['_overall_priority'] = self.current_data['_temporal_priority'] * source_priority
        print(f"✓ Overall priority calculated with source priority {source_priority:.3f}")

    def _pipeline_cut_data(self):
        """Cut data for pipeline (optional)"""
        if self.current_data is None:
            return

        cut_choice = input("\nDo you want to cut the dataset? (y/n): ").strip().lower()
        if cut_choice == 'y':
            # Simple cut - take first 80% as training, 20% as test
            train_size = int(len(self.current_data) * 0.8)

            train_df = self.current_data.iloc[:train_size].copy()
            test_df = self.current_data.iloc[train_size:].copy()

            # Save cut pieces
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')

            train_file = os.path.join('data/cut', f'{self.current_dataset_name}_train_{timestamp}.csv')
            test_file = os.path.join('data/cut', f'{self.current_dataset_name}_test_{timestamp}.csv')

            train_df.to_csv(train_file, index=False)
            test_df.to_csv(test_file, index=False)

            print(f"  Created train set ({len(train_df)} rows) and test set ({len(test_df)} rows)")

            # Keep the full dataset as current
            print("  Full dataset preserved for further processing")

    def _pipeline_save_results(self):
        """Save results for pipeline"""
        if self.current_data is None:
            return

        # Save with timestamp
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        filename = f"{self.current_dataset_name}_pipeline_output_{timestamp}"

        # Save in multiple formats
        self.current_data.to_csv(f"data/processed/{filename}.csv", index=False)
        self.current_data.to_excel(f"data/processed/{filename}.xlsx", index=False)

        print(f"Results saved to data/processed/{filename}.[csv|xlsx]")

    def _create_sample_data(self):
        """Create sample data if no files exist"""
        print("Creating sample datasets...")

        # Sample dataset 1: User data
        dates1 = pd.date_range('2023-01-01', periods=50, freq='D')
        df1 = pd.DataFrame({
            'user_id': range(100, 150),
            'name': [f'User_{i}' for i in range(50)],
            'signup_date': dates1,
            'last_login': dates1 + pd.Timedelta(days=np.random.randint(0, 30, 50)),
            'age': np.random.randint(18, 70, 50),
            'country': np.random.choice(['USA', 'UK', 'Canada', 'Australia'], 50)
        })

        # Sample dataset 2: Product data
        df2 = pd.DataFrame({
            'product_id': range(200, 250),
            'product_name': [f'Product_{i}' for i in range(50)],
            'price': np.random.uniform(10, 1000, 50),
            'category': np.random.choice(['Electronics', 'Clothing', 'Books', 'Food'], 50),
            'created_date': pd.date_range('2023-03-01', periods=50, freq='D')
        })

        # Save sample files
        df1.to_csv('data/raw/sample_users.csv', index=False)
        df2.to_csv('data/raw/sample_products.csv', index=False)

        print(" Created 2 sample datasets in data/raw/")
        print("   - sample_users.csv (50 users)")
        print("   - sample_products.csv (50 products)")

    def show_status(self):
        """Show pipeline status"""
        print("\n" + "="*60)
        print("PIPELINE STATUS")
        print("="*60)

        # Current dataset info
        if self.current_data is not None:
            print(f"\n CURRENT DATASET: {self.current_dataset_name}")
            print(f"   Rows: {len(self.current_data):,}")
            print(f"   Columns: {len(self.current_data.columns)}")

            # Check for special columns
            special_cols = [col for col in self.current_data.columns if col.startswith('_')]
            if special_cols:
                print(f"   Special columns: {', '.join(special_cols)}")

            # Memory usage
            mem_usage = self.current_data.memory_usage(deep=True).sum() / 1024 / 1024
            print(f"   Memory: {mem_usage:.2f} MB")
        else:
            print("\n📭 No current dataset")

        # Loaded datasets info
        if self.merger.datasets:
            print(f"\n LOADED DATASETS: {len(self.merger.datasets)}")
            for ds in self.merger.datasets:
                current_marker = " (current)" if self.current_data is not None and ds['data'] is self.current_data else ""
                print(f"   - {ds['name']}{current_marker}: {ds['rows']:,} rows")

        # Cut history
        if self.cutter.cut_history:
            print(f"\n CUT OPERATIONS: {len(self.cutter.cut_history)}")
            last_cut = self.cutter.cut_history[-1]
            print(f"   Last cut: {last_cut['method']} ({last_cut['timestamp'].strftime('%H:%M:%S')})")
            if 'pieces' in last_cut:
                print(f"   Pieces: {len(last_cut['pieces'])}")

        # History
        if self.history:
            print(f"\n RECENT ACTIONS ({len(self.history)} total):")
            for i, action in enumerate(self.history[-3:], 1):
                action_type = action.get('action', 'unknown')
                timestamp = action.get('timestamp', 'unknown')
                if isinstance(timestamp, datetime):
                    timestamp = timestamp.strftime('%H:%M:%S')
                dataset = action.get('dataset', '')
                print(f"   {i}. {action_type} {dataset} at {timestamp}")

        print("\n" + "-"*60)
        print("DIRECTORY STRUCTURE:")
        print("  data/raw/       - Upload your CSV files here")
        print("  data/processed/ - Cleaned datasets saved here")
        print("  data/merged/    - Merged datasets (if any)")
        print("  data/cut/       - Cut/split datasets saved here")
        print("  reports/        - Analysis reports")

        input("\nPress Enter to continue...")

    def export_reports(self):
        """Export analysis reports"""
        if self.current_data is None:
            print("\n❌ No dataset to analyze.")
            print("Please load or set a current dataset first.")
            input("Press Enter to continue...")
            return

        print("\n" + "="*60)
        print("EXPORT REPORTS")
        print("="*60)

        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')

        # 1. Dataset summary report
        print("\n Creating dataset summary report...")
        summary = {
            'export_date': timestamp,
            'dataset_name': self.current_dataset_name,
            'dataset_shape': self.current_data.shape,
            'columns': list(self.current_data.columns),
            'data_types': {col: str(self.current_data[col].dtype) for col in self.current_data.columns},
            'missing_values': int(self.current_data.isnull().sum().sum()),
            'duplicate_rows': int(self.current_data.duplicated().sum()),
            'memory_usage_mb': self.current_data.memory_usage(deep=True).sum() / 1024 / 1024
        }

        # Add temporal priority info if available
        if '_temporal_priority' in self.current_data.columns:
            priority_dist = self.current_data['_temporal_priority'].value_counts().to_dict()
            summary['temporal_priority_distribution'] = priority_dist

        # Add overall priority info if available
        if '_overall_priority' in self.current_data.columns:
            overall_stats = {
                'mean': float(self.current_data['_overall_priority'].mean()),
                'std': float(self.current_data['_overall_priority'].std()),
                'min': float(self.current_data['_overall_priority'].min()),
                'max': float(self.current_data['_overall_priority'].max())
            }
            summary['overall_priority_stats'] = overall_stats

            if '_source_priority' in self.current_data.columns:
                summary['source_priority'] = float(self.current_data['_source_priority'].iloc[0])

        # Save summary
        summary_file = f"reports/{self.current_dataset_name}_summary_{timestamp}.json"
        with open(summary_file, 'w') as f:
            json.dump(summary, f, indent=2, default=str)

        print(f" Summary saved to {summary_file}")

        # 2. Data quality report
        print("\n Creating data quality report...")

        # Analyze current data
        self.cleaner.analyze_dataset(self.current_data)

        quality_report = {
            'export_date': timestamp,
            'dataset_name': self.current_dataset_name,
            'problems_found': len(self.cleaner.problems_found),
            'problems': self.cleaner.problems_found,
            'fixes_applied': self.cleaner.fixes_applied
        }

        quality_file = f"reports/{self.current_dataset_name}_quality_{timestamp}.json"
        with open(quality_file, 'w') as f:
            json.dump(quality_report, f, indent=2, default=str)

        print(f" Quality report saved to {quality_file}")

        # 3. Cut history report (if any)
        if self.cutter.cut_history:
            print("\n Creating cut history report...")
            cut_report = {
                'export_date': timestamp,
                'cut_operations': self.cutter.cut_history
            }
            cut_file = f"reports/cut_history_{timestamp}.json"
            with open(cut_file, 'w') as f:
                json.dump(cut_report, f, indent=2, default=str)
            print(f" Cut history saved to {cut_file}")

        # 4. Export sample data
        print("\n Exporting sample data...")
        sample_data = self.current_data.head(100)  # First 100 rows
        sample_file = f"reports/{self.current_dataset_name}_sample_{timestamp}.csv"
        sample_data.to_csv(sample_file, index=False)

        print(f" Sample data saved to {sample_file}")

        print("\n" + "="*60)
        print(" ALL REPORTS EXPORTED!")
        print("="*60)
        print(f"\nReports saved to 'reports/' directory:")
        print(f"  1. {summary_file}")
        print(f"  2. {quality_file}")
        if self.cutter.cut_history:
            print(f"  3. {cut_file}")
            print(f"  4. {sample_file}")
        else:
            print(f"  3. {sample_file}")

        input("\nPress Enter to continue...")

