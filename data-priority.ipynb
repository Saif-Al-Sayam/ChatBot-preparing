# 4. DATA CLEANER
# ============================================================

class DataCleaner:
    """Clean and fix data issues"""

    def __init__(self):
        self.problems_found = []
        self.fixes_applied = []

    def analyze_dataset(self, df):
        """Analyze dataset for common problems"""
        print(f"\n Analyzing dataset ({len(df)} rows, {len(df.columns)} columns)...")

        problems = []

        # 1. Check for missing values
        missing_counts = df.isnull().sum()
        missing_cols = missing_counts[missing_counts > 0]

        if len(missing_cols) > 0:
            problem = {
                'type': 'missing_values',
                'count': int(missing_counts.sum()),
                'columns': list(missing_cols.index),
                'severity': 'medium'
            }
            problems.append(problem)
            print(f"  Missing values: {missing_counts.sum()} total")

        # 2. Check data types
        dtype_problems = []
        for col in df.columns:
            if df[col].dtype == 'object':
                # Try to convert to numeric or datetime
                numeric_test = pd.to_numeric(df[col], errors='coerce')
                date_test = pd.to_datetime(df[col], errors='coerce')

                if numeric_test.notna().any() or date_test.notna().any():
                    dtype_problems.append(col)

        if dtype_problems:
            problem = {
                'type': 'mixed_data_types',
                'columns': dtype_problems,
                'severity': 'low'
            }
            problems.append(problem)
            print(f"  Mixed data types in: {dtype_problems[:3]}...")

        # 3. Check for duplicates
        exact_dups = df.duplicated().sum()
        if exact_dups > 0:
            problem = {
                'type': 'exact_duplicates',
                'count': int(exact_dups),
                'severity': 'high'
            }
            problems.append(problem)
            print(f"  Exact duplicates: {exact_dups} rows")

        # 4. Check numeric columns for outliers
        numeric_cols = df.select_dtypes(include=[np.number]).columns
        outlier_problems = []

        for col in numeric_cols:
            if df[col].notna().sum() > 0:
                Q1 = df[col].quantile(0.25)
                Q3 = df[col].quantile(0.75)
                IQR = Q3 - Q1
                outliers = ((df[col] < (Q1 - 1.5 * IQR)) | (df[col] > (Q3 + 1.5 * IQR))).sum()

                if outliers > 0:
                    outlier_problems.append({
                        'column': col,
                        'outliers': int(outliers),
                        'percent': (outliers / len(df)) * 100
                    })

        if outlier_problems:
            problem = {
                'type': 'outliers',
                'details': outlier_problems,
                'severity': 'low'
            }
            problems.append(problem)
            print(f"  Outliers found in {len(outlier_problems)} columns")

        # 5. Check for logical errors
        logical_problems = self._check_logical_errors(df)
        problems.extend(logical_problems)

        self.problems_found = problems

        if not problems:
            print(" No major problems found!")
        else:
            print(f"\n Summary: Found {len(problems)} types of problems")

        return problems

    def _check_logical_errors(self, df):
        """Check for logical errors in data"""
        problems = []

        # Check date columns
        date_columns = [col for col in df.columns
                       if any(keyword in col.lower() for keyword in ['date', 'time', 'timestamp'])]

        for col in date_columns:
            try:
                dates = pd.to_datetime(df[col], errors='coerce')

                # Check for future dates
                future_dates = dates > pd.Timestamp.now()
                if future_dates.any():
                    problems.append({
                        'type': 'future_dates',
                        'column': col,
                        'count': int(future_dates.sum()),
                        'severity': 'medium'
                    })
            except:
                pass

        # Check for negative values in positive columns
        positive_columns = [col for col in df.columns
                          if any(keyword in col.lower() for keyword in ['age', 'salary', 'price', 'amount', 'quantity'])]

        for col in positive_columns:
            if col in df.columns and pd.api.types.is_numeric_dtype(df[col]):
                negative_values = df[col] < 0
                if negative_values.any():
                    problems.append({
                        'type': 'negative_values',
                        'column': col,
                        'count': int(negative_values.sum()),
                        'severity': 'high'
                    })

        # Check for start > end dates
        start_cols = [col for col in date_columns if 'start' in col.lower() or 'begin' in col.lower()]
        end_cols = [col for col in date_columns if 'end' in col.lower() or 'finish' in col.lower()]

        for start_col in start_cols:
            for end_col in end_cols:
                if start_col != end_col and start_col in df.columns and end_col in df.columns:
                    try:
                        start_dates = pd.to_datetime(df[start_col], errors='coerce')
                        end_dates = pd.to_datetime(df[end_col], errors='coerce')
                        invalid = start_dates > end_dates
                        if invalid.any():
                            problems.append({
                                'type': 'date_inversion',
                                'columns': [start_col, end_col],
                                'count': int(invalid.sum()),
                                'severity': 'high'
                            })
                    except:
                        pass

        return problems

    def clean_dataset(self, df, auto_fix=False):
        """Clean the dataset based on found problems"""
        if not self.problems_found:
            print(" No problems to fix!")
            return df

        print(f"\n Cleaning dataset...")

        # Ask user which problems to fix
        if not auto_fix:
            print("\nFound these problems:")
            for i, problem in enumerate(self.problems_found, 1):
                severity = problem['severity'].upper()
                if problem['type'] == 'missing_values':
                    print(f"{i}. [{severity}] Missing values: {problem['count']} total")
                elif problem['type'] == 'exact_duplicates':
                    print(f"{i}. [{severity}] Exact duplicates: {problem['count']} rows")
                elif problem['type'] == 'future_dates':
                    print(f"{i}. [{severity}] Future dates in '{problem['column']}': {problem['count']}")
                elif problem['type'] == 'negative_values':
                    print(f"{i}. [{severity}] Negative values in '{problem['column']}': {problem['count']}")
                elif problem['type'] == 'date_inversion':
                    print(f"{i}. [{severity}] Date inversion {problem['columns'][0]} > {problem['columns'][1]}: {problem['count']}")

            choice = input("\nFix all problems? (y/n): ").strip().lower()
            if choice != 'y':
                print("Skipping cleaning.")
                return df

        cleaned_df = df.copy()

        # Apply fixes
        for problem in self.problems_found:
            if problem['type'] == 'exact_duplicates':
                before = len(cleaned_df)
                cleaned_df = cleaned_df.drop_duplicates()
                fixed = before - len(cleaned_df)
                self.fixes_applied.append(f"Removed {fixed} duplicate rows")
                print(f"✓ Removed {fixed} duplicate rows")

            elif problem['type'] == 'missing_values':
                # Fill numeric columns with median
                for col in problem.get('columns', []):
                    if pd.api.types.is_numeric_dtype(cleaned_df[col]):
                        median_val = cleaned_df[col].median()
                        missing_count = cleaned_df[col].isna().sum()
                        cleaned_df[col] = cleaned_df[col].fillna(median_val)
                        self.fixes_applied.append(f"Filled {missing_count} missing values in {col} with median")
                        print(f"✓ Filled {missing_count} missing values in {col}")

            elif problem['type'] == 'negative_values':
                col = problem['column']
                # Replace negatives with median positive value
                positive_median = cleaned_df[cleaned_df[col] >= 0][col].median()
                if not pd.isna(positive_median):
                    cleaned_df.loc[cleaned_df[col] < 0, col] = positive_median
                    self.fixes_applied.append(f"Fixed {problem['count']} negative values in {col}")
                    print(f"✓ Fixed {problem['count']} negative values in {col}")

            elif problem['type'] == 'date_inversion':
                col1, col2 = problem['columns']
                # Swap dates where start > end
                mask = pd.to_datetime(cleaned_df[col1], errors='coerce') > pd.to_datetime(cleaned_df[col2], errors='coerce')
                temp = cleaned_df.loc[mask, col1].copy()
                cleaned_df.loc[mask, col1] = cleaned_df.loc[mask, col2]
                cleaned_df.loc[mask, col2] = temp
                self.fixes_applied.append(f"Fixed {problem['count']} date inversions")
                print(f"✓ Fixed {problem['count']} date inversions")

        print(f"\n✅ Cleaning complete! Applied {len(self.fixes_applied)} fixes")
        return cleaned_df

# ============================================================
# 5. TEMPORAL PRIORITY SCORER
# ============================================================

class TemporalScorer:
    """Add temporal priority to data"""

    def __init__(self):
        self.priority_rules = {
            'high': ['date', 'time', 'timestamp', 'year', 'month', 'created', 'updated', 'modified'],
            'medium': ['recent', 'current', 'latest', 'new', 'last'],
            'low': ['old', 'historic', 'previous', 'archive', 'past']
        }

    def analyze_temporal_data(self, df):
        """Find temporal information in dataset"""
        print(f"\n Analyzing temporal information...")

        temporal_columns = []
        temporal_scores = {}

        for col in df.columns:
            col_lower = col.lower()
            score = 0

            # Check column name
            for priority, keywords in self.priority_rules.items():
                if any(keyword in col_lower for keyword in keywords):
                    if priority == 'high':
                        score = 3
                    elif priority == 'medium':
                        score = 2
                    else:
                        score = 1
                    break

            # Check column content for dates
            if df[col].dtype == 'object':
                # Try to parse as date
                try:
                    dates = pd.to_datetime(df[col], errors='coerce')
                    if dates.notna().any():
                        score = max(score, 3)  # High priority if contains dates

                        # Calculate how recent the dates are
                        recent_dates = dates[dates > pd.Timestamp.now() - pd.Timedelta(days=365)]
                        recency_ratio = len(recent_dates) / len(dates) if len(dates) > 0 else 0

                        if recency_ratio > 0.5:
                            score = 4  # Very high priority for recent data
                except:
                    pass

            if score > 0:
                temporal_columns.append(col)
                temporal_scores[col] = score

        if temporal_columns:
            print(f" Found {len(temporal_columns)} columns with temporal information")
            print("\nTemporal columns (score 1-4, higher is better):")
            for col, score in sorted(temporal_scores.items(), key=lambda x: x[1], reverse=True):
                level = {1: 'Low', 2: 'Medium', 3: 'High', 4: 'Very High'}.get(score, 'Unknown')
                print(f"  {col}: {level} ({score})")
        else:
            print("  No temporal columns found")

        return temporal_scores

    def add_priority_scores(self, df, temporal_scores):
        """Add priority scores to each row"""
        if not temporal_scores:
            print("  No temporal information found. Skipping priority scoring.")
            return df

        print(f"\n Adding priority scores...")

        # Calculate row priority
        row_priorities = []

        for idx, row in df.iterrows():
            max_score = 1  # Default

            for col, col_score in temporal_scores.items():
                if col_score > max_score and pd.notna(row[col]):
                    max_score = col_score

                    # Boost score for recent dates
                    if col_score >= 3:
                        try:
                            if isinstance(row[col], (datetime, pd.Timestamp)):
                                days_old = (pd.Timestamp.now() - row[col]).days
                                if days_old < 30:
                                    max_score = 4  # Very recent
                                elif days_old < 365:
                                    max_score = 3  # Recent
                        except:
                            pass

            row_priorities.append(max_score)

        # Add to dataframe
        df_with_priority = df.copy()
        df_with_priority['_temporal_priority'] = row_priorities
        df_with_priority['_data_freshness'] = df_with_priority['_temporal_priority'].map(
            {1: 'Old', 2: 'Medium', 3: 'Recent', 4: 'Very Recent'}
        )

        # Show distribution
        priority_counts = df_with_priority['_temporal_priority'].value_counts().sort_index()

        print(f"\n Priority scores added!")
        print("\nPriority distribution:")
        for priority, count in priority_counts.items():
            level = {1: 'Old', 2: 'Medium', 3: 'Recent', 4: 'Very Recent'}.get(priority, 'Unknown')
            percentage = (count / len(df_with_priority)) * 100
            print(f"  {level}: {count} rows ({percentage:.1f}%)")

        return df_with_priority

    def create_weighted_dataset(self, df):
        """Create a version with sampling weights based on priority"""
        if '_temporal_priority' not in df.columns:
            print("❌ Priority scores not found. Run add_priority_scores first.")
            return df

        weighted_df = df.copy()

        # Create sampling weights (higher priority = higher weight)
        weight_map = {1: 0.3, 2: 0.6, 3: 1.0, 4: 1.5}
        weighted_df['_sampling_weight'] = weighted_df['_temporal_priority'].map(weight_map)

        print(f"\n Added sampling weights:")
        print("  Priority 1 (Old): weight 0.3")
        print("  Priority 2 (Medium): weight 0.6")
        print("  Priority 3 (Recent): weight 1.0")
        print("  Priority 4 (Very Recent): weight 1.5")

        return weighted_df

