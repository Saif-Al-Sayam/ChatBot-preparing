# 2. DATA LOADER WITH URL SUPPORT
# ============================================================

class DataLoader:
    """Data loading utility with URL and local file support"""

    @staticmethod
    def detect_encoding(file_path_or_content):
        """Try to detect encoding from file path or content"""
        try:
            if isinstance(file_path_or_content, str) and os.path.exists(file_path_or_content):
                # It's a file path
                with open(file_path_or_content, 'rb') as f:
                    raw_data = f.read(10000)
            else:
                # It's already content
                raw_data = file_path_or_content[:10000] if len(file_path_or_content) > 10000 else file_path_or_content

            result = chardet.detect(raw_data)
            encoding = result['encoding']
            confidence = result['confidence']

            if confidence < 0.7:
                return 'utf-8'

            return encoding
        except:
            return 'utf-8'

    @staticmethod
    def is_url(path):
        """Check if the path is a URL"""
        return str(path).startswith(('http://', 'https://', 'ftp://', 'www.'))

    @staticmethod
    def download_from_url(url):
        """Download data from URL"""
        try:
            print(f" Downloading from URL: {url}")

            # Send request
            headers = {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
            }
            response = requests.get(url, headers=headers, timeout=30)
            response.raise_for_status()

            print(f"Download successful (Size: {len(response.content)/1024:.1f} KB)")

            # Return both content and filename
            filename = url.split('/')[-1] or 'downloaded_data.csv'
            return response.content, filename

        except Exception as e:
            print(f"❌ Failed to download from URL: {e}")
            return None, None

    @staticmethod
    def load_from_source(source_path):
        """Load dataset from file or URL"""
        try:
            print(f"  Loading data from: {source_path[:50]}..." if len(str(source_path)) > 50 else f"📥 Loading data from: {source_path}")

            content = None
            filename = None

            # Check if it's a URL
            if DataLoader.is_url(source_path):
                content, filename = DataLoader.download_from_url(source_path)
                if content is None:
                    return None
            else:
                # It's a local file
                if not os.path.exists(source_path):
                    print(f"❌ File not found: {source_path}")
                    return None
                filename = os.path.basename(source_path)
                with open(source_path, 'rb') as f:
                    content = f.read()

            # Determine file type from extension
            if filename.lower().endswith('.csv'):
                file_type = 'csv'
            elif filename.lower().endswith(('.xlsx', '.xls')):
                file_type = 'excel'
            elif filename.lower().endswith('.json'):
                file_type = 'json'
            else:
                file_type = 'csv'  # Default to CSV

            if file_type == 'csv':
                # Try different encodings for CSV
                encodings_to_try = ['utf-8', 'latin-1', 'iso-8859-1', 'cp1252']

                for encoding in encodings_to_try:
                    try:
                        df = pd.read_csv(BytesIO(content),
                                       encoding=encoding,
                                       on_bad_lines='skip',
                                       engine='python')
                        print(f"   Successfully loaded with {encoding} encoding")
                        print(f"   File: {filename}")
                        print(f"   Rows: {len(df):,}, Columns: {len(df.columns)}")

                        # Show column info
                        if len(df.columns) > 0:
                            print(f"   Columns ({len(df.columns)} total):")
                            for i, col in enumerate(df.columns[:5]):  # Show first 5 columns
                                print(f"     {i+1}. {col}")
                            if len(df.columns) > 5:
                                print(f"     ... and {len(df.columns) - 5} more")

                        return df

                    except UnicodeDecodeError:
                        continue
                    except Exception as e:
                        if 'encoding' in str(e).lower():
                            continue
                        else:
                            # Try with error_bad_lines=False
                            try:
                                df = pd.read_csv(BytesIO(content),
                                               encoding=encoding,
                                               on_bad_lines='skip',
                                               engine='python',
                                               error_bad_lines=False)
                                print(f"   Loaded with {encoding} (skipped bad lines)")
                                return df
                            except:
                                continue

                # If all encodings fail, try simple approach
                print("   Trying simple loading approach...")
                try:
                    # Save to temp file and load
                    temp_file = 'temp_download.csv'
                    with open(temp_file, 'wb') as f:
                        f.write(content)

                    df = pd.read_csv(temp_file, encoding='latin-1', engine='python', on_bad_lines='skip')
                    os.remove(temp_file)

                    print(" Loaded with temp file approach")
                    return df
                except Exception as e:
                    print(f"❌ Failed to load CSV: {e}")
                    return None

            elif file_type == 'excel':
                # Save to temp file and load
                temp_file = 'temp_download.xlsx'
                with open(temp_file, 'wb') as f:
                    f.write(content)

                df = pd.read_excel(temp_file)
                os.remove(temp_file)

                print(f" Loaded Excel file")
                return df

            elif file_type == 'json':
                # Try to load JSON
                try:
                    df = pd.read_json(BytesIO(content))
                    print(f" Loaded JSON file")
                    return df
                except:
                    # Try reading as string
                    try:
                        json_str = content.decode('utf-8', errors='ignore')
                        df = pd.read_json(StringIO(json_str))
                        print(f" Loaded JSON with string conversion")
                        return df
                    except Exception as e:
                        print(f"❌ Failed to load JSON: {e}")
                        return None

            return None

        except Exception as e:
            print(f"❌ Error loading data: {e}")
            return None

    @staticmethod
    def list_data_sources():
        """List available data sources"""
        print("\n Available data sources:")
        print("-" * 40)

        # List local files
        raw_dir = 'data/raw'
        if os.path.exists(raw_dir):
            files = [f for f in os.listdir(raw_dir) if f.endswith(('.csv', '.xlsx', '.json'))]
            if files:
                print(f"\n Local files in 'data/raw/' ({len(files)} found):")
                for i, file in enumerate(files, 1):
                    file_path = os.path.join(raw_dir, file)
                    size = os.path.getsize(file_path) / 1024
                    print(f"  {i}. {file} ({size:.1f} KB)")
            else:
                print("\n No local files found in 'data/raw/'")
                print("   Upload files to 'data/raw/' or use URLs")
        else:
            print("\n 'data/raw/' directory doesn't exist yet")
            os.makedirs(raw_dir, exist_ok=True)
            print("   Created 'data/raw/' directory")

        # Show example URLs
        print("\n  Example URLs you can use:")
        print("  1. Direct CSV URL: https://raw.githubusercontent.com/datasets/covid-19/main/data/time-series-19-covid-combined.csv")
        print("  2. Kaggle dataset: (requires API key)")
        print("  3. Google Sheets: (export as CSV first)")
        print("  4. Any public CSV/Excel/JSON URL")

        return files if 'files' in locals() else []

    @staticmethod
    def get_data_source():
        """Get data source from user (file or URL)"""
        print("\n How would you like to load data?")
        print("  1. From local file (in data/raw/)")
        print("  2. From URL/Link")
        print("  3. Enter data manually (small datasets)")

        choice = input("\nYour choice (1-3): ").strip()

        if choice == '1':
            # From local file
            files = DataLoader.list_data_sources()
            if not files:
                print("\n❌ No files found. Please upload files to 'data/raw/' first.")
                return None, None

            print("\nSelect file (number) or enter custom path:")
            for i, file in enumerate(files, 1):
                print(f"  {i}. {file}")
            print(f"  {len(files)+1}. Enter custom file path")

            file_choice = input("\nYour choice: ").strip()

            try:
                if file_choice.isdigit():
                    idx = int(file_choice)
                    if 1 <= idx <= len(files):
                        file_path = os.path.join('data/raw', files[idx-1])
                    elif idx == len(files) + 1:
                        file_path = input("Enter full file path: ").strip()
                    else:
                        print("❌ Invalid choice")
                        return None, None
                else:
                    file_path = file_choice

                # Get name for dataset
                default_name = os.path.basename(file_path).split('.')[0]
                name = input(f"\nEnter name for this dataset (default: {default_name}): ").strip()
                if not name:
                    name = default_name

                return file_path, name

            except Exception as e:
                print(f"❌ Error: {e}")
                return None, None

        elif choice == '2':
            # From URL
            print("\n Enter the URL of your dataset:")
            print("   Examples:")
            print("   - CSV: https://example.com/data.csv")
            print("   - Excel: https://example.com/data.xlsx")
            print("   - JSON: https://example.com/data.json")
            print("   - GitHub: https://raw.githubusercontent.com/user/repo/file.csv")

            url = input("\nURL: ").strip()

            if not url:
                print("❌ URL cannot be empty")
                return None, None

            # Get name for dataset
            default_name = url.split('/')[-1].split('.')[0] if '.' in url.split('/')[-1] else 'url_data'
            name = input(f"\nEnter name for this dataset (default: {default_name}): ").strip()
            if not name:
                name = default_name

            return url, name

        elif choice == '3':
            # Manual entry
            print("\n  Manual Data Entry")
            print("Enter your data as comma-separated values (CSV format)")
            print("First line should be column names")
            print("Example: Name,Age,City")
            print("         John,25,New York")
            print("         Jane,30,London")
            print("\nEnter 'done' on a new line when finished")

            lines = []
            print("\nEnter your data:")
            line_num = 1
            while True:
                line = input(f"Line {line_num}: ").strip()
                if line.lower() == 'done':
                    break
                lines.append(line)
                line_num += 1

            if not lines:
                print("❌ No data entered")
                return None, None

            # Create CSV string
            csv_content = '\n'.join(lines)

            # Save to temporary file
            temp_file = 'temp_manual_data.csv'
            with open(temp_file, 'w', encoding='utf-8') as f:
                f.write(csv_content)

            print(f" Data saved to {temp_file}")

            name = input("\nEnter name for this dataset: ").strip() or 'manual_data'

            return temp_file, name

        else:
            print("❌ Invalid choice")
            return None, None

    @staticmethod
    def load_multiple_sources():
        """Load multiple datasets from files or URLs"""
        datasets = []

        print("\n LOAD MULTIPLE DATASETS")
        print("=" * 50)

        while True:
            print(f"\n Currently loaded: {len(datasets)} datasets")

            print("\nOptions:")
            print("  1. Add another dataset")
            print("  2. Finish loading")
            print("  3. Show loaded datasets")
            print("  4. Remove a dataset")

            choice = input("\nYour choice (1-4): ").strip()

            if choice == '1':
                # Add new dataset
                source_path, name = DataLoader.get_data_source()

                if source_path and name:
                    df = DataLoader.load_from_source(source_path)

                    if df is not None:
                        datasets.append({
                            'name': name,
                            'data': df,
                            'source': source_path,
                            'rows': len(df),
                            'columns': len(df.columns)
                        })

                        print(f"\n Added dataset: {name}")
                        print(f"   Rows: {len(df):,}, Columns: {len(df.columns)}")

                        # Ask for preview
                        preview = input("\nShow preview? (y/n): ").strip().lower()
                        if preview == 'y':
                            print(f"\nFirst 3 rows of '{name}':")
                            print(df.head(3).to_string())

                    else:
                        print("❌ Failed to load dataset")

            elif choice == '2':
                # Finish loading
                if datasets:
                    print(f"\n Finished loading {len(datasets)} datasets")
                else:
                    print("\n❌  No datasets loaded")
                break

            elif choice == '3':
                # Show loaded datasets
                if datasets:
                    print(f"\n Currently Loaded Datasets ({len(datasets)}):")
                    for i, ds in enumerate(datasets, 1):
                        print(f"\n  {i}. {ds['name']}")
                        print(f"     Source: {ds['source'][:50]}..." if len(ds['source']) > 50 else f"     Source: {ds['source']}")
                        print(f"     Rows: {ds['rows']:,}, Columns: {ds['columns']}")
                        print(f"     Columns: {list(ds['data'].columns)[:5]}{'...' if len(ds['data'].columns) > 5 else ''}")
                else:
                    print("\n No datasets loaded yet")

            elif choice == '4':
                # Remove dataset
                if datasets:
                    print("\nSelect dataset to remove:")
                    for i, ds in enumerate(datasets, 1):
                        print(f"  {i}. {ds['name']} ({ds['rows']:,} rows)")

                    try:
                        idx = int(input("\nEnter number to remove: ").strip())
                        if 1 <= idx <= len(datasets):
                            removed = datasets.pop(idx-1)
                            print(f" Removed dataset: {removed['name']}")
                        else:
                            print("❌ Invalid number")
                    except:
                        print("❌ Invalid input")
                else:
                    print("❌ No datasets to remove")

            else:
                print("❌ Invalid choice")

        return datasets

