class DatasetCurationPipeline:
    """Main pipeline that ties everything together"""

    def __init__(self):
        self.loader = DataLoader()
        self.merger = DatasetMerger()
        self.cleaner = DataCleaner()
        self.scorer = TemporalScorer()
        self.current_data = None
        self.history = []

    def run(self):
        """Run the main pipeline"""
        print("\n" + "="*60)
        print("DATASET CURATION PIPELINE")
        print("="*60)
        print("A tool to clean, merge, and prepare datasets for AI training")
        print("\n")

        # Setup directories
        setup_directories()

        while True:
            self.show_main_menu()

    def show_main_menu(self):
        """Show the main menu"""
        menu_options = {
            '1': 'Load datasets',
            '2': 'Show loaded datasets',
            '3': 'Merge datasets',
            '4': 'Clean current dataset',
            '5': 'Add temporal priority',
            '6': 'Save processed dataset',
            '7': 'Run complete pipeline',
            '8': 'Show pipeline status',
            '9': 'Export reports',
            '10': 'Exit'
        }

        choice = show_menu("MAIN MENU", menu_options)

        if choice == '1':
            self.load_datasets()
        elif choice == '2':
            self.show_loaded_datasets()
        elif choice == '3':
            self.merge_datasets()
        elif choice == '4':
            self.clean_data()
        elif choice == '5':
            self.add_temporal_priority()
        elif choice == '6':
            self.save_data()
        elif choice == '7':
            self.run_complete_pipeline()
        elif choice == '8':
            self.show_status()
        elif choice == '9':
            self.export_reports()
        elif choice == '10':
            print("\n Closing down!")
            import sys
            sys.exit(0)  # This will properly exit
        else:
            print("❌ Invalid choice. Please try again.")

    def load_datasets(self):
        """Load datasets from files or URLs"""
        print("\n LOAD DATASETS")
        print("-" * 40)

        # Use the new URL-capable loader
        datasets = self.loader.load_multiple_sources()

        # Add to merger
        for ds in datasets:
            self.merger.add_dataset(ds['name'], ds['data'])

        print(f"\n Loaded {len(datasets)} datasets")

        # If only one dataset, set it as current
        if len(datasets) == 1:
            self.current_data = datasets[0]['data']
            print(f" Current dataset set to: {datasets[0]['name']}")

        input("\nPress Enter to continue...")

    def show_loaded_datasets(self):
        """Show loaded datasets"""
        self.merger.show_dataset_info()
        input("\nPress Enter to continue...")

    def merge_datasets(self):
        """Merge loaded datasets"""
        if len(self.merger.datasets) < 2:
            print("\n❌ Need at least 2 datasets to merge.")
            print("Please load more datasets first.")
            input("Press Enter to continue...")
            return

        self.merger.show_dataset_info()

        # Show common columns
        self.merger.find_matching_columns()

        # Ask for merge type
        print("\nSelect merge strategy:")
        print("  1. Smart merge (recommended)")
        print("  2. Vertical (concatenate all rows)")
        print("  3. Horizontal (merge on common column)")
        print("  4. Custom (choose options)")

        choice = input("\nYour choice (1-4): ").strip()

        merge_types = {'1': 'smart', '2': 'vertical', '3': 'horizontal', '4': 'custom'}
        merge_type = merge_types.get(choice, 'smart')

        # Perform merge
        merged_data = self.merger.merge_datasets(merge_type)

        if merged_data is not None:
            self.current_data = merged_data
            print(f"\n Current dataset updated ({len(merged_data)} rows)")

            # Show preview
            preview = input("\nShow preview of merged data? (y/n): ").strip().lower()
            if preview == 'y':
                print(f"\nFirst 5 rows:")
                print(merged_data.head().to_string())

        input("\nPress Enter to continue...")

    def clean_data(self):
        """Clean current dataset"""
        if self.current_data is None:
            print("\n❌ No dataset loaded. Please load or merge data first.")
            input("Press Enter to continue...")
            return

        print(f"\n CLEANING DATASET")
        print(f"Dataset: {len(self.current_data)} rows, {len(self.current_data.columns)} columns")
        print("-" * 40)

        # Analyze
        self.cleaner.analyze_dataset(self.current_data)

        # Ask if user wants to clean
        if self.cleaner.problems_found:
            choice = input("\nProceed with cleaning? (y/n): ").strip().lower()
            if choice == 'y':
                auto_fix = input("Apply fixes automatically? (y/n): ").strip().lower() == 'y'
                cleaned_data = self.cleaner.clean_dataset(self.current_data, auto_fix)

                if cleaned_data is not None:
                    self.current_data = cleaned_data
                    print(f"\n Dataset cleaned! New shape: {self.current_data.shape}")

                    # Show what was fixed
                    if self.cleaner.fixes_applied:
                        print("\nApplied fixes:")
                        for fix in self.cleaner.fixes_applied:
                            print(f"  ✓ {fix}")
        else:
            print("\n Dataset is already clean!")

        input("\nPress Enter to continue...")

    def add_temporal_priority(self):
        """Add temporal priority scores"""
        if self.current_data is None:
            print("\n❌ No dataset loaded.")
            input("Press Enter to continue...")
            return

        print(f"\n TEMPORAL PRIORITY SCORING")
        print("-" * 40)

        # Analyze temporal data
        temporal_scores = self.scorer.analyze_temporal_data(self.current_data)

        # Ask if user wants to add priority scores
        choice = input("\nAdd priority scores to dataset? (y/n): ").strip().lower()
        if choice == 'y':
            self.current_data = self.scorer.add_priority_scores(self.current_data, temporal_scores)

            # Ask about weighted dataset
            weight_choice = input("\nCreate weighted version for sampling? (y/n): ").strip().lower()
            if weight_choice == 'y':
                self.current_data = self.scorer.create_weighted_dataset(self.current_data)
                print(" Weighted dataset created!")

        input("\nPress Enter to continue...")

    def save_data(self):
        """Save processed dataset"""
        if self.current_data is None:
            print("\n❌ No dataset to save.")
            input("Press Enter to continue...")
            return

        print(f"\n SAVE DATASET")
        print(f"Dataset shape: {self.current_data.shape}")
        print("-" * 40)

        # Get filename
        default_name = f"processed_dataset_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        filename = input(f"\nEnter filename (default: {default_name}): ").strip()
        if not filename:
            filename = default_name

        # Choose format
        print("\nSelect format:")
        print("  1. CSV (recommended)")
        print("  2. Excel")
        print("  3. JSON")
        print("  4. Multiple formats")

        format_choice = input("\nYour choice (1-4): ").strip()

        try:
            if format_choice == '1':
                # Save as CSV
                filepath = f"data/processed/{filename}.csv"
                self.current_data.to_csv(filepath, index=False)
                print(f" Saved to {filepath}")

            elif format_choice == '2':
                # Save as Excel
                filepath = f"data/processed/{filename}.xlsx"
                self.current_data.to_excel(filepath, index=False)
                print(f" Saved to {filepath}")

            elif format_choice == '3':
                # Save as JSON
                filepath = f"data/processed/{filename}.json"
                self.current_data.to_json(filepath, orient='records', indent=2)
                print(f" Saved to {filepath}")

            elif format_choice == '4':
                # Save in multiple formats
                self.current_data.to_csv(f"data/processed/{filename}.csv", index=False)
                self.current_data.to_excel(f"data/processed/{filename}.xlsx", index=False)
                self.current_data.to_json(f"data/processed/{filename}.json", orient='records', indent=2)
                print(f" Saved in multiple formats:")
                print(f"  - data/processed/{filename}.csv")
                print(f"  - data/processed/{filename}.xlsx")
                print(f"  - data/processed/{filename}.json")

            else:
                print("❌ Invalid choice. Saving as CSV.")
                filepath = f"data/processed/{filename}.csv"
                self.current_data.to_csv(filepath, index=False)
                print(f" Saved to {filepath}")

            # Record in history
            self.history.append({
                'action': 'save',
                'timestamp': datetime.now(),
                'filename': filename,
                'shape': self.current_data.shape
            })

        except Exception as e:
            print(f"❌ Error saving file: {e}")

        input("\nPress Enter to continue...")

    def run_complete_pipeline(self):
        """Run the complete pipeline from start to finish"""
        print("\n" + "="*60)
        print("COMPLETE PIPELINE EXECUTION")
        print("="*60)
        print("This will run all steps automatically:")
        print("  1. Load datasets")
        print("  2. Merge datasets")
        print("  3. Clean data")
        print("  4. Add temporal priority")
        print("  5. Save results")
        print("\n")

        confirm = input("Proceed with complete pipeline? (y/n): ").strip().lower()
        if confirm != 'y':
            print("Pipeline cancelled.")
            return

        steps = [
            (" Load datasets", self._pipeline_load_data),
            (" Merge datasets", self._pipeline_merge_data),
            (" Clean data", self._pipeline_clean_data),
            (" Add temporal priority", self._pipeline_add_priority),
            (" Save results", self._pipeline_save_results)
        ]

        for step_name, step_func in steps:
            print(f"\n{'='*50}")
            print(f"STEP: {step_name}")
            print(f"{'='*50}")

            try:
                step_func()
                print(f" {step_name} completed successfully")
            except Exception as e:
                print(f"❌ Error in {step_name}: {e}")
                retry = input("Retry this step? (y/n): ").strip().lower()
                if retry == 'y':
                    try:
                        step_func()
                        print(f" {step_name} completed on retry")
                    except:
                        print(f"❌ Failed again. Skipping to next step.")
                else:
                    print(f"  Skipping {step_name}")
                    continue

        print("\n" + "="*60)
        print(" COMPLETE PIPELINE FINISHED!")
        print("="*60)
        print(f"\nFinal dataset: {self.current_data.shape if self.current_data else 'No data'}")
        print(f"Saved to: data/processed/")

        input("\nPress Enter to continue...")

    def _pipeline_load_data(self):
        """Load data for pipeline"""
        files = self.loader.list_data_sources()
        if not files:
            print("  No files found. Creating sample data...")
            self._create_sample_data()
            files = self.loader.list_data_sources()

        # Load all files
        datasets = []
        for i, file in enumerate(files, 1):
            file_path = os.path.join('data/raw', file)
            df = self.loader.load_from_source(file_path)
            if df is not None:
                name = file.split('.')[0]
                datasets.append({
                    'name': name,
                    'data': df,
                    'source': file_path,
                    'rows': len(df),
                    'columns': len(df.columns)
                })

        for ds in datasets:
            self.merger.add_dataset(ds['name'], ds['data'])

        if len(datasets) == 1:
            self.current_data = datasets[0]['data']

    def _pipeline_merge_data(self):
        """Merge data for pipeline"""
        if len(self.merger.datasets) < 2:
            print("Only one dataset loaded. Skipping merge.")
            if self.merger.datasets:
                self.current_data = self.merger.datasets[0]['data']
            return

        # Use smart merge
        self.current_data = self.merger.merge_datasets('smart')
        print(f"Merged to {self.current_data.shape}")

    def _pipeline_clean_data(self):
        """Clean data for pipeline"""
        if self.current_data is None:
            return

        # Analyze and clean
        self.cleaner.analyze_dataset(self.current_data)
        self.current_data = self.cleaner.clean_dataset(self.current_data, auto_fix=True)
        print(f"Cleaned to {self.current_data.shape}")

    def _pipeline_add_priority(self):
        """Add priority for pipeline"""
        if self.current_data is None:
            return

        # Add temporal priority
        temporal_scores = self.scorer.analyze_temporal_data(self.current_data)
        self.current_data = self.scorer.add_priority_scores(self.current_data, temporal_scores)
        self.current_data = self.scorer.create_weighted_dataset(self.current_data)
        print("Temporal priority added")

    def _pipeline_save_results(self):
        """Save results for pipeline"""
        if self.current_data is None:
            return

        # Save with timestamp
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        filename = f"pipeline_output_{timestamp}"

        # Save in multiple formats
        self.current_data.to_csv(f"data/processed/{filename}.csv", index=False)
        self.current_data.to_excel(f"data/processed/{filename}.xlsx", index=False)

        print(f"Results saved to data/processed/{filename}.[csv|xlsx]")

    def _create_sample_data(self):
        """Create sample data if no files exist"""
        print("Creating sample datasets...")

        # Sample dataset 1: User data
        dates1 = pd.date_range('2023-01-01', periods=50, freq='D')
        df1 = pd.DataFrame({
            'user_id': range(100, 150),
            'name': [f'User_{i}' for i in range(50)],
            'signup_date': dates1,
            'last_login': dates1 + pd.Timedelta(days=np.random.randint(0, 30, 50)),
            'age': np.random.randint(18, 70, 50),
            'country': np.random.choice(['USA', 'UK', 'Canada', 'Australia'], 50)
        })

        # Sample dataset 2: Product data
        df2 = pd.DataFrame({
            'product_id': range(200, 250),
            'product_name': [f'Product_{i}' for i in range(50)],
            'price': np.random.uniform(10, 1000, 50),
            'category': np.random.choice(['Electronics', 'Clothing', 'Books', 'Food'], 50),
            'created_date': pd.date_range('2023-03-01', periods=50, freq='D')
        })

        # Save sample files
        df1.to_csv('data/raw/sample_users.csv', index=False)
        df2.to_csv('data/raw/sample_products.csv', index=False)

        print(" Created 2 sample datasets in data/raw/")
        print("   - sample_users.csv (50 users)")
        print("   - sample_products.csv (50 products)")

    def show_status(self):
        """Show pipeline status"""
        print("\n" + "="*60)
        print("PIPELINE STATUS")
        print("="*60)

        # Current dataset info
        if self.current_data is not None:
            print(f"\n CURRENT DATASET:")
            print(f"   Rows: {len(self.current_data):,}")
            print(f"   Columns: {len(self.current_data.columns)}")

            # Check for special columns
            special_cols = [col for col in self.current_data.columns if col.startswith('_')]
            if special_cols:
                print(f"   Special columns: {', '.join(special_cols)}")

            # Memory usage
            mem_usage = self.current_data.memory_usage(deep=True).sum() / 1024 / 1024
            print(f"   Memory: {mem_usage:.2f} MB")
        else:
            print("\n📭 No current dataset")

        # Loaded datasets info
        if self.merger.datasets:
            print(f"\n LOADED DATASETS: {len(self.merger.datasets)}")
            for ds in self.merger.datasets:
                print(f"   - {ds['name']}: {ds['rows']:,} rows")

        # History
        if self.history:
            print(f"\n RECENT ACTIONS ({len(self.history)} total):")
            for i, action in enumerate(self.history[-3:], 1):
                action_type = action.get('action', 'unknown')
                timestamp = action.get('timestamp', 'unknown')
                if isinstance(timestamp, datetime):
                    timestamp = timestamp.strftime('%H:%M:%S')
                print(f"   {i}. {action_type} at {timestamp}")

        print("\n" + "-"*60)
        print("DIRECTORY STRUCTURE:")
        print("  data/raw/       - Upload your CSV files here")
        print("  data/processed/ - Cleaned datasets saved here")
        print("  data/merged/    - Merged datasets (if any)")
        print("  reports/        - Analysis reports")

        input("\nPress Enter to continue...")

    def export_reports(self):
        """Export analysis reports"""
        if self.current_data is None:
            print("\n❌ No dataset to analyze.")
            input("Press Enter to continue...")
            return

        print("\n" + "="*60)
        print("EXPORT REPORTS")
        print("="*60)

        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')

        # 1. Dataset summary report
        print("\n Creating dataset summary report...")
        summary = {
            'export_date': timestamp,
            'dataset_shape': self.current_data.shape,
            'columns': list(self.current_data.columns),
            'data_types': {col: str(self.current_data[col].dtype) for col in self.current_data.columns},
            'missing_values': int(self.current_data.isnull().sum().sum()),
            'duplicate_rows': int(self.current_data.duplicated().sum()),
            'memory_usage_mb': self.current_data.memory_usage(deep=True).sum() / 1024 / 1024
        }

        # Add temporal priority info if available
        if '_temporal_priority' in self.current_data.columns:
            priority_dist = self.current_data['_temporal_priority'].value_counts().to_dict()
            summary['temporal_priority_distribution'] = priority_dist

        # Save summary
        summary_file = f"reports/dataset_summary_{timestamp}.json"
        with open(summary_file, 'w') as f:
            json.dump(summary, f, indent=2, default=str)

        print(f" Summary saved to {summary_file}")

        # 2. Data quality report
        print("\n Creating data quality report...")

        # Analyze current data
        self.cleaner.analyze_dataset(self.current_data)

        quality_report = {
            'export_date': timestamp,
            'problems_found': len(self.cleaner.problems_found),
            'problems': self.cleaner.problems_found,
            'fixes_applied': self.cleaner.fixes_applied
        }

        quality_file = f"reports/data_quality_{timestamp}.json"
        with open(quality_file, 'w') as f:
            json.dump(quality_report, f, indent=2, default=str)

        print(f" Quality report saved to {quality_file}")

        # 3. Export sample data
        print("\n Exporting sample data...")
        sample_data = self.current_data.head(100)  # First 100 rows
        sample_file = f"reports/sample_data_{timestamp}.csv"
        sample_data.to_csv(sample_file, index=False)

        print(f" Sample data saved to {sample_file}")

        print("\n" + "="*60)
        print(" ALL REPORTS EXPORTED!")
        print("="*60)
        print(f"\nReports saved to 'reports/' directory:")
        print(f"  1. {summary_file}")
        print(f"  2. {quality_file}")
        print(f"  3. {sample_file}")

        input("\nPress Enter to continue...")

# ============================================================
# 7. MAIN EXECUTION
# ============================================================

def main():
    """Main function to run the pipeline"""


    # Create pipeline instance
    pipeline = DatasetCurationPipeline()

    # Run the pipeline
    pipeline.run()

# ============================================================
# RUN THE PIPELINE
# ============================================================

if __name__ == "__main__":
    main()
