# ========== OPTIMIZED AI CHATBOT TRAINER ==========
import pandas as pd
import torch
import os
import io
import warnings
warnings.filterwarnings('ignore')

# Global variables
df, question_cols, answer_cols = None, [], []
model_name, model_type, tokenizer, model = None, None, None, None
chatbot, save_path = None, "./my-fine-tuned-chatbot"
fine_tuned_model, fine_tuned_tokenizer = None, None
train_dataset, val_dataset = None, None
tokenized_train, tokenized_val = None, None

SEQ2SEQ_MODELS = ['t5', 'flan-t5', 'bart', 'mbart', 'pegasus', 'blenderbot']

def detect_model_type(name):
    return 'seq2seq' if any(m in name.lower() for m in SEQ2SEQ_MODELS) else 'causal'

def install_libraries():
    !pip install -q torch transformers datasets accelerate pandas scikit-learn sentencepiece
    return True

def upload_csv():
    global df, question_cols, answer_cols
    question_cols, answer_cols = [], []

    path = input("CSV path or 'upload': ").strip()
    if path.lower() == 'upload':
        from google.colab import files
        uploaded = files.upload()
        if not uploaded: return False
        path = list(uploaded.keys())[0]
        df = pd.read_csv(io.BytesIO(uploaded[path]), on_bad_lines='skip', engine='python')
    else:
        if not os.path.exists(path): return False
        df = pd.read_csv(path, on_bad_lines='skip')

    print(f"Loaded: {len(df)} rows, {len(df.columns)} columns")
    for i, c in enumerate(df.columns): print(f"  {i+1}. {c}")

    for col_type, cols in [("QUESTION", question_cols), ("ANSWER", answer_cols)]:
        while True:
            inp = input(f"{col_type} columns (e.g., 1,2,3 or 'done'): ").strip().lower()
            if inp == 'done':
                if not cols: continue
                break
            try:
                for x in inp.replace(',', ' ').split():
                    idx = int(x)
                    if 1 <= idx <= len(df.columns) and idx not in cols:
                        cols.append(idx)
            except: pass
    return bool(question_cols and answer_cols)

def prepare_data():
    global train_dataset, val_dataset, model_type
    from sklearn.model_selection import train_test_split
    from datasets import Dataset

    q_names = [df.columns[i-1] for i in question_cols]
    a_names = [df.columns[i-1] for i in answer_cols]

    convos = []
    for _, row in df.iterrows():
        q = " ".join(str(row[c]).strip() for c in q_names if pd.notna(row[c]) and str(row[c]).strip())
        a = " ".join(str(row[c]).strip() for c in a_names if pd.notna(row[c]) and str(row[c]).strip())
        if q and a:
            if model_type == 'seq2seq':
                convos.append({'text': f"question: {q} answer: {a}", 'question': q, 'answer': a})
            else:
                convos.append({'text': f"Human: {q}\nAssistant: {a}", 'question': q, 'answer': a})

    if not convos: return False
    data = pd.DataFrame(convos)
    train_df, val_df = train_test_split(data, test_size=0.2, random_state=42)
    train_dataset, val_dataset = Dataset.from_pandas(train_df), Dataset.from_pandas(val_df)
    print(f"Train: {len(train_df)}, Val: {len(val_df)} | Format: {model_type}")
    return True

def choose_model():
    global model_name, model_type
    print("\n1. microsoft/DialoGPT-small (Causal)")
    print("2. google/flan-t5-base (Seq2Seq)")
    print("3. gpt2 (Causal)")
    print("4. google/flan-t5-small (Seq2Seq)")

    models = {"1": ("microsoft/DialoGPT-small", "causal"), "2": ("google/flan-t5-base", "seq2seq"),
              "3": ("gpt2", "causal"), "4": ("google/flan-t5-small", "seq2seq")}
    model_name, model_type = models.get(input("Choice (1-4): ").strip(), models["1"])
    print(f"Selected: {model_name} ({model_type})")
    return True

def setup_model():
    global tokenizer, model, tokenized_train, tokenized_val
    from transformers import AutoTokenizer, AutoModelForCausalLM, AutoModelForSeq2SeqLM

    tokenizer = AutoTokenizer.from_pretrained(model_name)
    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token if model_type == 'seq2seq' else tokenizer.convert_ids_to_tokens(tokenizer.vocab_size - 1)

    ModelClass = AutoModelForSeq2SeqLM if model_type == 'seq2seq' else AutoModelForCausalLM
    model = ModelClass.from_pretrained(model_name).to("cuda" if torch.cuda.is_available() else "cpu")

    def tokenize(examples):
        if model_type == 'seq2seq':
            inputs = [t.split(" answer: ")[0] for t in examples["text"]]
            targets = [t.split(" answer: ")[1] if " answer: " in t else "" for t in examples["text"]]
            out = tokenizer(inputs, max_length=256, truncation=True, padding="max_length")
            labels = tokenizer(targets, max_length=256, truncation=True, padding="max_length")
            out["labels"] = [[l if l != tokenizer.pad_token_id else -100 for l in lab] for lab in labels["input_ids"]]
        else:
            out = tokenizer(examples["text"], max_length=256, truncation=True, padding="max_length")
            out["labels"] = [[t if t != tokenizer.pad_token_id else -100 for t in lab] for lab in out["input_ids"]]
        return out

    tokenized_train = train_dataset.map(tokenize, batched=True, remove_columns=["text"])
    tokenized_val = val_dataset.map(tokenize, batched=True, remove_columns=["text"])
    print(f"Model on: {model.device}")
    return True

def train_model():
    global tokenizer
    from transformers import TrainingArguments, Trainer

    args = TrainingArguments(
        output_dir="./my-chatbot", num_train_epochs=3, warmup_steps=50,
        logging_steps=10, eval_strategy="steps", eval_steps=50,
        save_strategy="steps", save_steps=100, load_best_model_at_end=True,
        report_to="none", save_total_limit=2, remove_unused_columns=False,
        fp16=False, gradient_accumulation_steps=2,
        per_device_train_batch_size=4 if torch.cuda.is_available() else 2,
        per_device_eval_batch_size=4 if torch.cuda.is_available() else 2,
    )

    trainer = Trainer(model=model, args=args, train_dataset=tokenized_train, eval_dataset=tokenized_val)
    if input("Start training? (yes/no): ").strip().lower() != 'yes': return False

    trainer.train()
    trainer.save_model(save_path)
    tokenizer.save_pretrained(save_path)
    print(f"Saved to {save_path}")
    return True

def load_model():
    global fine_tuned_model, fine_tuned_tokenizer
    from transformers import AutoTokenizer, AutoModelForCausalLM, AutoModelForSeq2SeqLM

    fine_tuned_tokenizer = AutoTokenizer.from_pretrained(save_path)
    if fine_tuned_tokenizer.pad_token is None:
        fine_tuned_tokenizer.pad_token = fine_tuned_tokenizer.eos_token

    ModelClass = AutoModelForSeq2SeqLM if model_type == 'seq2seq' else AutoModelForCausalLM
    fine_tuned_model = ModelClass.from_pretrained(save_path)
    if torch.cuda.is_available(): fine_tuned_model = fine_tuned_model.to("cuda")
    print(f"Loaded on: {fine_tuned_model.device}")
    return True

def create_chatbot():
    global chatbot

    class Chatbot:
        def __init__(self, m, t, mt):
            self.model, self.tokenizer, self.mtype = m, t, mt
            self.model.eval()
            self.history = []

        def respond(self, text, max_len=200):
            try:
                if torch.cuda.is_available(): torch.cuda.empty_cache()
                if self.mtype == 'seq2seq':
                    ctx = " ".join(f"Q:{q} A:{a}" for q,a in self.history[-2:]) if self.history else ""
                    inp = f"{ctx} Q:{text}" if ctx else f"question: {text}"
                    inputs = self.tokenizer(inp, return_tensors="pt", truncation=True, max_length=256).to(self.model.device)
                    out = self.model.generate(**inputs, max_new_tokens=max_len, temperature=0.7, do_sample=True,
                                              pad_token_id=self.tokenizer.pad_token_id, top_p=0.9, no_repeat_ngram_size=3)
                    resp = self.tokenizer.decode(out[0], skip_special_tokens=True).replace(inp, "").strip()
                else:
                    ctx = "\n".join(f"Human:{q}\nAssistant:{a}" for q,a in self.history[-2:]) if self.history else ""
                    prompt = f"{ctx}\nHuman:{text}\nAssistant:" if ctx else f"Human:{text}\nAssistant:"
                    ids = self.tokenizer(prompt, return_tensors="pt", truncation=True, max_length=256).input_ids.to(self.model.device)
                    ids = torch.clamp(ids, 0, self.model.config.vocab_size - 1)
                    out = self.model.generate(ids, attention_mask=torch.ones_like(ids), max_new_tokens=max_len,
                                              temperature=0.8, do_sample=True, pad_token_id=self.tokenizer.pad_token_id,
                                              top_p=0.9, no_repeat_ngram_size=3)
                    resp = self.tokenizer.decode(out[0][ids.shape[1]:], skip_special_tokens=True)
                    if "Human:" in resp: resp = resp.split("Human:")[0].strip()

                resp = resp or "I'm not sure."
                self.history.append((text, resp))
                if len(self.history) > 6: self.history = self.history[-6:]
                return resp
            except Exception as e:
                return f"Error: {e}"

        def chat(self):
            print(f"\n{'='*50}\nCHATBOT READY ({self.mtype.upper()})\n{'='*50}\n'quit' to exit, 'clear' to reset\n")
            while True:
                try:
                    inp = input("You: ").strip()
                    if inp.lower() in ['quit','exit']: print("Goodbye!"); break
                    if inp.lower() == 'clear': self.history = []; print("Cleared!"); continue
                    if inp: print(f"Bot: {self.respond(inp)}")
                except KeyboardInterrupt: print("\nGoodbye!"); break

    fine_tuned_model.eval()
    chatbot = Chatbot(fine_tuned_model, fine_tuned_tokenizer, model_type)
    return True

def save_to_drive():
    import shutil, datetime
    from google.colab import drive
    drive.mount('/content/drive')
    dst = f"/content/drive/MyDrive/chatbot-{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}"
    shutil.copytree(save_path, dst, dirs_exist_ok=True)
    print(f"Saved: {dst}")

def reset_all():
    global df, question_cols, answer_cols, model_name, model_type, tokenizer, model
    global chatbot, fine_tuned_model, fine_tuned_tokenizer, train_dataset, val_dataset
    global tokenized_train, tokenized_val
    for var in [df, model_name, model_type, tokenizer, model, chatbot, fine_tuned_model,
                fine_tuned_tokenizer, train_dataset, val_dataset, tokenized_train, tokenized_val]:
        var = None
    question_cols, answer_cols = [], []
    print("Reset!")

def main():
    print("="*50 + "\nAI CHATBOT TRAINER\n" + "="*50)

    while True:
        print("\n1. Full pipeline (install → train → chat)")
        print("2. Quick train (if CSV/model selected)")
        print("3. Load & chat")
        print("4. Save to Drive")
        print("5. Reset")
        print("6. Exit")

        c = input("\nChoice: ").strip()

        if c == "1":
            for name, fn in [("Install", install_libraries), ("CSV", upload_csv), ("Model", choose_model),
                             ("Prepare", prepare_data), ("Setup", setup_model), ("Train", train_model),
                             ("Load", load_model), ("Chat", create_chatbot)]:
                print(f"\n--- {name} ---")
                if not fn(): print(f"{name} failed!"); break
            else:
                chatbot.chat()

        elif c == "2":
            for name, fn in [("Prepare", prepare_data), ("Setup", setup_model), ("Train", train_model),
                             ("Load", load_model), ("Chat", create_chatbot)]:
                print(f"\n--- {name} ---")
                if not fn(): break
            else:
                chatbot.chat()

        elif c == "3":
            if load_model() and create_chatbot():
                chatbot.chat()

        elif c == "4":
            save_to_drive()

        elif c == "5":
            reset_all()

        elif c == "6":
            break

if __name__ == "__main__":
    main()
